(* SimpleModule — distribute a module as a saved value, a placeholder
 * module mechanism until program-relative imports exist.
 *
 * A producer program builds its export record and calls
 * `publish (authority, name, record)`; consumer programs call
 * `load name` and use the restored record in place of an import.
 * Function values round-trip through the persistence layer as compiled
 * code and are re-linked against the consumer's standard library, so
 * calling restored functions performs like imported ones (verified with
 * the Savina suite; see the study report).
 *
 * Conventions and caveats, inherited from save/restore:
 * - The blob lives at ./out/saved.<name>.persist.json relative to the
 *   process working directory; producer and consumer must run from the
 *   same directory (the repository root, when using local.sh), and
 *   ./out must exist.
 * - `publish` requires ROOT authority. Restored values are trusted like
 *   compiled library code: whoever can write the blob file supplies
 *   code the consumer will run.
 * - There is no version stamp: re-run the producer after changing its
 *   source or after rebuilding the compiler (a stale blob silently
 *   carries old code).
 *)

let (** Save `record` as module `name` (ROOT authority required). *)
    fun publish (auth, name, record) = save (auth, name, record)

    (** Load the module published as `name`. A missing or unreadable
     *  blob raises an in-thread error naming the file; run the module's
     *  producer program first. *)
    fun load name = restore name

in [ ("publish", publish)
   , ("load", load)
   ]
end
