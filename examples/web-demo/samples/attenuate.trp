(* Attenuation of authority.

   The variable `authority` holds the top-level declassification
   authority. Authority can be attenuated using the `attenuate`
   primitive: an authority of level ℓ_auth permits a declassification
   from level ℓ_from to level ℓ_to if ℓ_from ⊑ ℓ_to ∪ ℓ_auth. With
   alice's authority, a value at `alice&bob` can be declassified to
   `{bob}`, and the top-level authority then declassifies it to `{}`.
   Bob's secret cannot be declassified with alice's authority: the last
   line results in the error "Not enough authority for declassification",
   and the report lists the three levels involved. The function
   `pdeclassify` from the library `IfcUtil` declassifies a value and the
   blocking label of the process together. *)
import IfcUtil
let val _ = setStdioLevel (authority, `{}`)
    val aliceAuth = attenuate (authority, `<alice;#root-integrity>`)
    val a = 42 raisedTo `<alice;#root-integrity>`
    val b = 7 raisedTo `<bob;#root-integrity>`
in print aliceAuth;
   print (pdeclassify (a, aliceAuth, `{}`));
   print (pdeclassify (pdeclassify (a + b, aliceAuth, `<bob;#root-integrity>`),
                       authority, `{}`));
   print (pdeclassify (b, aliceAuth, `{}`))
end
