(* FileOps — what a command line means: `:w`, `:q`, `:q!`, `:wq`, a line number, and `:help`.
 *
 * A plugin. It imports `Api` and nothing else, holds no authority, no pid and no descriptor, and
 * cannot write a file: the ROOT authority a write needs never leaves the supervisor's frame
 * (Session.trp). What it does instead is leave a request in the state — the shape the architecture
 * document calls edits-as-data, applied to the one effect the editor performs.
 *
 * TWO HOOKS. `run (api, st, cmd)` is the command line, returning `(state', quit)` exactly as a key
 * does; the keymap calls it on Enter, and for `q` and CTRL-c with the word "q", which is what makes
 * those refuse a modified buffer exactly as `:q` does. `onWritten (api, st, ok, message)` is the
 * answer coming back: the kernel asked the supervisor to write, and this is what the state becomes
 * when it has.
 *
 * A COMMAND IS A WORD AND AN ARGUMENT, split at the first space. `w`, `wq` and `x` take a path;
 * every other command takes nothing, and a word given an argument it has no use for is not that
 * command — `:q now` is reported as unknown rather than quitting. There are no ranges and no
 * options.
 *
 * QUITTING A MODIFIED BUFFER IS REFUSED, by `q`, by CTRL-c and by `:q` alike: the status line says
 * so and the session stays up. `:q!` is the override, `:wq` the other way out. The key set names
 * both `:q` and `:q!`, which is only a distinction if `:q` can refuse.
 *
 * A WRITE THAT QUITS IS ONE REQUEST, not two: `REQ_WRITE`'s payload carries whether to quit, and
 * `onWritten` reads it back with `api.writeQuits`. A refused write spends the request, leaves the
 * buffer modified, and puts the reason in the status line — the session survives a full disk or a
 * read-only file, and `:wq` on one does not quit, the quit being conditional on the write.
 *
 * `:w PATH` WRITES A COPY AND DOES NOT ADOPT THE PATH, which is what vi's does: the buffer goes on
 * belonging to the file it was opened with, a later `:w` writes there, and the status line goes on
 * naming it. That also decides what the modified flag does — `api.markSaved` is called only for a
 * write to `st.path`, so a buffer written elsewhere is still one whose own file is out of date, and
 * `:q` still refuses it. The command that adopts a new path is vi's `:saveas`, and it is not here;
 * the branch below is the one place it would go.
 *
 * `:wq PATH` STILL QUITS. The quit is conditional on the write succeeding and not on which file it
 * went to, so a session can be ended by writing a copy — which is what vi does with it, and the one
 * way out that leaves a modified buffer behind without `:q!`.
 *
 * WHAT A SUCCESSFUL WRITE CHANGES is `api.markSaved`: the file now holds the buffer's revision.
 * Nothing sets or clears a modified flag, there being none — `api.isDirty` compares the buffer's
 * revision with the file's, which is what makes `:q` refuse after an undo that walks back past a
 * write (Api.trp's header carries the reasoning).
 *
 * A LINE NUMBER IS A COMMAND. `:42` goes to line 42 and `:$` to the last line, both landing at
 * column zero (VimMotions.trp's header says why that rather than the first non-blank). A number
 * past the end of the buffer goes to the last line rather than failing, and `:0` to the first: the
 * state's own clamp is what decides both.
 *)

import String
import "./Api"

let (** The refusal a modified buffer earns. The wording is vi's, which is what a user who reaches
     *  for `:q!` will be looking for. *)
    val modifiedMessage = "no write since last change (add ! to override)"

    (** The command line split at its first space: the word, and what follows it with the spaces
     *  around it taken off. *)
    fun splitCmd c =
        let val i = strIndexOf (c, " ", 0)
        in if i < 0 then (c, "")
           else (String.substring (c, 0, i),
                 String.trim (String.substring (c, i + 1, String.size c)))
        end

    (** `s` read as a line number, or -1 when it is not one. Every character has to be a digit, so
     *  `12x` is not a line number and is reported as an unknown command rather than as line 12. *)
    fun lineNumber s =
        let val n = String.size s
            fun go (i, acc) =
                if i >= n then acc
                else let val u = String.subCode (s, i)
                     in if u >= 48 andalso u <= 57 then go (i + 1, acc * 10 + (u - 48)) else -1
                     end
        in if n = 0 then -1 else go (0, 0)
        end

    (** Where a write goes: the path the command named, or the buffer's own when it named none. *)
    fun target (st, arg) = if arg = "" then st.path else arg

    (** Quitting: refused while the buffer is modified. *)
    fun quit (api, st) =
        if api.isDirty st then (api.setStatus (st, modifiedMessage), false) else (st, true)

    fun unknown (api, st, c) = (api.setStatus (st, "not an editor command: " ^ c), false)

    (** The command line, run against a state the keymap has already returned to normal mode.
     *  Returns `(state', quit)` like a key does; a command that writes quits through `onWritten`
     *  instead, once the write has succeeded. *)
    fun run (api, st, c) =
        let val (word, arg) = splitCmd c
            val bare = arg = ""
        in      if word = "w"
                    then (api.requestWrite (st, target (st, arg), false), false)
           else if word = "wq" orelse word = "x"
                    then (api.requestWrite (st, target (st, arg), true), false)
           else if word = "q"  andalso bare then quit (api, st)
           else if word = "q!" andalso bare then (st, true)
           else if (word = "help" orelse word = "h") andalso bare
                    then (api.setMode (st, HELP), false)
           else if word = "$" andalso bare
                    then (api.moveTo (st, api.lastLine st, 0), false)
           else if bare andalso lineNumber word >= 0
                    then (api.moveTo (st, lineNumber word - 1, 0), false)
           else unknown (api, st, c)
        end

    (** The state after the kernel has written the buffer out. `ok` says whether the write
     *  succeeded and `message` is the runtime's reason when it did not. A successful write to the
     *  buffer's own path clears the modified flag and, for `:wq`, ends the session; a write to
     *  another path leaves the buffer modified; a failed one leaves the session up. Either way the
     *  request is spent, and the status line names the file that was written — which is where
     *  `:w PATH` reports that the bytes went somewhere else. *)
    fun onWritten (api, st, ok, message) =
        let val quitAfter = api.writeQuits st
            val path      = api.writePath st
            val note      = if ok then path ^ " written" else message
            val st'       = api.setStatus (api.clearRequest st, note)
            val st''      = if ok andalso path = st.path then api.markSaved st' else st'
        in (st'', ok andalso quitAfter)
        end

    (** What `:help` says about these commands: a section for the help page (Help.trp), written in
     *  the module that decides what a command word means. *)
    val help =
        [ ("COMMANDS",
           [ (":w",      "write the buffer")
           , (":w PATH", "write to another file")
           , (":wq :x",  "write and quit")
           , (":q",      "quit")
           , (":q!",     "quit, discarding changes")
           , (":N :$",   "go to a line, the last")
           , (":help",   "this page") ])
        ]

in [ ("run", run)
   , ("onWritten", onWritten)
   , ("help", help)
   ]
end
