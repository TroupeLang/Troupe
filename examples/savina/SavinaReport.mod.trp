(* SavinaReport — markdown and SVG rendering over collected benchmark
 * rows (a row is (name, size, ms, ok)), shared by the runall drivers of
 * every suite and by analysis/mkreport.trp. `markdown` takes the suite
 * title so each suite renders under its own name.
 *
 * This is the one renderer shared across suites that live in DIFFERENT
 * directories (examples/savina/, examples/benchmarks/{datastructures,
 * clbg,labeled-savina}/). The v1 module system resolves imports only to
 * descendants of the importing program (no `../`), so a single module
 * file cannot be imported by runners in sibling directories. Rather than
 * duplicate the renderer into each suite, it stays a SimpleModule blob (one
 * of two remaining after the descriptor migration — see LabeledSavina for
 * the other). Publish it once, and after any change to this file or a
 * compiler rebuild:
 *
 *   mkdir -p out && ./local.sh examples/savina/SavinaReport.mod.trp
 *   (or `make benchmark-modules` from the repository root).
 *)

import List
import String
import Svg
import SimpleModule

let fun uniq xs =
        let fun go ([], acc) = List.reverse acc
              | go (x :: rest, acc) =
                  if List.length (List.filter (fn y => y = x) acc) > 0
                  then go (rest, acc)
                  else go (rest, x :: acc)
        in go (xs, []) end

    fun median xs =
        let val sorted = List.sort (fn a => fn b => a < b) xs
        in List.nth sorted (floor (List.length sorted / 2)) end

    fun round1 x = floor (x * 10 + 0.5) / 10

    (** Group rows into per-benchmark summaries
     *  (name, allOk, [(size, median ms)]), preserving first-seen order. *)
    fun summarize rows =
        List.map (fn name =>
            let val mine = List.filter (fn (b, _, _, _) => b = name) rows
                val sizes = uniq (List.map (fn (_, n, _, _) => n) mine)
                val allOk = List.length
                              (List.filter (fn (_, _, _, ok) => not ok) mine) = 0
                val meds = List.map (fn n =>
                              (n, median (List.map (fn (_, _, ms, _) => ms)
                                    (List.filter (fn (_, m, _, _) => m = n) mine))))
                            sizes
            in (name, allOk, meds) end)
          (uniq (List.map (fn (b, _, _, _) => b) rows))

    fun mdRow (name, allOk, meds) =
        let val cells = List.map (fn (n, ms) =>
                            toString n ^ ":" ^ toString ms) meds
            val (nLast, msLast) = List.nth meds (List.length meds - 1)
            val perUnit = round1 (msLast * 1000 / nLast)
        in "| " ^ name ^ " | " ^ String.concatWith " · " cells
           ^ " | " ^ toString perUnit
           ^ " | " ^ (if allOk then "yes" else "NO") ^ " |"
        end

    (** Markdown report over summaries, titled with the suite name. *)
    fun markdown (title, summaries) =
        String.concatWith "\n"
          (List.append
             [ "# " ^ title ^ " (generated)"
             , ""
             , "Medians over the repetitions of each run; per-unit cost is"
             , "at the largest size (microseconds per size unit)."
             , ""
             , "| Benchmark | size:median ms | us/unit at max | all ok |"
             , "|-----------|----------------|----------------|--------|" ]
             (List.map mdRow summaries))

    (* --- SVG small multiples (rendered via lib/Svg) --- *)
    val cellW = 220
    val cellH = 150
    val cols = 5
    val padL = 34
    val padT = 26
    val plotW = cellW - padL - 12
    val plotH = cellH - padT - 26

    val sans = "sans-serif"

    fun chart (idx, (name, allOk, meds)) =
        let val ox = (idx mod cols) * cellW
            val oy = floor (idx / cols) * cellH
            val maxMs = List.foldl (fn ((_, ms), m) => if ms > m then ms else m)
                                   1 meds
            val k = List.length meds
            fun px i = ox + padL + (if k <= 1 then plotW / 2
                                    else i * plotW / (k - 1))
            fun py ms = oy + padT + plotH - (ms * plotH / maxMs)
            val curve = List.mapi (fn (i, (_, ms)) => (px i, py ms)) meds
            val dots = List.mapi (fn (i, (_, ms)) =>
                           Svg.circle {cx = px i, cy = py ms, r = 2.5,
                                       fill = "#036"}) meds
            val (n0, _) = List.nth meds 0
            val (nK, _) = List.nth meds (k - 1)
        in Svg.g {}
             (List.append
                [ Svg.text {x = ox + padL, y = oy + 14, fontSize = 11,
                            fontFamily = sans, fontWeight = "bold"}
                    (name ^ (if allOk then "" else " (FAILED)"))
                , Svg.rect {x = ox + padL, y = oy + padT, width = plotW,
                            height = plotH, fill = "none", stroke = "#ccc"}
                , Svg.polyline {fill = "none", stroke = "#036",
                                strokeWidth = 1.5, points = Svg.points curve}
                ]
                (List.append dots
                   [ Svg.text {x = ox + padL - 2, y = oy + padT + 8,
                               fontSize = 8, fontFamily = sans,
                               textAnchor = "end"} (toString maxMs)
                   , Svg.text {x = ox + padL, y = oy + cellH - 10,
                               fontSize = 8, fontFamily = sans} (toString n0)
                   , Svg.text {x = ox + padL + plotW, y = oy + cellH - 10,
                               fontSize = 8, fontFamily = sans,
                               textAnchor = "end"} (toString nK)
                   ]))
        end

    (** SVG chart sheet over summaries. *)
    fun svgSheet summaries =
        let val rows = floor ((List.length summaries + cols - 1) / cols)
            val w = cols * cellW
            val h = rows * cellH + 20
        in Svg.render
             (Svg.svg {width = w, height = h,
                       viewBox = "0 0 " ^ toString w ^ " " ^ toString h}
                (List.append
                   [ Svg.rect {width = "100%", height = "100%", fill = "white"} ]
                   (List.append (List.mapi chart summaries)
                      [ Svg.text {x = 4, y = h - 6, fontSize = 9,
                                  fontFamily = sans, fill = "#666"}
                          "median ms vs size (y scaled per chart); generated in Troupe"
                      ])))
        end

    (** Rows rendered back in the Bench line format (for a results file). *)
    fun resultLines rows =
        String.concatWith "\n"
          (List.map (fn (b, n, ms, ok) =>
               b ^ " n=" ^ toString n ^ " rep=- ms=" ^ toString ms
               ^ " ok=" ^ toString ok)
             rows)

in (SimpleModule.publish (authority, "SavinaReport",
        { summarize = summarize
        , markdown = markdown
        , svg = svgSheet
        , resultLines = resultLines
        });
    print "published SavinaReport module")
end
