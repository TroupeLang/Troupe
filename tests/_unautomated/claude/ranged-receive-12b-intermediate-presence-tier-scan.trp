(* Ranged-receive v2 witness 12b: intermediate presence vs the tier-scan loop shape.

   Library-shape decision input, half 2 (half 1 is 12a, the ceiling-consume shape, which
   blocks). Setup: two messages at presence `<alice;#root-integrity>` — strictly between
   public and `<alice & bob;#root-integrity>` — placed by a spawned sender whose sends
   sit under a raisedTo branch.

   Part (i) — PRIMARY: the tier scan works within ONE wide region. peek's taint is over
   its own interval arguments only (the region folds do not taint the peek: peek has no
   admission premise, the one mechanism that reads Delta — machine-checked,
   ranged_receive_peek_ignores_region_state.lean). So under the wide [public, alice&bob]
   region the narrow peek(0, `<alice;...>`, `<alice;...>`) returns at the TIER label
   alice, the branch takes pc only to alice, and consume(0, `<alice;...>`, `<alice;...>`)
   passes its occurrence premise (alice ⊑ alice), selects the message, and removes it.
   Note the CONSUMED value still carries the region ceiling (consume's taint keeps its
   Delta term by design — the consume reads Delta via its admission), so v1 prints at
   alice&bob.

   Part (ii) — ALTERNATIVE (not a necessity): a per-tier region [public, alice]
   additionally narrows the consumed value's taint to the tier (Delta = alice), at the
   cost of one enable/disable per tier. The library shape may choose it when the
   consumed values' labels matter, not to make the scan possible.

   Expected verdict: okW = true; part (i) peek prints 42 at `<alice;#root-integrity>`,
   consumed v1 prints at `<alice&bob;#root-integrity>`, wide region closes; okT = true;
   part (ii) peek prints 43 at `<alice;#root-integrity>`, consumed v2 prints at
   `<alice;#root-integrity>`, tier region closes; program completes.
*)

let val main = self ()
    val _ = spawn (fn () => if (true raisedTo `<alice;#root-integrity>`)
                            then (send (main, 42); send (main, 43))
                            else ())

    (* Part (i): the tier scan inside the ONE wide region *)
    val (okW, capW) = enableRangedReceive (`<;#root-integrity>`, `<alice & bob;#root-integrity>`, authority)
    val _ = printWithLabels okW
    val p1 = peek (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
    val (m1, meta1) = p1
    val _ = printWithLabels m1
    val v1 = if m1 = 42
             then consume (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
             else consume (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
    val _ = printWithLabels v1
    val _ = disableRangedReceive capW

    (* Part (ii): the per-tier region — narrows the consumed value's taint to the tier *)
    val (okT, capT) = enableRangedReceive (`<;#root-integrity>`, `<alice;#root-integrity>`, authority)
    val _ = printWithLabels okT
    val p2 = peek (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
    val (m2, meta2) = p2
    val _ = printWithLabels m2
    val v2 = if m2 = 43
             then consume (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
             else consume (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
    val _ = printWithLabels v2
    val _ = disableRangedReceive capT
in ()
end

(* Actual (./local.sh): okW = true@{}%{};
   part (i)  m1 = 42@<alice;#root-integrity>%<alice;#root-integrity> — the narrow peek
             returns at the TIER inside the wide region;
             v1 = (42-payload)@<alice&bob;#root-integrity>%<alice&bob;#root-integrity> —
             removed at the tier, consumed value carries the region ceiling (Delta);
   okT = true@{}%{};
   part (ii) m2 = 43@<alice;#root-integrity>%<alice;#root-integrity>;
             v2 = (43-payload)@<alice;#root-integrity>%<alice;#root-integrity> — the
             per-tier region narrows the consumed value's taint to the tier;
   both disables succeed; program completes. Matches expected. *)
