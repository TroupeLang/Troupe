(* Call-label channel, legacy raisembox: an unbalanced mailbox-clearance raise
   inside a SECRET-labelled call.

   The call `f ()` raises the pc by the function value's label {alice}; the
   callee raises the mailbox clearance and never lowers it. Without the
   call-raise branch flag this unbalanced raise survives to low pc under
   secret control (oracle 2026-07-13) — the call-label channel of the
   branch-balance discipline. With the flag, the balance check at the
   function's return refuses the program.

   Expected verdict: REFUSE — "Mailbox clearance label is not restorted after
   being raised in a branch" at the return of f. *)

let val f = (fn () => raisembox (`{alice}`)) raisedTo `{alice}`
    val _ = f ()
in printWithLabels "unreachable"
end

(* Actual (./local.sh): thread error
   "Mailbox clearance label is not restorted after being raised in a branch;
   stack depth = 13" at the raisembox position. Matches expected (REFUSE). *)
