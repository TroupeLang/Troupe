(* The library `Json`.

   The function `Json.parse` converts text to Troupe values: an object
   becomes a record, an array a list, and `null` the unit value. The
   result is an outcome, `OK value` or `ERR {reason, offset}`, i.e., a
   malformed document is reported as a value rather than a runtime
   error. Accessors such as `Json.field` return an option. The functions
   `Json.stringify` and `Json.prettyPrint` convert values to text. *)
import Json
import Outcome
import Option
import List
let val text = "{\"name\": \"troupe\", \"tags\": [\"ifc\", \"actors\"], \"stars\": 42}"
    val record = {language = "troupe", versions = [1, 2], stable = true, notes = ()}
    fun tags j = Option.getOrElse (Option.andThen Json.asArray (Json.field "tags" j)) []
in (case Json.parse text of
      OK v => ( print v
              ; print (Json.field "name" v)
              ; print (List.length (tags v))
              ; printString (Json.prettyPrint 2 v) )
    | ERR e => printString ("parse error: " ^ e.reason));
   (case Json.parse "{\"name\": }" of
      OK v => print v
    | ERR e => printString ("parse error at offset " ^ toString e.offset
                            ^ ": " ^ e.reason));
   printString (Json.stringify record)
end
