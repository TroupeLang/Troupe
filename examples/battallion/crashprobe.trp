(* crashprobe — battallion with a keymap that dies, for the supervisor's crash-restore check.
 *
 *   ./local.sh examples/battallion/crashprobe.trp --io-root <dir> -- <file>
 *
 * Identical to examples/battallion/bt.trp except for the keymap it hands `Session.run`: the key
 * "!" evaluates a dynamic type error, which stops the kernel thread. Everything else — the
 * supervisor, the renderer, the terminal handling — is the same compiled modules, imported from
 * examples/battallion, so what this program exercises is the shipped constellation and not a
 * copy of it.
 *
 * WHY A SEPARATE PROGRAM. The crash has to come from inside the kernel process, and bt.trp must
 * not carry a key that crashes it. `Session.run` already takes the keymap as a parameter — the
 * seam stage 6 extracts plugins through — so a different keymap is all a crash probe needs, and
 * no test-only branch enters the shipped program.
 *
 * WHY IT LIVES HERE AND NOT BESIDE THE HARNESS. It was written in
 * tests/_unautomated/claude/battallion-viewer/, importing these modules as `../../../../…`, and
 * could not be loaded: a module reached through a parent-relative import has its *own*
 * program-relative imports pinned under a key relative to the working directory rather than to
 * the main program, and the runtime then resolves that key against the main program's directory
 * and reads a path that does not exist. The measurement and the exact paths are in
 * tests/_unautomated/claude/battallion-viewer/probe-parent-relative-pins.trp. Sitting beside the
 * modules it imports keeps every pin single-spelled.
 *
 * WHAT THE SUPERVISOR SHOULD DO. It cannot be told that the kernel died: `monitorlocal`
 * notification is broken in the runtime (probe-monitor-defect.trp). It finds out because the
 * kernel stops answering, and its watchdog — `Session.watchdogMs` — fires. It then restores the
 * terminal and exits `Session.exitKernelLost` (3). harness.py case 4 asserts exactly that.
 *)

import Rope
import SimpleFileIO
import Outcome
import "./Session"
import "./Editor"
import "./Key"

let val a = authority
    val err = stderr a

    fun fail (message, code) =
        let val _ = fwrite (err, "crashprobe: " ^ message ^ "\n")
        in exit (a, code)
        end

    (** A dynamic type error: adding a string to a number stops the thread that evaluates it.
     *  Written as a function so the expression is evaluated when the key arrives rather than
     *  when the module is built. *)
    fun boom () = "crash" + 1

    (** The viewer's keymap, plus one key that kills the kernel. *)
    fun onKey (st, KEY_PRINT c) = if c = "!" then (st, boom ()) else Editor.onKey (st, KEY_PRINT c)
      | onKey (st, k)           = Editor.onKey (st, k)

    fun argPath () = case getCliArgs a of []     => fail ("no file given", 2)
                                        | p :: _ => p

    fun openBuffer path =
        case SimpleFileIO.readFile (a, path) of
             OK text => Rope.fromString text
           | ERR e   => fail ("cannot open " ^ e.path ^ ": " ^ e.reason, 1)

    val path = argPath ()
    val buffer = openBuffer path
    val code = Session.run (a, buffer, path, onKey)
in exit (a, code)
end
