(* Reading lines until an empty line.

   The function `loop` reads a line, converts it to a number using
   `stringToInt`, and adds it to the running sum carried in its argument.
   An empty line ends the input. *)
let fun loop sum =
      let val line = inputLine ()
      in if line = "" then sum
         else loop (sum + stringToInt line)
      end
in printString "numbers, one per line; an empty line ends them";
   print (loop 0)
end
