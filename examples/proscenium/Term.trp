(* Term — Proscenium's effectful heart: the renderer process, the Elm-architecture runner,
 * and the supervisor that owns the terminal.
 *
 * A program-relative module of examples/proscenium. The process constellation, the label
 * discipline, and the terminal ceremony are battallion's (examples/battallion/Session.trp,
 * whose header records the reasons); what battallion runs as an editor kernel, this module
 * generalizes to an application record:
 *
 *   app = { init   : {cols, rows, ui} -> (model, cmd list)
 *         , update : (tevent, model)  -> (model, cmd list)
 *         , view   : model            -> image }
 *
 * `Term.run (auth, opts, app)` is the whole session: it acquires the terminal, spawns the
 * kernel and the renderer, forwards events, and restores the terminal before returning an
 * exit code. `opts` is {depth, mouse, paste}: the SGR color depth (Style.trp says why depth
 * is an option and not sniffed), and whether mouse reporting and bracketed paste are switched
 * on for the session; `defaultOpts` is 256 colors with both off.
 *
 * EVENTS reach `update` as `tevent` values: `EV e` for a decoded input event (Key.trp's
 * datatype), `HIT (tag, e)` for a mouse event that landed inside a region the view tagged
 * (`Image.region`; the topmost region wins), `RESIZED {cols, rows}` after the terminal
 * changed size, and `APP m` for the application's own messages — from an `AFTER` command, or
 * sent by any process as `("APPMSG", m)` to the pid `init` received as `ui`.
 *
 * COMMANDS are data returned by `init` and `update`: `QUIT` ends the session, `AFTER (ms, m)`
 * delivers `APP m` to `update` after `ms` milliseconds (the lib/timeout.trp idiom; timers are
 * never cancelled — a stale one is told by the application in its own `m` if it needs to),
 * and `ASK r` sends the request `r` to the supervisor, whose answer returns to `update` as
 * `REPLY`.
 *
 * THE REQUEST PROTOCOL is battallion's WRITE round trip generalized (Session.trp, "WHO
 * WRITES THE FILE"): the root authority never leaves the supervisor, so an application that
 * needs it — a file write, a file read — describes the operation as a request value and runs
 * `runServed (auth, opts, serve, app)`, where `serve : (authority, request) -> reply` runs
 * in the supervisor. `ASK r` is asynchronous: the kernel sends it and keeps folding events;
 * the supervisor serves requests whether it is waiting for the kernel's answer or idle in
 * its event receive, and the reply arrives as one `REPLY` event, drawing without answering
 * like a timer message. The request travels from tainted kernel state and the write or read
 * happens under the supervisor's authority with no confidentiality check between them —
 * exactly battallion's protocol; what a request may name is bounded by what `serve` agrees
 * to do and by `--io-root`. `run` is `runServed` with a serve function that answers every
 * request `("unserved", r)`.
 *
 * THE RENDERER holds the previous frame as one assembled string per row and diffs against
 * it: a frame with the same row count writes only the rows whose strings changed, each as a
 * cursor move plus the row; a frame with a different row count (a resize) is written whole.
 * Structural equality on segment rows measured 37x the cost of string equality
 * (_dev_planning/tui-library/research-findings.md, "Measurements"), which is why rows cross
 * the kernel-renderer boundary already assembled. The write is one `fwrite`, wrapped in the
 * synchronized-output brackets; an unchanged frame writes nothing.
 *
 * THE KERNEL is the Elm loop: decode bytes (carrying the decoder remainder and the escape
 * timer exactly as battallion's kernel does), fold `update` over the events, run the
 * commands, render the view, and answer the supervisor so the next event is forwarded only
 * once this one's frame is on the screen. Timer and application messages draw without
 * answering — no forwarded event is outstanding.
 *
 * LABELS, verbatim from battallion: terminal events carry the channel level; supervisor,
 * kernel, and renderer all receive at [bot, channel level] — the supervisor in a certified
 * region opened with the root authority, the other two in confined regions opened with a
 * null-attenuated authority that they never close, since they receive for their whole lives.
 * Nothing is declassified. Loop results are bound rather than tail-called where a region is
 * open (Session.trp cites the measurement), and the region's open and close sit in
 * straight-line code.
 *
 * THE CURSOR IS HIDDEN FOR THE SESSION: no `app.view` can place a terminal cursor yet. A
 * widget that needs one (an input line) draws its own cell in reverse video; a real
 * cursor-position channel is future work, recorded in the design plan.
 *
 * NOT YET HERE, deliberately: a supervisor-request protocol in battallion's WRITE shape, by
 * which an application asks the supervisor to exercise the root authority (file writes for
 * the calendar demonstrator). It lands with the demonstrator that needs it.
 *)

import List
import String
import Option
import Outcome
import IfcUtil
import Tty
import timeout
import "./Ansi"
import "./Style"
import "./Image"
import "./Key"

datatype ('t, 'm, 'r) tevent = EV      of event
                             | HIT     of 't * event
                             | RESIZED of {cols : int, rows : int}
                             | APP     of 'm
                             | REPLY   of 'r

datatype ('m, 'r) cmd = QUIT
                      | AFTER of int * 'm
                      | ASK   of 'r

let (** How long the supervisor waits for the kernel before calling it wedged; battallion's
     *  constant, for battallion's reasons. *)
    val watchdogMs = 2000

    (** How long a pending escape sequence waits before the kernel reads it as final
     *  (Key.trp's lone-ESC ambiguity; fifty milliseconds is the settled range). *)
    val escapeMs = 50

    val exitOk         = 0
    val exitKernelLost = 3
    val exitKernelHung = 4

    val fallbackCols = 80
    val fallbackRows = 24

    val defaultOpts = {depth = Style.COLORS256, mouse = false, paste = false}

    (*==============================  Frame assembly  ==============================*)

    (** One rendered row as the string the terminal receives: erase the line, then each
     *  segment under its own SGR rendition, a gap as spaces in the default rendition. *)
    fun assembleRow depth segs =
        List.foldl (fn (sg, acc) =>
                        acc ^ (case sg of
                                    Image.SEG (a, s) => Style.encode depth a ^ s
                                  | Image.GAP n      => Style.reset ^ String.repeat n " "))
                   Ansi.eraseLine segs
        ^ Style.reset

    (** A whole frame from the top: home, every row, erase what may lie below. *)
    fun fullFrame rows =
        let fun go ([], acc)      = acc
              | go ([r], acc)     = acc ^ r
              | go (r :: rs, acc) = go (rs, acc ^ r ^ "\r\n")
        in go (rows, Ansi.home) ^ Ansi.eraseBelow
        end

    (** Only the rows whose strings changed, each addressed absolutely. Rows of equal count
     *  diff pairwise; a different count is a resize and redraws whole. *)
    fun diffFrame (prev, rows) =
        if List.length prev <> List.length rows
        then fullFrame rows
        else let fun go ([], [], _, acc) = acc
                   | go (p :: ps, c :: cs, r, acc) =
                         go (ps, cs, r + 1, if p = c then acc else acc ^ Ansi.cursorTo (r, 0) ^ c)
                   | go (_, _, _, acc) = acc
             in go (prev, rows, 0, "")
             end

    (*=============================  The renderer process  =============================*)

    (** Write frames until told to stop, answering each with "RENDERED". `prev` is the
     *  previous frame's assembled rows; an unchanged frame writes nothing. *)
    fun rendererLoop (out, lev, prev) =
        let val m = rcv ( IfcUtil.bot, lev
                        , [ hn ("FRAME", from, rows) => ("FRAME", from, rows)
                          , hn "STOP"                => "STOP" ])
        in case m of
                ("FRAME", from, rows) =>
                    let val payload = diffFrame (prev, rows)
                        val _ = if payload = "" then () else fwrite (out, Ansi.sync payload)
                        val _ = send (from, "RENDERED")
                    in rendererLoop (out, lev, rows)
                    end
              | _ => ()
        end

    (** The renderer's whole life. The loop's result is bound rather than tail-called: the
     *  confined region opened here never closes, and a frame that opened one must not end in
     *  a tail call (Session.trp cites the measurement). *)
    fun renderer (out, lev, weak) =
        let val (ok, cap) = enableRangedReceive (IfcUtil.bot, lev, weak)
            val _ = rendererLoop (out, lev, [])
        in ()
        end

    (*==============================  The kernel process  ==============================*)

    (** Hand the renderer a frame of `model` and wait until it is written; returns the
     *  region rectangles of the rendered view, for mouse hit-testing. *)
    fun draw (rend, lev, depth, app, model, size) =
        let val img = app.view model
            val r   = Image.renderAt (img, size.cols, size.rows)
            val rows = List.map (fn segs => assembleRow depth segs) r.rows
            val _ = send (rend, ("FRAME", self (), rows))
            val _ = rcv (IfcUtil.bot, lev, [ hn "RENDERED" => () ])
        in r.regions
        end

    (** Run a command list; true when one of them was QUIT. *)
    fun runCmds (sup, cs) =
        List.foldl (fn (c, q) =>
                        case c of
                             QUIT          => true
                           | AFTER (ms, m) =>
                                 let val _ = timeout.timeout (self ()) ("APPMSG", m) ms
                                 in q end
                           | ASK r =>
                                 let val _ = send (sup, ("REQ", r))
                                 in q end)
                   false cs

    (** The first region containing `(x, y)`; the region list is most-recently-rendered
     *  first, so the topmost of an overlay wins. *)
    fun hitTest (regions, x, y) =
        List.find (fn (tag, rc) => x >= rc.x andalso x < rc.x + rc.w
                                   andalso y >= rc.y andalso y < rc.y + rc.h)
                  regions

    fun toTevent (regions, ev) =
        case ev of
             MOUSE m => (case hitTest (regions, m.x, m.y) of
                              SOME (tag, _) => HIT (tag, ev)
                            | NONE          => EV ev)
           | _       => EV ev

    (** `update` folded over decoded events, stopping at the first QUIT. *)
    fun foldEvents (sup, app, regions, model, evs) =
        let fun go ([], m, q) = (m, q)
              | go (ev :: rest, m, q) =
                    if q then (m, q)
                    else let val (m', cs) = app.update (toTevent (regions, ev), m)
                         in go (rest, m', runCmds (sup, cs))
                         end
        in go (evs, model, false)
        end

    fun armEscape () =
        let val nonce = mkuuid ()
            val _ = timeout.timeout (self ()) ("ESCWAIT", nonce) escapeMs
        in nonce
        end

    (** One message: decode, fold, run commands, redraw, answer. `carry` and `nonce` are the
     *  decoder remainder and its escape timer, managed exactly as battallion's kernel
     *  manages them (Session.trp, `kernelLoop`): the timer is armed only where the carry was
     *  set, a superseded timer is dropped, and a flushed carry draws without answering. *)
    fun kernelLoop (sup, rend, lev, depth, app, model, size, regions, carry, nonce) =
        let val m = rcv ( IfcUtil.bot, lev
                        , [ hn ("KEY", bytes)        => ("KEY", bytes)
                          , hn ("RESIZE", c, r)      => ("RESIZE", c, r)
                          , hn ("ESCWAIT", n)        => ("ESCWAIT", n)
                          , hn ("APPMSG", am)        => ("APPMSG", am)
                          , hn ("REPLY", rep)        => ("REPLY", rep) ])
            val (model1, size1, keptCarry, nonce1, quit, redraw, answer) =
                    case m of
                         ("KEY", bytes) =>
                             let val (evs, carry') = Key.decode (carry ^ bytes)
                                 val (m', q) = foldEvents (sup, app, regions, model, evs)
                                 val n' = if carry' <> "" then armEscape () else nonce
                             in (m', size, carry', n', q, true, true)
                             end
                       | ("RESIZE", c, r) =>
                             let val size' = {cols = c, rows = r}
                                 val (m', cs) = app.update (RESIZED size', model)
                             in (m', size', carry, nonce, runCmds (sup, cs), true, true)
                             end
                       | ("ESCWAIT", n) =>
                             if n = nonce andalso carry <> ""
                             then let val (m', q) = foldEvents (sup, app, regions, model, Key.flush carry)
                                  in (m', size, "", nonce, q, true, false)
                                  end
                             else (model, size, carry, nonce, false, false, false)
                       | ("APPMSG", am) =>
                             let val (m', cs) = app.update (APP am, model)
                             in (m', size, carry, nonce, runCmds (sup, cs), true, false)
                             end
                       | ("REPLY", rep) =>
                             let val (m', cs) = app.update (REPLY rep, model)
                             in (m', size, carry, nonce, runCmds (sup, cs), true, false)
                             end
                       | _ => (model, size, carry, nonce, false, false, false)
        in if quit
           then send (sup, "QUIT")
           else let val regions1 = if redraw
                                   then draw (rend, lev, depth, app, model1, size1)
                                   else regions
                    val _ = if redraw andalso answer then send (sup, "ACK") else ()
                in kernelLoop (sup, rend, lev, depth, app, model1, size1, regions1, keptCarry, nonce1)
                end
        end

    (** Initialize the application, draw the first frame, tell the supervisor the session is
     *  on the screen, then loop. Result bound, for the reason given at `renderer`. *)
    fun kernel (sup, rend, lev, weak, depth, app, size) =
        let val (ok, cap) = enableRangedReceive (IfcUtil.bot, lev, weak)
            val (m0, cs0) = app.init {cols = size.cols, rows = size.rows, ui = self ()}
            val quit0 = runCmds (sup, cs0)
            val regions = draw (rend, lev, depth, app, m0, size)
            val _ = send (sup, "READY")
            val _ = if quit0
                    then send (sup, "QUIT")
                    else kernelLoop (sup, rend, lev, depth, app, m0, size, regions, "", mkuuid ())
        in ()
        end

    (*============================  The supervisor process  ============================*)

    (** Wait for the kernel's next word, under the watchdog and the monitor. *)
    fun awaitKernel (me, lev, kref) =
        let val nonce = mkuuid ()
            val _ = timeout.timeout me ("WATCHDOG", nonce) watchdogMs
        in rcv ( IfcUtil.bot, lev
               , [ hn "READY"                              => "ready"
                 , hn "ACK"                                => "ack"
                 , hn "QUIT"                               => "quit"
                 , hn "SIGTERM"                            => "sigterm"
                 , hn ("REQ", r)                           => ("req", r)
                 , hn ("DONE", r, p, reason) when r = kref => "dead"
                 , hn ("WATCHDOG", n) when n = nonce       => "hung" ])
        end

    (** Wait for the kernel's next word, carrying out the requests it sends on the way: each
     *  is answered through `srv` under `auth` — the effect happening after the receive has
     *  returned — and the wait resumes. Returns the first word that is not a request. *)
    fun serveKernel (auth, srv, me, kern, lev, kref) =
        let val a = awaitKernel (me, lev, kref)
        in case a of
                ("req", r) =>
                    let val _ = send (kern, ("REPLY", srv (auth, r)))
                    in serveKernel (auth, srv, me, kern, lev, kref)
                    end
              | other => other
        end

    (** The event loop: one terminal event at a time, forwarded and answered before the next
     *  is taken. The extra handlers pick up SIGTERM, an unsolicited "QUIT" (a kernel that
     *  quit on a timer or application message, with no answer outstanding), the kernel's
     *  death, and the spent watchdog timers of events answered in time. *)
    fun eventLoop (auth, srv, me, kern, lev, kref) =
        let val ev = Tty.nextEventWith ( lev
                                       , [ hn "SIGTERM"            => "sigterm"
                                         , hn "QUIT"               => "unquit"
                                         , hn ("REQ", r)           => ("req", r)
                                         , hn ("WATCHDOG", _)      => "stale"
                                         , hn ("DONE", r, p, reason) => "dead" ])
            val (forward, msg) =
                    case ev of TTY_DATA b              => (true, ("KEY", b))
                             | TTY_RESIZE {cols, rows} => (true, ("RESIZE", cols, rows))
                             | TTY_EOF                 => (false, "quit")
                             | other                   => (false, other)
            val answer = if forward
                         then let val _ = send (kern, msg)
                              in serveKernel (auth, srv, me, kern, lev, kref)
                              end
                         else if msg = "sigterm" orelse msg = "unquit" then "quit"
                         else msg
        in case answer of
                ("req", r) =>
                    let val _ = send (kern, ("REPLY", srv (auth, r)))
                    in eventLoop (auth, srv, me, kern, lev, kref)
                    end
              | _ =>
                        if answer = "ack"   then eventLoop (auth, srv, me, kern, lev, kref)
                   else if answer = "stale" then eventLoop (auth, srv, me, kern, lev, kref)
                   else if answer = "dead"  then exitKernelLost
                   else if answer = "hung"  then exitKernelHung
                   else exitOk
        end

    fun terminalSize out =
        case Tty.size out of OK s  => (s.cols, s.rows)
                           | ERR _ => (fallbackCols, fallbackRows)

    fun sessionCode (auth, srv, me, kern, lev, kref, first) =
             if first = "ready" then eventLoop (auth, srv, me, kern, lev, kref)
        else if first = "dead"  then exitKernelLost
        else if first = "hung"  then exitKernelHung
        else exitOk

    (** Run `app` as a full-screen session with `srv` serving its requests, and return an
     *  exit code. `auth` must be the root authority: subscribing, raw mode, the SIGTERM
     *  trap, the certified receive region, and whatever `srv` does with it; the kernel and
     *  the renderer get a null-attenuated one. *)
    fun runServed (auth, opts, srv, app) =
        let val i    = stdin
            val out  = stdout
            val weak = attenuate (auth, IfcUtil.null)
            val me   = self ()
            val lev  = Tty.level i

            val (cols, rows) = terminalSize out

            (*--- Acquire the terminal. ---*)
            val _ = trapSigterm (auth, me)
            val _ = Tty.subscribe (i, me)
            val _ = Tty.rawMode (i, true)
            val _ = fwrite ( out
                           , Ansi.enterAlt ^ Ansi.disableWrap ^ Ansi.hideCursor
                             ^ (if opts.mouse then Ansi.enableMouse else "")
                             ^ (if opts.paste then Ansi.enablePaste else "") )

            (*--- The constellation. ---*)
            val rend = spawn (fn () => renderer (out, lev, weak))
            val kern = spawn (fn () => kernel ( me, rend, lev, weak, opts.depth, app
                                              , {cols = cols, rows = rows} ))
            val kref = monitorlocal kern

            (*--- The region, opened and closed in straight-line code; a confined region
                  (certification refused) is left open and the branch selects a closure, the
                  shape Session.trp pins. ---*)
            val (ok, cap) = Tty.listen (i, auth)
            val unlisten = if ok then (fn () => Tty.unlisten cap) else (fn () => ())
            val first = serveKernel (auth, srv, me, kern, lev, kref)
            val code = sessionCode (auth, srv, me, kern, lev, kref, first)
            val _ = unlisten ()

            (*--- Give the terminal back: cooked mode first, then the escapes, in the order
                  Session.trp argues for. ---*)
            val _ = Tty.rawMode (i, false)
            val _ = fwrite ( out
                           , Ansi.showCursor
                             ^ (if opts.mouse then Ansi.disableMouse else "")
                             ^ (if opts.paste then Ansi.disablePaste else "")
                             ^ Ansi.enableWrap ^ Ansi.leaveAlt )
            val _ = Tty.unsubscribe i
            val _ = untrapSigterm auth
            val _ = send (rend, "STOP")
        in code
        end

    (** `runServed` with a serve function that answers every request `("unserved", r)`. *)
    fun run (auth, opts, app) =
        runServed (auth, opts, fn (a, r) => ("unserved", r), app)

in [ ("run", run)
   , ("runServed", runServed)
   , ("defaultOpts", defaultOpts)
   , ("exitOk", exitOk)
   , ("exitKernelLost", exitKernelLost)
   , ("exitKernelHung", exitKernelHung)
   ]
end
