
(* positive; *)

let val main = self ()
    val _ = spawn ( fn () => let val _ = send (main, 1)
                                 val _ = send (main, 2)
                              in ()
                             end )

    val (_, c) = enableRangedReceive (`<;#root-integrity>`, `<alice & bob;#root-integrity>`, authority)
    val r1 = rcv (`{}`, `<alice;#root-integrity>`, [hn x => x])
    val _ = disableRangedReceive c
    val r2 = rcv (`{}`, `{}`, [hn x => x])
    val _ = debugpc ()
    val _ = printWithLabels r1
    val _ = printWithLabels r2
in ()
end

