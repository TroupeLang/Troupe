(* The interpreter-overhead benchmarks of the literature, ported to the
 * lambda-calculus.trp construction: the naive call-by-value AST interpreter
 * with assoc-list environments and Z-combinator recursion, measured against
 * native Troupe implementations of the same programs.
 *
 * The ported benchmarks and their sources:
 *
 *   fac     factorial -- the benchmark of Amin & Rompf, "Collapsing Towers
 *           of Interpreters" (POPL 2018);
 *   fib     doubly recursive Fibonacci -- the "many simple operations"
 *           worst case of Ertl & Gregg, "The Structure and Performance of
 *           Efficient Interpreters" (JILP 2003);
 *   tak     the Takeuchi function on (18, 12, 6) -- the Gabriel Lisp
 *           benchmark suite's call-stress kernel;
 *   ack     Ackermann (3, 3) -- the partial-evaluation tradition's
 *           call-explosion example (Mix-era test programs);
 *   power   x^n by repeated multiplication -- the running example of Jones,
 *           Gomard & Sestoft, "Partial Evaluation and Automatic Program
 *           Generation" (1993);
 *   micros  per-construct cost probes after Romer et al., "The Structure
 *           and Performance of Interpreters" (ASPLOS 1996): loops differing
 *           by a known number of arithmetic or application nodes, so the
 *           difference prices one interpreted AST node of each kind (their
 *           "native instructions per virtual operation", here microseconds
 *           per interpreted node).
 *
 * The object language extends lambda-calculus.trp's with one construct:
 * mul, needed by fac and power.  Recursion stays in the object language via
 * the call-by-value Z combinator throughout -- this file measures the
 * original naive construction on more workloads, not interpreter variants
 * (definitional-interpreters.trp does that).
 *
 * Not portable without growing the object language: the list/array kernels
 * (sieve, sorts, boyer, the Are-We-Fast-Yet micros) need lists; DES,
 * Richards, DeltaBlue and the JavaScript suites need arrays, strings, and
 * objects.
 *
 *   ./local.sh examples/variants/interpreter-benchmarks.trp --localonly
 *
 * Output: sanity values for every benchmark, a per-benchmark timing table
 * (ms per call, calibrated by growing batches; slowdown vs the native
 * Troupe twin), and the per-node costs derived from the micros.  Timings
 * are wall-clock and vary between runs.
 *)

datatype term = var of string
              | lam of string * term
              | app of term * term
              | lit of int
              | add of term * term
              | sub of term * term
              | mul of term * term
              | leq of term * term
              | ite of term * term * term

datatype value = num of int | clo of string * term * env
     and env   = empty | bind of string * value * env

let (* --- the interpreter (lambda-calculus.trp's, plus mul) ------------- *)
    fun lookup empty x               = ("unbound", x)
      | lookup (bind (y, v, rest)) x = if x = y then v else lookup rest x

    fun numOf (num n) = n
      | numOf _       = 0

    fun eval rho (var x)         = lookup rho x
      | eval rho (lit n)         = num n
      | eval rho (lam (x, body)) = clo (x, body, rho)
      | eval rho (add (a, b))    = num (numOf (eval rho a) + numOf (eval rho b))
      | eval rho (sub (a, b))    = num (numOf (eval rho a) - numOf (eval rho b))
      | eval rho (mul (a, b))    = num (numOf (eval rho a) * numOf (eval rho b))
      | eval rho (leq (a, b))    = if numOf (eval rho a) <= numOf (eval rho b)
                                   then num 1 else num 0
      | eval rho (ite (c, t, f)) = (case eval rho c of
                                      num 0 => eval rho f
                                    | _     => eval rho t)
      | eval rho (app (f, a))    =
          (case eval rho f of
             clo (x, body, cenv) => eval (bind (x, eval rho a, cenv)) body
           | _                   => num 0)

    (* --- term builders -------------------------------------------------- *)
    val zc =
        let val half = lam ("x",
                         app (var "f",
                              lam ("v", app (app (var "x", var "x"), var "v"))))
        in lam ("f", app (half, half))
        end

    fun ap2 f a b   = app (app (f, a), b)
    fun ap3 f a b c = app (app (app (f, a), b), c)

    (* --- the benchmark programs, tied with Z ---------------------------- *)

    (* fac n = if n <= 0 then 1 else n * fac (n - 1) *)
    val facT = app (zc,
        lam ("self", lam ("n",
          ite (leq (var "n", lit 0), lit 1,
               mul (var "n", app (var "self", sub (var "n", lit 1)))))))

    (* fib n = if n <= 1 then n else fib (n - 1) + fib (n - 2) *)
    val fibT = app (zc,
        lam ("self", lam ("n",
          ite (leq (var "n", lit 1), var "n",
               add (app (var "self", sub (var "n", lit 1)),
                    app (var "self", sub (var "n", lit 2)))))))

    (* tak x y z = if x <= y then z
                   else tak (tak (x-1) y z) (tak (y-1) z x) (tak (z-1) x y) *)
    val takT = app (zc,
        lam ("self", lam ("x", lam ("y", lam ("z",
          ite (leq (var "x", var "y"), var "z",
               ap3 (var "self")
                   (ap3 (var "self") (sub (var "x", lit 1)) (var "y") (var "z"))
                   (ap3 (var "self") (sub (var "y", lit 1)) (var "z") (var "x"))
                   (ap3 (var "self") (sub (var "z", lit 1)) (var "x") (var "y"))))))))

    (* ack m n = if m <= 0 then n + 1
                 else if n <= 0 then ack (m-1) 1 else ack (m-1) (ack m (n-1)) *)
    val ackT = app (zc,
        lam ("self", lam ("m", lam ("n",
          ite (leq (var "m", lit 0), add (var "n", lit 1),
               ite (leq (var "n", lit 0),
                    ap2 (var "self") (sub (var "m", lit 1)) (lit 1),
                    ap2 (var "self") (sub (var "m", lit 1))
                        (ap2 (var "self") (var "m") (sub (var "n", lit 1)))))))))

    (* power x n = if n <= 0 then 1 else x * power x (n - 1) *)
    val powerT = app (zc,
        lam ("self", lam ("x", lam ("n",
          ite (leq (var "n", lit 0), lit 1,
               mul (var "x", ap2 (var "self") (var "x") (sub (var "n", lit 1))))))))

    (* micro loops: identical count-down skeletons differing by a known
       number of extra nodes per iteration *)

    (* base: 1 leq + 1 ite + 1 sub + 1 app + 2 var per iteration *)
    val loopNullT = app (zc,
        lam ("self", lam ("n",
          ite (leq (var "n", lit 0), lit 0,
               app (var "self", sub (var "n", lit 1))))))

    (* + 3 add + 1 sub arithmetic nodes per iteration (value unchanged) *)
    val loopAddT = app (zc,
        lam ("self", lam ("n",
          ite (leq (var "n", lit 0), lit 0,
               add (sub (add (lit 1, lit 2), add (lit 1, lit 2)),
                    app (var "self", sub (var "n", lit 1)))))))

    (* + 1 application of an inline identity per iteration *)
    val loopCallT = app (zc,
        lam ("self", lam ("n",
          ite (leq (var "n", lit 0), lit 0,
               app (var "self",
                    sub (app (lam ("w", var "w"), var "n"), lit 1))))))

    (* entry points *)
    fun ifac n     = numOf (eval empty (app (facT, lit n)))
    fun ifib n     = numOf (eval empty (app (fibT, lit n)))
    fun itak x y z = numOf (eval empty (ap3 takT (lit x) (lit y) (lit z)))
    fun iack m n   = numOf (eval empty (ap2 ackT (lit m) (lit n)))
    fun ipower x n = numOf (eval empty (ap2 powerT (lit x) (lit n)))
    fun iloopNull n = numOf (eval empty (app (loopNullT, lit n)))
    fun iloopAdd n  = numOf (eval empty (app (loopAddT, lit n)))
    fun iloopCall n = numOf (eval empty (app (loopCallT, lit n)))

    (* --- native Troupe twins -------------------------------------------- *)
    fun nfac n = if n <= 0 then 1 else n * nfac (n - 1)
    fun nfib n = if n <= 1 then n else nfib (n - 1) + nfib (n - 2)
    fun ntak x y z = if x <= y then z
                     else ntak (ntak (x - 1) y z) (ntak (y - 1) z x)
                               (ntak (z - 1) x y)
    fun nack m n = if m <= 0 then n + 1
                   else if n <= 0 then nack (m - 1) 1
                   else nack (m - 1) (nack m (n - 1))
    fun npower x n = if n <= 0 then 1 else x * npower x (n - 1)

    (* --- timing: ms per call, calibrated by growing batches ------------- *)
    fun timeMs f =
        let val start  = getTime ()
            val result = f ()
            val finish = getTime ()
        in (result, finish - start)
        end

    fun repeat 0 _ = ()
      | repeat k f = (f (); repeat (k - 1) f)

    fun perCallMs f =
        let fun go reps =
                let val (_, el) = timeMs (fn () => repeat reps f)
                in if el >= 300 then el / reps else go (reps * 4)
                end
        in go 1
        end

    fun row name fi fn_ =
        let val i = perCallMs fi
            val n = perCallMs fn_
        in print ("  ", name, ":", i, "ms interpreted,", n,
                  "ms native; slowdown:", i / n)
        end

in print "--- sanity ---"
 ; print ("  fac 10   =", ifac 10,     "expected 3628800")
 ; print ("  fib 10   =", ifib 10,     "expected 55")
 ; print ("  tak 18 12 6 =", itak 18 12 6, "expected 7")
 ; print ("  ack 3 3  =", iack 3 3,    "expected 61")
 ; print ("  power 2 10 =", ipower 2 10, "expected 1024")
 ; print "--- macro benchmarks (ms per call; slowdown vs native Troupe) ---"
 ; row "fac 18      " (fn () => ifac 18)      (fn () => nfac 18)
 ; row "fib 18      " (fn () => ifib 18)      (fn () => nfib 18)
 ; row "tak 18 12 6 " (fn () => itak 18 12 6) (fn () => ntak 18 12 6)
 ; row "ack 3 3     " (fn () => iack 3 3)     (fn () => nack 3 3)
 ; row "power 2 20  " (fn () => ipower 2 20)  (fn () => npower 2 20)
 ; print "--- micros: cost per interpreted AST node ---"
 ; let val iters  = 2000
       val nullMs = perCallMs (fn () => iloopNull iters)
       val addMs  = perCallMs (fn () => iloopAdd iters)
       val callMs = perCallMs (fn () => iloopCall iters)
   in print ("  base iteration (leq+ite+sub+app+2var):",
             1000 * nullMs / iters, "us")
    ; print ("  arithmetic node:", 1000 * (addMs - nullMs) / (4 * iters), "us")
    ; print ("  application    :", 1000 * (callMs - nullMs) / iters, "us")
   end
end
