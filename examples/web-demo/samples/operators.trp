(* User-defined operators.

   An operator is a curried function with a symbolic name. Its fixity is
   declared using `infixl`, `infixr`, or `infix`, followed by a precedence
   level from 0 to 9, e.g., `+` and `-` are at level 6, and `*` and `/`
   at level 7. An operator in parentheses is an ordinary function value,
   so partial application is supported. The operator `|>` below is
   function application with the arguments reversed, i.e., `x |> f` is
   `f x`. Note that fixity declarations are placed after the imports and
   before the program. *)
import List
infixl 6 <+>
infixr 5 ++
infixl 1 |>

let fun ( <+> ) (a, b) (c, d) = (a + c, b + d)   (* vector addition *)
    fun ( ++ ) xs ys = List.append xs ys
    fun ( |> ) x f = f x
    val addOne = ( <+> ) (1, 1)                   (* partial application *)
in print ((1, 2) <+> (3, 4) <+> (10, 20));
   print ([1, 2] ++ [3] ++ [4, 5]);              (* right-associative *)
   print (addOne (41, 41));
   print ([3, 1, 2] |> List.reverse |> List.map (fn x => x * 10));
   print (( + ) 1 2)                             (* a built-in, sectioned *)
end
