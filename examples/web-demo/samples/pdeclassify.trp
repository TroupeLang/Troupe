(* Declassifying the blocking label.

   The previous sample stopped because a branch on a secret had raised
   the blocking label. Lowering it is a declassification too and needs
   authority: `blockdeclto (authority, level)` lowers the blocking label
   to the level, and `pdeclassify` from the IfcUtil library does both
   steps at once, the value and the blocking label. After it, the
   process is public again and can print. `_bl ()` reads the blocking
   label; it is shown after the repair, when it may be printed. A
   `declassify` on its own raises the blocking label as well, since it
   can fail, which is why these samples release with `pdeclassify`. *)
import IfcUtil
let val _ = setStdioLevel (authority, `{}`)
    val secret = 42 raisedTo `<alice;#root-integrity>`
    val bucket = if secret > 40 then "high" else "low"
    val released = pdeclassify (bucket, authority, `{}`)
in printWithLabels released;
   print (_bl ());
   printString "after the branch";
   (if secret mod 2 = 0 then () else ());    (* taints the blocking label again *)
   blockdeclto (authority, `{}`);            (* and lowers it by hand *)
   printString "and again"
end
