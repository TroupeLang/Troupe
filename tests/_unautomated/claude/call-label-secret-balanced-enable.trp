(* Call-label channel positive, ranged-receive pair: a BALANCED
   enable/disable inside a secret-labelled call.

   The call flags the frame, but the callee closes the region before
   returning, restoring the clearance record, so the balance check at the
   return passes. The region floor is {alice}: the close happens at pc
   {alice} (inside the secret call), and the close's own release-landing
   premise pc <= lo would refuse a bottom floor there — that refusal is the
   disable's check, not the branch-balance check under test.

   Expected verdict: ACCEPT — prints "done". *)

let val f = (fn () =>
      let val (ok, cap) = enableRangedReceive (`{alice}`, `{alice}`, authority)
      in disableRangedReceive cap
      end) raisedTo `{alice}`
    val _ = f ()
in printWithLabels "done"
end

(* Actual (./local.sh): "done"@{}%{}; main thread finished with
   ()@{alice}%{alice}. Matches expected (ACCEPT). *)
