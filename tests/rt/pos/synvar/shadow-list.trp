(* A datatype named 'list' may shadow the built-in list constructor
   (spec §2). In the payload 'int * list', 'list' resolves to this datatype
   (self-reference), not the built-in. Native list literals are a value-level
   form, untouched by type-name shadowing, so [1,2,3] still works. *)
datatype list = NIL2 | CONS2 of int * list

let val mine    = CONS2 (1, CONS2 (2, NIL2))
    val builtin = [1, 2, 3]
in
  print mine;    (* (CONS2 (1, (CONS2 (2, (NIL2))))) *)
  print builtin  (* [1, 2, 3] *)
end
