(* The library `Option`.

   A value of the datatype `option` is either `SOME v` or `NONE`. A
   function that may fail returns an option instead of a special value.
   The function `Option.andThen` applies a function returning an option
   to the content of an option, and returns `NONE` as soon as either is
   `NONE`; `Option.getOrElse` supplies a default value. *)
import Option
import List
let fun safeDiv a b = if b = 0 then NONE else SOME (a div b)
    fun safeSqrt n = if n < 0 then NONE else SOME (floor (sqrt n))
    fun describe NONE = "nothing"
      | describe (SOME v) = "the value " ^ toString v
    val phonebook = [("alice", 5551), ("bob", 5552)]
    fun lookup name = Option.map (fn (_, n) => n)
                                 (List.find (fn (k, _) => k = name) phonebook)
    fun pipeline a b = Option.andThen safeSqrt (safeDiv a b)
in printString (describe (safeDiv 100 7));
   printString (describe (safeDiv 100 0));
   print (lookup "alice", lookup "carol");
   print (Option.getOrElse (lookup "carol") 0);
   print (pipeline 100 4);                       (* sqrt 25 *)
   print (pipeline 100 0);                       (* division fails first *)
   print (pipeline (-100) 4);                    (* sqrt fails second *)
   print (List.mapPartial (fn b => safeDiv 12 b) [1, 0, 2, 0, 3])
end
