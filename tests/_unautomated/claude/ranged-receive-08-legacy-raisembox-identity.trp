(* Ranged-receive v2 witness 8: legacy raisembox/consume/lowermbox identity.

   The v2 work must leave the legacy unary raise/lower pair behaving exactly as before.
   This program raises the standing mailbox clearance to alice, consumes a message under
   that clearance (so the result carries the alice taint from boost_level), and lowers the
   clearance back under alice authority. Its output is diffed against the pristine dev build
   (same source base, 09dc1dd) to confirm byte-for-byte identical behaviour.

   Expected verdict: v tainted `<alice;#root-integrity>` (from the standing clearance),
   program completes; identical on the pristine build.
*)

let val me = self ()
    val _ = send (me, 99)
    val c = raisembox (`<alice;#root-integrity>`)
    val v = consume (0, `<;#root-integrity>`, `<alice;#root-integrity>`)
    val _ = printWithLabels v
    val _ = lowermbox (c, attenuate (authority, `<alice;#root-integrity>`))
in ()
end

(* Actual (./local.sh): v = (99-payload)@<alice;#root-integrity>%<alice;#root-integrity>; completes with
   ()@<alice;#root-integrity>. Byte-for-byte identical to the pristine dev build (09dc1dd). Matches expected. *)
