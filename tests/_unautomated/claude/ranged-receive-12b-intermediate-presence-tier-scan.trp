(* Ranged-receive v2 witness 12b: per-tier regions as the route to tier-precision labels.

   Library-shape decision input, half 2. The same-interval loop (12a) is THE idiom under
   the relaxed occurrence premise: it removes intermediate-presence messages
   directly, with everything confined at the standing taint. This witness pins down what
   label precision remains available and where. Setup: two messages at presence
   `<alice;#root-integrity>` — strictly between public and `<alice & bob;#root-integrity>`
   — placed by a spawned sender whose sends sit under a raisedTo branch.

   Part (i) — inside a wide region there is NO tier precision, by design: every in-window
   mailbox observation is confined at the standing taint. peek's result carries the
   active ceiling Delta ⊔ Deltalab — necessary under the relaxed occurrence premise,
   where a secret-driven in-region consume is within the receive clearance and would
   otherwise show in the residual low sub-stream through a peek without the ceiling
   terms (machine-checked:
   ranged_receive_peek_needs_region_fold_under_covered_occurrence.lean). So even the
   narrow peek(0, `<alice;...>`, `<alice;...>`) under the [public, alice&bob] region
   returns at the CEILING alice&bob; the branch goes to the ceiling; the tier consume
   still fires (its occurrence is within the receive clearance) and removes the message,
   the value at the ceiling. The tier scan inside a wide region narrows nothing.

   Part (ii) — per-tier REGIONS are the only route to tier-precision labels: a
   [public, alice] region makes the standing taint itself the tier (Delta = alice), so
   both the peeked and the consumed value print at alice — each region's observations
   pay that region's own Delta, and narrowing the region is the only way to narrow the
   labels, at one enable/disable per tier.

   Expected verdict: okW = true; part (i) peek prints 42 at
   `<alice&bob;#root-integrity>` (ceiling), consumed v1 at `<alice&bob;#root-integrity>`,
   wide region closes; okT = true; part (ii) peek prints 43 at `<alice;#root-integrity>`,
   consumed v2 at `<alice;#root-integrity>`, tier region closes; program completes.
*)

let val main = self ()
    val _ = spawn (fn () => if (true raisedTo `<alice;#root-integrity>`)
                            then (send (main, 42); send (main, 43))
                            else ())

    (* Part (i): the narrow peek/consume inside the ONE wide region — no tier precision *)
    val (okW, capW) = enableRangedReceive (`<;#root-integrity>`, `<alice & bob;#root-integrity>`, authority)
    val _ = printWithLabels okW
    val p1 = peek (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
    val (m1, meta1) = p1
    val _ = printWithLabels m1
    val v1 = if m1 = 42
             then consume (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
             else consume (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
    val _ = printWithLabels v1
    val _ = disableRangedReceive capW

    (* Part (ii): the per-tier region — the standing taint IS the tier *)
    val (okT, capT) = enableRangedReceive (`<;#root-integrity>`, `<alice;#root-integrity>`, authority)
    val _ = printWithLabels okT
    val p2 = peek (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
    val (m2, meta2) = p2
    val _ = printWithLabels m2
    val v2 = if m2 = 43
             then consume (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
             else consume (0, `<alice;#root-integrity>`, `<alice;#root-integrity>`)
    val _ = printWithLabels v2
    val _ = disableRangedReceive capT
in ()
end

(* Actual (./local.sh): okW = true@{}%{};
   part (i)  m1 = 42@<alice&bob;#root-integrity>%<alice&bob;#root-integrity> — the
             narrow peek returns at the CEILING inside the wide region (ceiling-confined);
             v1 = (42-payload)@<alice&bob;#root-integrity>%<alice&bob;#root-integrity> —
             the tier consume fired within the receive clearance, removed, value at the ceiling;
   okT = true@{}%{};
   part (ii) m2 = 43@<alice;#root-integrity>%<alice;#root-integrity>;
             v2 = (43-payload)@<alice;#root-integrity>%<alice;#root-integrity> — the
             per-tier region's standing taint is the tier;
   both disables succeed; program completes. Matches expected. *)
