(* Savina benchmark: Cigarette Smokers (concurrency group).
 *
 * An arbiter repeatedly picks one of three smoker actors at random and
 * gives it the ingredients to smoke; the smoker acknowledges and the
 * arbiter waits for the acknowledgment before the next round (the classic
 * problem's mutual exclusion, actor-style). After n rounds the arbiter
 * dismisses the smokers, which report how often they smoked.
 *
 *   ./local.sh examples/savina/cigsmok.trp                 # default sizes
 *   ./local.sh examples/savina/cigsmok.trp -- 2000 10000   # explicit sizes
 *
 * Result: sum of per-smoker smoke counts; ok iff it equals n.
 *)

import List
import Bench
import Savina

let val d = Savina.cigsmok
    val sizes = Bench.sizesFromArgs (getCliArgs authority) d.sizes
in Bench.run authority d.name sizes 3 d.bench d.check
end
