(* Client.trp — the scripts the generated pages carry.
 *
 * Kept apart from the page-building logic because it is data, not control flow: several hundred
 * lines of JavaScript held in Troupe string literals. Note that a Troupe string literal has no
 * escape for a double quote, so any HTML these scripts build must be built through the DOM API
 * rather than assigned as markup.
 *
 * A program-relative module of examples/md-navigator.
 *)

import Json
import "./Path"

let
    (* Applied in <head>, so a stored theme and sidebar width are in place before first paint
     * rather than flashing the default and then correcting it. *)
    val themeInitJs =
        "(function () { try {\n"
      ^ "  var t = localStorage.getItem('mdnav.theme');\n"
      ^ "  if (t && t !== 'auto') { document.documentElement.setAttribute('data-theme', t); }\n"
      ^ "  var w = localStorage.getItem('mdnav.sidebarw');\n"
      ^ "  if (w) { document.documentElement.style.setProperty('--sidebar-w', w); }\n"
      ^ "  var mw = localStorage.getItem('mdnav.mainw');\n"
      ^ "  if (mw) { document.documentElement.style.setProperty('--main-w', mw); }\n"
      ^ "} catch (e) {} }());\n"

    (* Sidebar behaviour. Four things, in one script on every page:
     *
     *  - the tree keeps its scroll position across navigations, and failing that scrolls the
     *    current document into view. Without this every page load drops you at the top of a
     *    3400px tree with the current document far below the fold.
     *  - collapsed directories are remembered. Ancestors of the current document are emitted
     *    open and are never overridden.
     *  - the filter hides non-matching rows; directories survive if any descendant does, and
     *    every directory is forced open while a query is active so matches inside a collapsed
     *    one are still reachable.
     *  - "/" focuses the filter, Escape clears it.
     *
     * Storage is wrapped: a file:// origin is opaque, and some browsers refuse it outright.
     *)
    val sidebarJs =
        "(function () {\n"
      ^ "  var sb = document.querySelector('.sidebar');\n"
      ^ "  var box = document.getElementById('filter');\n"
      ^ "  var POS = 'mdnav.scroll', DIRS = 'mdnav.dirs';\n"
      ^ "  function get(k, d) { try { var v = sessionStorage.getItem(k);\n"
      ^ "      return v === null ? d : JSON.parse(v); } catch (e) { return d; } }\n"
      ^ "  function set(k, v) { try { sessionStorage.setItem(k, JSON.stringify(v)); }\n"
      ^ "      catch (e) {} }\n"
      ^ "\n"
      ^ "  /* --- remembered collapse state ------------------------------------------- */\n"
      ^ "  var closed = get(DIRS, {});\n"
      ^ "  var dirs = document.querySelectorAll('details.dir');\n"
      ^ "  for (var i = 0; i < dirs.length; i++) {\n"
      ^ "    var d = dirs[i];\n"
      ^ "    /* An ancestor of the current document is emitted open; leave it alone. */\n"
      ^ "    if (!d.open && closed[d.id] === false) { d.open = true; }\n"
      ^ "    else if (d.open && closed[d.id] === true && !d.querySelector('a.current')) {\n"
      ^ "      d.open = false;\n"
      ^ "    }\n"
      ^ "    d.addEventListener('toggle', function (ev) {\n"
      ^ "      var m = get(DIRS, {}); m[ev.target.id] = !ev.target.open; set(DIRS, m);\n"
      ^ "    });\n"
      ^ "  }\n"
      ^ "  /* A directory row that links somewhere should navigate, not toggle. */\n"
      ^ "  var dl = document.querySelectorAll('summary a');\n"
      ^ "  for (var j = 0; j < dl.length; j++) {\n"
      ^ "    dl[j].addEventListener('click', function (ev) { ev.stopPropagation(); });\n"
      ^ "  }\n"
      ^ "\n"
      ^ "  /* --- scroll position ------------------------------------------------------- */\n"
      ^ "  if (sb) {\n"
      ^ "    var saved = get(POS, null);\n"
      ^ "    var cur = sb.querySelector('a.current');\n"
      ^ "    if (saved !== null) { sb.scrollTop = saved; }\n"
      ^ "    /* Centre the current document if it is not on screen after restoring. */\n"
      ^ "    if (cur) {\n"
      ^ "      var top = cur.offsetTop - sb.offsetTop;\n"
      ^ "      if (top < sb.scrollTop || top > sb.scrollTop + sb.clientHeight - 40) {\n"
      ^ "        sb.scrollTop = Math.max(0, top - sb.clientHeight / 2);\n"
      ^ "      }\n"
      ^ "    }\n"
      ^ "    var t = null;\n"
      ^ "    sb.addEventListener('scroll', function () {\n"
      ^ "      if (t) { clearTimeout(t); }\n"
      ^ "      t = setTimeout(function () { set(POS, sb.scrollTop); }, 120);\n"
      ^ "    });\n"
      ^ "  }\n"
      ^ "\n"
      ^ "  /* --- filtering: text and time window, combined ------------------------------ */\n"
      ^ "  var WIN = 'mdnav.window', ARCH = 'mdnav.archive';\n"
      ^ "  var times = window.MDNAV_TIMES || {};\n"
      ^ "  var win = 0, forced = false, showArch = false;\n"
      ^ "  try { win = parseInt(sessionStorage.getItem(WIN) || '0', 10) || 0; } catch (e) {}\n"
      ^ "  try { showArch = localStorage.getItem(ARCH) === '1'; } catch (e) {}\n"
      ^ "  var shown = document.getElementById('shown');\n"
      ^ "\n"
      ^ "  function applyFilter() {\n"
      ^ "    var q = box ? box.value.toLowerCase() : '';\n"
      ^ "    var active = q !== '' || win > 0;\n"
      ^ "    /* While filtering, every directory is opened so a match inside a collapsed one is\n"
      ^ "       still reachable; the previous state is restored when filtering stops. */\n"
      ^ "    if (active && !forced) {\n"
      ^ "      for (var a = 0; a < dirs.length; a++) {\n"
      ^ "        dirs[a].dataset.wasOpen = dirs[a].open ? '1' : '0'; dirs[a].open = true;\n"
      ^ "      }\n"
      ^ "      forced = true;\n"
      ^ "    } else if (!active && forced) {\n"
      ^ "      for (var b = 0; b < dirs.length; b++) {\n"
      ^ "        dirs[b].open = dirs[b].dataset.wasOpen === '1';\n"
      ^ "      }\n"
      ^ "      forced = false;\n"
      ^ "    }\n"
      ^ "    var now = Date.now(), visible = 0, total = 0;\n"
      ^ "    var items = document.querySelectorAll('.tree li');\n"
      ^ "    for (var i = items.length - 1; i >= 0; i--) {\n"
      ^ "      var li = items[i];\n"
      ^ "      var link = li.querySelector(':scope > a');\n"
      ^ "      var isDoc = link && link.id.indexOf('doc:') === 0;\n"
      ^ "      if (isDoc) {\n"
      ^ "        /* A hidden archive is out of scope rather than filtered out, so it does not\n"
      ^ "           count towards the total either. The document being read is always shown,\n"
      ^ "           archived or not, or opening one would hide your own place in the tree. */\n"
      ^ "        if (!showArch && link.classList.contains('archived')\n"
      ^ "            && !link.classList.contains('current')) {\n"
      ^ "          li.style.display = 'none';\n"
      ^ "          continue;\n"
      ^ "        }\n"
      ^ "        total++;\n"
      ^ "        var rel = link.id.slice(4);\n"
      ^ "        var t = times[rel];\n"
      ^ "        var okText = link.textContent.toLowerCase().indexOf(q) !== -1;\n"
      ^ "        var okTime = win === 0 || (t !== undefined && now - t < win);\n"
      ^ "        var ok = okText && okTime;\n"
      ^ "        li.style.display = ok ? '' : 'none';\n"
      ^ "        if (ok) { visible++; }\n"
      ^ "      } else if (!link) {\n"
      ^ "        var kids = li.querySelectorAll('li');\n"
      ^ "        var any = false;\n"
      ^ "        for (var k = 0; k < kids.length; k++) {\n"
      ^ "          if (kids[k].style.display !== 'none') { any = true; break; }\n"
      ^ "        }\n"
      ^ "        li.style.display = any ? '' : 'none';\n"
      ^ "      }\n"
      ^ "    }\n"
      ^ "    if (shown) {\n"
      ^ "      shown.textContent = active ? '  ' + visible + ' of ' + total + ' shown' : '';\n"
      ^ "    }\n"
      ^ "  }\n"
      ^ "\n"
      ^ "  function setWindow(ms, chipId) {\n"
      ^ "    win = ms;\n"
      ^ "    try { sessionStorage.setItem(WIN, String(ms)); } catch (e) {}\n"
      ^ "    var chips = document.querySelectorAll('.timefilter .chip');\n"
      ^ "    for (var i = 0; i < chips.length; i++) {\n"
      ^ "      if (chips[i].id.indexOf('win-') === 0) {\n"
      ^ "        chips[i].className = chips[i].id === chipId ? 'chip on' : 'chip';\n"
      ^ "      }\n"
      ^ "    }\n"
      ^ "    applyFilter();\n"
      ^ "  }\n"
      ^ "  var winChips = document.querySelectorAll('.timefilter .chip');\n"
      ^ "  for (var w = 0; w < winChips.length; w++) {\n"
      ^ "    if (winChips[w].id.indexOf('win-') !== 0) { continue; }\n"
      ^ "    (function (c) {\n"
      ^ "      c.addEventListener('click', function () {\n"
      ^ "        var cust = document.getElementById('wincustom');\n"
      ^ "        if (cust) { cust.value = ''; }\n"
      ^ "        setWindow(parseInt(c.id.slice(4), 10), c.id);\n"
      ^ "      });\n"
      ^ "    }(winChips[w]));\n"
      ^ "  }\n"
      ^ "  var cust = document.getElementById('wincustom');\n"
      ^ "  var unit = document.getElementById('winunit');\n"
      ^ "  function customChanged() {\n"
      ^ "    var n = parseFloat(cust.value);\n"
      ^ "    if (!n || n <= 0) { setWindow(0, 'win-0'); return; }\n"
      ^ "    setWindow(Math.round(n * parseInt(unit.value, 10)), '');\n"
      ^ "  }\n"
      ^ "  if (cust) { cust.addEventListener('input', customChanged); }\n"
      ^ "  if (unit) { unit.addEventListener('change', function () {\n"
      ^ "    if (cust.value) { customChanged(); } }); }\n"
      ^ "  if (box) { box.addEventListener('input', applyFilter); }\n"
      ^ "\n"
      ^ "  /* --- archive ----------------------------------------------------------------- */\n"
      ^ "  var arch = document.getElementById('archivetoggle');\n"
      ^ "  if (arch) {\n"
      ^ "    arch.className = showArch ? 'chip on' : 'chip';\n"
      ^ "    arch.addEventListener('click', function () {\n"
      ^ "      showArch = !showArch;\n"
      ^ "      arch.className = showArch ? 'chip on' : 'chip';\n"
      ^ "      try { localStorage.setItem(ARCH, showArch ? '1' : '0'); } catch (e) {}\n"
      ^ "      applyFilter();\n"
      ^ "    });\n"
      ^ "  }\n"
      ^ "\n"
      ^ "  /* --- expand / collapse all --------------------------------------------------- */\n"
      ^ "  function setAll(open) {\n"
      ^ "    var m = get(DIRS, {});\n"
      ^ "    for (var i = 0; i < dirs.length; i++) {\n"
      ^ "      dirs[i].open = open; m[dirs[i].id] = !open;\n"
      ^ "      dirs[i].dataset.wasOpen = open ? '1' : '0';\n"
      ^ "    }\n"
      ^ "    set(DIRS, m);\n"
      ^ "  }\n"
      ^ "  var ea = document.getElementById('expandall');\n"
      ^ "  var ca = document.getElementById('collapseall');\n"
      ^ "  if (ea) { ea.addEventListener('click', function () { setAll(true); }); }\n"
      ^ "  if (ca) { ca.addEventListener('click', function () { setAll(false); }); }\n"
      ^ "\n"
      ^ "  /* Restore a window chosen on an earlier page. */\n"
      ^ "  if (win > 0) { setWindow(win, 'win-' + win); } else { applyFilter(); }\n"
      ^ "\n"
      ^ "  /* --- theme ------------------------------------------------------------------- */\n"
      ^ "  var th = document.getElementById('theme');\n"
      ^ "  if (th) {\n"
      ^ "    var curTheme = 'auto';\n"
      ^ "    try { curTheme = localStorage.getItem('mdnav.theme') || 'auto'; } catch (e) {}\n"
      ^ "    th.value = curTheme;\n"
      ^ "    th.addEventListener('change', function () {\n"
      ^ "      var v = th.value;\n"
      ^ "      try { localStorage.setItem('mdnav.theme', v); } catch (e) {}\n"
      ^ "      if (v === 'auto') { document.documentElement.removeAttribute('data-theme'); }\n"
      ^ "      else { document.documentElement.setAttribute('data-theme', v); }\n"
      ^ "    });\n"
      ^ "  }\n"
      ^ "\n"
      ^ "  /* --- draggable widths, double-click a grip to reset --------------------------- */\n"
      ^ "  function makeGrip(gripId, prop, key, widthAt) {\n"
      ^ "    var grip = document.getElementById(gripId);\n"
      ^ "    if (!grip) { return; }\n"
      ^ "    var dragging = false;\n"
      ^ "    grip.addEventListener('mousedown', function (ev) {\n"
      ^ "      dragging = true; ev.preventDefault();\n"
      ^ "      document.body.style.userSelect = 'none';\n"
      ^ "    });\n"
      ^ "    document.addEventListener('mousemove', function (ev) {\n"
      ^ "      if (!dragging) { return; }\n"
      ^ "      document.documentElement.style.setProperty(prop, widthAt(ev) + 'rem');\n"
      ^ "    });\n"
      ^ "    document.addEventListener('mouseup', function () {\n"
      ^ "      if (!dragging) { return; }\n"
      ^ "      dragging = false; document.body.style.userSelect = '';\n"
      ^ "      try { localStorage.setItem(key,\n"
      ^ "        document.documentElement.style.getPropertyValue(prop)); } catch (e) {}\n"
      ^ "    });\n"
      ^ "    grip.addEventListener('dblclick', function () {\n"
      ^ "      document.documentElement.style.removeProperty(prop);\n"
      ^ "      try { localStorage.removeItem(key); } catch (e) {}\n"
      ^ "    });\n"
      ^ "  }\n"
      ^ "  /* The sidebar grip measures from the viewport edge. */\n"
      ^ "  makeGrip('sbdrag', '--sidebar-w', 'mdnav.sidebarw', function (ev) {\n"
      ^ "    return Math.min(48, Math.max(12, ev.clientX / 16));\n"
      ^ "  });\n"
      ^ "  /* The main grip measures from main's own left edge, so it is independent of the\n"
      ^ "     sidebar width. */\n"
      ^ "  makeGrip('maindrag', '--main-w', 'mdnav.mainw', function (ev) {\n"
      ^ "    var m = document.querySelector('main');\n"
      ^ "    var left = m ? m.getBoundingClientRect().left : 0;\n"
      ^ "    return Math.min(120, Math.max(20, (ev.clientX - left) / 16));\n"
      ^ "  });\n"
      ^ "\n"
      ^ "  /* --- keyboard ---------------------------------------------------------------- */\n"
      ^ "  document.addEventListener('keydown', function (ev) {\n"
      ^ "    var tag = (ev.target.tagName || '').toLowerCase();\n"
      ^ "    var typing = tag === 'input' || tag === 'textarea';\n"
      ^ "    if (ev.key === '/' && !typing) {\n"
      ^ "      var f = document.getElementById('q') || box;\n"
      ^ "      if (f) { ev.preventDefault(); f.focus(); f.select(); }\n"
      ^ "    } else if (ev.key === 'Escape' && typing) {\n"
      ^ "      ev.target.value = '';\n"
      ^ "      ev.target.dispatchEvent(new Event('input'));\n"
      ^ "      ev.target.blur();\n"
      ^ "    }\n"
      ^ "  });\n"
      ^ "}());\n"

    (* Per-document script: the rendered/source toggle, and capturing a comment against a
     * selected line range in the source view.
     *
     * Comments accumulate under one key in localStorage, shared by every page of the site (a
     * file:// origin is common to all of them). A static page cannot append to a file on disk,
     * so the comments page is what turns them into a comments.md to download or copy.
     *)
    val docJs =
        "(function () {\n"
      ^ "  var KEY = 'mdnav.comments', VIEW = 'mdnav.view', WRAP = 'mdnav.wrap';\n"
      ^ "  var doc = window.MDNAV_DOC || {path: '', rel: '', title: ''};\n"
      ^ "  var rendered = document.getElementById('rendered');\n"
      ^ "  var raw = document.getElementById('raw');\n"
      ^ "  var bRend = document.getElementById('showrendered');\n"
      ^ "  var bRaw = document.getElementById('showraw');\n"
      ^ "  var hint = document.getElementById('commenthint');\n"
      ^ "  var bWrap = document.getElementById('wrap');\n"
      ^ "  if (!rendered || !raw) { return; }\n"
      ^ "  function load() { try { return JSON.parse(localStorage.getItem(KEY)) || []; }\n"
      ^ "      catch (e) { return []; } }\n"
      ^ "  function save(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); }\n"
      ^ "      catch (e) { alert('Cannot store comments: ' + e.name); } }\n"
      ^ "\n"
      ^ "  /* --- view toggle ----------------------------------------------------------- */\n"
      ^ "  function show(which) {\n"
      ^ "    var isRaw = which === 'raw';\n"
      ^ "    rendered.style.display = isRaw ? 'none' : '';\n"
      ^ "    raw.style.display = isRaw ? '' : 'none';\n"
      ^ "    bRaw.className = isRaw ? 'on' : '';\n"
      ^ "    bRend.className = isRaw ? '' : 'on';\n"
      ^ "    if (hint) { hint.style.visibility = isRaw ? 'visible' : 'hidden'; }\n"
      ^ "    /* Wrapping only means anything in the source view. */\n"
      ^ "    if (bWrap) { bWrap.style.display = isRaw ? '' : 'none'; }\n"
      ^ "    try { localStorage.setItem(VIEW, which); } catch (e) {}\n"
      ^ "  }\n"
      ^ "  bRend.addEventListener('click', function () { show('rendered'); });\n"
      ^ "  bRaw.addEventListener('click', function () { show('raw'); });\n"
      ^ "\n"
      ^ "  /* --- wrap on / off --------------------------------------------------------- */\n"
      ^ "  function setWrap(on) {\n"
      ^ "    if (on) { raw.classList.remove('nowrap'); } else { raw.classList.add('nowrap'); }\n"
      ^ "    if (bWrap) { bWrap.className = on ? 'on' : ''; }\n"
      ^ "    try { localStorage.setItem(WRAP, on ? '1' : '0'); } catch (e) {}\n"
      ^ "  }\n"
      ^ "  var wrapOn = true;\n"
      ^ "  try { wrapOn = localStorage.getItem(WRAP) !== '0'; } catch (e) {}\n"
      ^ "  setWrap(wrapOn);\n"
      ^ "  if (bWrap) {\n"
      ^ "    bWrap.addEventListener('click', function () {\n"
      ^ "      setWrap(raw.classList.contains('nowrap'));\n"
      ^ "    });\n"
      ^ "  }\n"
      ^ "  var pref = 'rendered';\n"
      ^ "  try { pref = localStorage.getItem(VIEW) || 'rendered'; } catch (e) {}\n"
      ^ "  show(pref);\n"
      ^ "\n"
      ^ "  /* --- mark lines that already carry a comment ------------------------------- */\n"
      ^ "  function mark() {\n"
      ^ "    var lis = raw.querySelectorAll('li');\n"
      ^ "    for (var i = 0; i < lis.length; i++) { lis[i].classList.remove('commented'); }\n"
      ^ "    load().filter(function (c) { return c.rel === doc.rel; }).forEach(function (c) {\n"
      ^ "      for (var n = c.startLine; n <= c.endLine; n++) {\n"
      ^ "        var li = document.getElementById('L' + n);\n"
      ^ "        if (li) { li.classList.add('commented'); }\n"
      ^ "      }\n"
      ^ "    });\n"
      ^ "    var link = document.getElementById('commentslink');\n"
      ^ "    if (link) { var n = load().length;\n"
      ^ "      link.textContent = n ? 'Comments (' + n + ')' : 'Comments'; }\n"
      ^ "  }\n"
      ^ "  mark();\n"
      ^ "\n"
      ^ "  /* --- selection -> comment -------------------------------------------------- */\n"
      ^ "  function lineOf(node) {\n"
      ^ "    var el = node.nodeType === 1 ? node : node.parentNode;\n"
      ^ "    while (el && el.tagName !== 'LI') { el = el.parentNode; }\n"
      ^ "    return el && el.id.charAt(0) === 'L' ? parseInt(el.id.slice(1), 10) : null;\n"
      ^ "  }\n"
      ^ "  var bar = document.createElement('div');\n"
      ^ "  bar.className = 'commentbar';\n"
      (* Built with the DOM API rather than an innerHTML string: a Troupe string literal has no
       * escape for a double quote, so quoted HTML attributes cannot be written here at all. *)
      ^ "  function el(tag, cls, txt) {\n"
      ^ "    var e = document.createElement(tag);\n"
      ^ "    if (cls) { e.className = cls; }\n"
      ^ "    if (txt) { e.textContent = txt; }\n"
      ^ "    return e;\n"
      ^ "  }\n"
      ^ "  var cbRange = el('div', 'cb-range', '');\n"
      ^ "  var cbText = document.createElement('textarea');\n"
      ^ "  cbText.rows = 3;\n"
      ^ "  cbText.placeholder = 'Comment on these lines';\n"
      ^ "  var cbActions = el('div', 'cb-actions', '');\n"
      ^ "  var cbSave = el('button', 'cb-save', 'Save');\n"
      ^ "  var cbCancel = el('button', 'cb-cancel', 'Cancel');\n"
      ^ "  cbSave.type = 'button'; cbCancel.type = 'button';\n"
      ^ "  cbActions.appendChild(cbSave);\n"
      ^ "  cbActions.appendChild(document.createTextNode(' '));\n"
      ^ "  cbActions.appendChild(cbCancel);\n"
      ^ "  bar.appendChild(cbRange); bar.appendChild(cbText); bar.appendChild(cbActions);\n"
      ^ "  document.body.appendChild(bar);\n"
      ^ "  var rangeLabel = cbRange, ta = cbText;\n"
      ^ "  var pending = null;\n"
      ^ "  function clearSel() {\n"
      ^ "    var m = raw.querySelectorAll('li.selecting');\n"
      ^ "    for (var i = 0; i < m.length; i++) { m[i].classList.remove('selecting'); }\n"
      ^ "  }\n"
      ^ "  function close() { bar.classList.remove('open'); ta.value = ''; pending = null;\n"
      ^ "    clearSel(); }\n"
      ^ "  cbCancel.addEventListener('click', close);\n"
      ^ "  cbSave.addEventListener('click', function () {\n"
      ^ "    if (!pending || !ta.value.trim()) { close(); return; }\n"
      ^ "    var all = load();\n"
      ^ "    all.push({path: doc.path, rel: doc.rel, title: doc.title,\n"
      ^ "              startLine: pending.from, endLine: pending.to, quote: pending.quote,\n"
      ^ "              comment: ta.value.trim(), created: new Date().toISOString()});\n"
      ^ "    save(all); close(); mark();\n"
      ^ "  });\n"
      ^ "\n"
      ^ "  /* --- scroll position within the document ------------------------------------ */\n"
      ^ "  var SKEY = 'mdnav.pos.' + doc.rel;\n"
      ^ "  try {\n"
      ^ "    var y0 = parseInt(sessionStorage.getItem(SKEY) || '0', 10);\n"
      ^ "    /* A #fragment in the URL must win over a remembered position. */\n"
      ^ "    if (y0 > 0 && !location.hash) { window.scrollTo(0, y0); }\n"
      ^ "  } catch (e) {}\n"
      ^ "  var stimer = null;\n"
      ^ "  window.addEventListener('scroll', function () {\n"
      ^ "    if (stimer) { clearTimeout(stimer); }\n"
      ^ "    stimer = setTimeout(function () {\n"
      ^ "      try { sessionStorage.setItem(SKEY, String(window.scrollY)); } catch (e) {}\n"
      ^ "    }, 150);\n"
      ^ "  });\n"
      ^ "\n"
      ^ "  /* --- the table of contents follows the reading position ---------------------- */\n"
      ^ "  var tocLinks = document.querySelectorAll('.toc a');\n"
      ^ "  if (tocLinks.length && window.IntersectionObserver) {\n"
      ^ "    var byId = {}, order = [];\n"
      ^ "    for (var t = 0; t < tocLinks.length; t++) {\n"
      ^ "      var tid = tocLinks[t].getAttribute('href').slice(1);\n"
      ^ "      byId[tid] = tocLinks[t]; order.push(tid);\n"
      ^ "    }\n"
      ^ "    var seen = [];\n"
      ^ "    var obs = new IntersectionObserver(function (entries) {\n"
      ^ "      entries.forEach(function (en) {\n"
      ^ "        var id = en.target.id, at = seen.indexOf(id);\n"
      ^ "        if (en.isIntersecting && at === -1) { seen.push(id); }\n"
      ^ "        else if (!en.isIntersecting && at !== -1) { seen.splice(at, 1); }\n"
      ^ "      });\n"
      ^ "      order.forEach(function (k) { byId[k].classList.remove('active'); });\n"
      ^ "      /* Whichever visible heading comes first in the document. */\n"
      ^ "      var best = null, bestAt = 1e9;\n"
      ^ "      seen.forEach(function (id) {\n"
      ^ "        var o = order.indexOf(id);\n"
      ^ "        if (o !== -1 && o < bestAt) { bestAt = o; best = id; }\n"
      ^ "      });\n"
      ^ "      if (best) { byId[best].classList.add('active'); }\n"
      ^ "    }, {rootMargin: '0px 0px -70% 0px'});\n"
      ^ "    order.forEach(function (k) {\n"
      ^ "      var h = document.getElementById(k);\n"
      ^ "      if (h) { obs.observe(h); }\n"
      ^ "    });\n"
      ^ "  }\n"
      ^ "\n"
      ^ "  /* --- quality of life ------------------------------------------------------- */\n"
      ^ "  /* A clickable anchor beside every heading, for citing a section. */\n"
      ^ "  var hs = rendered.querySelectorAll('h2[id], h3[id], h4[id]');\n"
      ^ "  for (var i = 0; i < hs.length; i++) {\n"
      ^ "    var link = document.createElement('a');\n"
      ^ "    link.className = 'hanchor';\n"
      ^ "    link.href = '#' + hs[i].id;\n"
      ^ "    link.textContent = '#';\n"
      ^ "    link.title = 'Link to this section';\n"
      ^ "    hs[i].appendChild(link);\n"
      ^ "  }\n"
      ^ "  /* Copy button on every code block. */\n"
      ^ "  var pres = rendered.querySelectorAll('pre');\n"
      ^ "  for (var j = 0; j < pres.length; j++) {\n"
      ^ "    (function (pre) {\n"
      ^ "      var wrap = document.createElement('div');\n"
      ^ "      wrap.className = 'prewrap';\n"
      ^ "      pre.parentNode.insertBefore(wrap, pre);\n"
      ^ "      wrap.appendChild(pre);\n"
      ^ "      var btn = document.createElement('button');\n"
      ^ "      btn.type = 'button'; btn.className = 'copybtn'; btn.textContent = 'Copy';\n"
      ^ "      btn.addEventListener('click', function () {\n"
      ^ "        var txt = pre.textContent;\n"
      ^ "        if (navigator.clipboard) {\n"
      ^ "          navigator.clipboard.writeText(txt).then(function () {\n"
      ^ "            btn.textContent = 'Copied';\n"
      ^ "            setTimeout(function () { btn.textContent = 'Copy'; }, 1500);\n"
      ^ "          }, function () { btn.textContent = 'Blocked'; });\n"
      ^ "        }\n"
      ^ "      });\n"
      ^ "      wrap.appendChild(btn);\n"
      ^ "    }(pres[j]));\n"
      ^ "  }\n"
      ^ "  /* [ and ] step to the previous and next document. */\n"
      ^ "  document.addEventListener('keydown', function (ev) {\n"
      ^ "    var tag = (ev.target.tagName || '').toLowerCase();\n"
      ^ "    if (tag === 'input' || tag === 'textarea') { return; }\n"
      ^ "    var sel = ev.key === '[' ? '.prevnext .prev' : (ev.key === ']' ? '.prevnext .next' : null);\n"
      ^ "    if (!sel) { return; }\n"
      ^ "    var a = document.querySelector(sel);\n"
      ^ "    if (a && a.href) { window.location.href = a.href; }\n"
      ^ "  });\n"
      ^ "\n"
      ^ "  raw.addEventListener('mouseup', function () {\n"
      ^ "    var sel = window.getSelection();\n"
      ^ "    if (!sel || sel.isCollapsed) { return; }\n"
      ^ "    var a = lineOf(sel.anchorNode), b = lineOf(sel.focusNode);\n"
      ^ "    if (a === null || b === null) { return; }\n"
      ^ "    var from = Math.min(a, b), to = Math.max(a, b);\n"
      ^ "    var quote = [];\n"
      ^ "    for (var n = from; n <= to; n++) {\n"
      ^ "      var li = document.getElementById('L' + n);\n"
      ^ "      if (li) { quote.push(li.textContent); }\n"
      ^ "    }\n"
      ^ "    pending = {from: from, to: to, quote: quote.join('\\n')};\n"
      ^ "    clearSel();\n"
      ^ "    for (var m = from; m <= to; m++) {\n"
      ^ "      var mli = document.getElementById('L' + m);\n"
      ^ "      if (mli) { mli.classList.add('selecting'); }\n"
      ^ "    }\n"
      ^ "    rangeLabel.textContent = doc.rel + ':' + (from === to ? from : from + '-' + to);\n"
      ^ "    bar.classList.add('open');\n"
      ^ "    ta.focus();\n"
      ^ "  });\n"
      ^ "}());\n"

    (* The comments page's script: render what is stored, and render it as markdown.
     *
     * The quoted source goes in a fence long enough to survive whatever backticks the quote
     * itself contains, so a quoted table or code block cannot break out of it. *)
    fun commentsJs cfg =
        "(function () {\n"
      ^ "  var KEY = 'mdnav.comments';\n"
      ^ "  var list = document.getElementById('clist');\n"
      ^ "  var preview = document.getElementById('preview');\n"
      ^ "  function load() { try { return JSON.parse(localStorage.getItem(KEY)) || []; }\n"
      ^ "      catch (e) { return []; } }\n"
      ^ "  function save(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {} }\n"
      ^ "\n"
      ^ "  function fence(text) {\n"
      ^ "    var longest = 0, run = 0;\n"
      ^ "    for (var i = 0; i < text.length; i++) {\n"
      ^ "      if (text.charAt(i) === '`') { run++; if (run > longest) { longest = run; } }\n"
      ^ "      else { run = 0; }\n"
      ^ "    }\n"
      ^ "    var n = Math.max(3, longest + 1), f = '';\n"
      ^ "    while (f.length < n) { f += '`'; }\n"
      ^ "    return f;\n"
      ^ "  }\n"
      ^ "\n"
      ^ "  function toMarkdown(cs) {\n"
      ^ "    if (!cs.length) { return '# Review comments\\n\\nNone.\\n'; }\n"
      ^ "    var out = '# Review comments\\n\\n'\n"
      ^ "      + 'Written by md-navigator. Each entry names a source document, the line range it\\n'\n"
      ^ "      + 'was made against, and the text as it read at that moment - so an entry can still\\n'\n"
      ^ "      + 'be located if the lines have since moved.\\n\\n';\n"
      ^ "    var sorted = cs.slice().sort(function (a, b) {\n"
      ^ "      return a.path === b.path ? a.startLine - b.startLine\n"
      ^ "                               : (a.path < b.path ? -1 : 1); });\n"
      ^ "    sorted.forEach(function (c) {\n"
      ^ "      var range = c.startLine === c.endLine ? String(c.startLine)\n"
      ^ "                                           : c.startLine + '-' + c.endLine;\n"
      ^ "      var f = fence(c.quote);\n"
      ^ "      out += '## ' + c.path + ':' + range + '\\n\\n'\n"
      ^ "           + '- created: ' + c.created + '\\n\\n'\n"
      ^ "           + f + '\\n' + c.quote + '\\n' + f + '\\n\\n'\n"
      ^ "           + c.comment + '\\n\\n';\n"
      ^ "    });\n"
      ^ "    return out;\n"
      ^ "  }\n"
      ^ "\n"
      ^ "  function render() {\n"
      ^ "    var cs = load();\n"
      ^ "    list.textContent = '';\n"
      ^ "    if (!cs.length) {\n"
      ^ "      var e = document.createElement('p');\n"
      ^ "      e.textContent = 'No comments yet. Open a document, switch to Source, and select lines.';\n"
      ^ "      list.appendChild(e);\n"
      ^ "    }\n"
      ^ "    cs.forEach(function (c, i) {\n"
      ^ "      var d = document.createElement('div');\n"
      ^ "      d.className = 'centry';\n"
      ^ "      var h = document.createElement('div');\n"
      ^ "      h.className = 'chead';\n"
      ^ "      var range = c.startLine === c.endLine ? String(c.startLine)\n"
      ^ "                                           : c.startLine + '-' + c.endLine;\n"
      ^ "      h.textContent = c.path + ':' + range + '  ' + c.created;\n"
      ^ "      var del = document.createElement('button');\n"
      ^ "      del.type = 'button'; del.textContent = 'Delete'; del.className = 'cdel';\n"
      ^ "      del.addEventListener('click', function () {\n"
      ^ "        var all = load(); all.splice(i, 1); save(all); render(); });\n"
      ^ "      h.appendChild(del);\n"
      ^ "      var q = document.createElement('pre'); q.className = 'cquote';\n"
      ^ "      q.textContent = c.quote;\n"
      ^ "      var body = document.createElement('div'); body.className = 'cbody';\n"
      ^ "      body.textContent = c.comment;\n"
      ^ "      d.appendChild(h); d.appendChild(q); d.appendChild(body);\n"
      ^ "      list.appendChild(d);\n"
      ^ "    });\n"
      ^ "    preview.textContent = toMarkdown(cs);\n"
      ^ "    var link = document.getElementById('commentslink');\n"
      ^ "    if (link) { link.textContent = cs.length ? 'Comments (' + cs.length + ')' : 'Comments'; }\n"
      ^ "  }\n"
      ^ "\n"
      ^ "  document.getElementById('download').addEventListener('click', function () {\n"
      ^ "    var blob = new Blob([toMarkdown(load())], {type: 'text/markdown'});\n"
      ^ "    var a = document.createElement('a');\n"
      ^ "    a.href = URL.createObjectURL(blob);\n"
      ^ "    a.download = " ^ Json.stringify (Path.basename cfg.commentsFile) ^ ";\n"
      ^ "    document.body.appendChild(a); a.click(); a.remove();\n"
      ^ "  });\n"
      ^ "  document.getElementById('copy').addEventListener('click', function () {\n"
      ^ "    var text = toMarkdown(load()), note = document.getElementById('copied');\n"
      ^ "    function ok() { note.textContent = 'Copied.'; setTimeout(function () {\n"
      ^ "      note.textContent = ''; }, 2000); }\n"
      ^ "    if (navigator.clipboard) { navigator.clipboard.writeText(text).then(ok, function () {\n"
      ^ "      note.textContent = 'Copy blocked; select the text below instead.'; }); }\n"
      ^ "    else { note.textContent = 'Copy unavailable; select the text below instead.'; }\n"
      ^ "  });\n"
      ^ "  document.getElementById('clear').addEventListener('click', function () {\n"
      ^ "    if (confirm('Delete all stored comments?')) { save([]); render(); }\n"
      ^ "  });\n"
      ^ "  render();\n"
      ^ "}());\n"

    val searchJs =
                "(function () {\n"
      ^ "  var box = document.getElementById('q');\n"
      ^ "  var out = document.getElementById('results');\n"
      ^ "  var first = null;\n"
      ^ "  function run() {\n"
      ^ "    var q = box.value.toLowerCase();\n"
      ^ "    out.textContent = '';\n"
      ^ "    first = null;\n"
      ^ "    if (q.length < 2) return;\n"
      ^ "    var hits = 0;\n"
      ^ "    for (var i = 0; i < window.MDNAV.length; i++) {\n"
      ^ "      var d = window.MDNAV[i];\n"
      ^ "      var at = d.text.toLowerCase().indexOf(q);\n"
      ^ "      if (at === -1 && d.title.toLowerCase().indexOf(q) === -1) continue;\n"
      ^ "      hits++;\n"
      ^ "      var div = document.createElement('div');\n"
      ^ "      div.className = 'hit';\n"
      ^ "      var a = document.createElement('a');\n"
      ^ "      a.href = d.path; a.textContent = d.title;\n"
      ^ "      if (first === null) { first = d.path; }\n"
      ^ "      var p = document.createElement('div');\n"
      ^ "      p.className = 'path'; p.textContent = d.path;\n"
      ^ "      div.appendChild(a); div.appendChild(p);\n"
      ^ "      if (at !== -1) {\n"
      ^ "        var s = Math.max(0, at - 60);\n"
      ^ "        var frag = d.text.substr(s, 160).replace(/\\s+/g, ' ');\n"
      ^ "        var ctx = document.createElement('div');\n"
      ^ "        /* Assembled as nodes so the matched run can be wrapped without markup. */\n"
      ^ "        var low = frag.toLowerCase(), from = 0, hit = low.indexOf(q);\n"
      ^ "        ctx.appendChild(document.createTextNode('…'));\n"
      ^ "        while (hit !== -1) {\n"
      ^ "          ctx.appendChild(document.createTextNode(frag.slice(from, hit)));\n"
      ^ "          var mk = document.createElement('mark');\n"
      ^ "          mk.textContent = frag.substr(hit, q.length);\n"
      ^ "          ctx.appendChild(mk);\n"
      ^ "          from = hit + q.length; hit = low.indexOf(q, from);\n"
      ^ "        }\n"
      ^ "        ctx.appendChild(document.createTextNode(frag.slice(from) + '…'));\n"
      ^ "        div.appendChild(ctx);\n"
      ^ "      }\n"
      ^ "      out.appendChild(div);\n"
      ^ "    }\n"
      ^ "    if (hits === 0) { out.textContent = 'No matches.'; }\n"
      ^ "  }\n"
      ^ "  box.addEventListener('input', run);\n"
      ^ "  box.addEventListener('keydown', function (ev) {\n"
      ^ "    if (ev.key === 'Enter' && first) { window.location.href = first; }\n"
      ^ "  });\n"
      ^ "  box.focus();\n"
      ^ "}());\n"

    (* Sorts a generated table by any column its header marks sortable. Dates are compared as
     * the ISO strings they are printed as, which orders correctly without parsing. *)
    val tableJs =
        "(function () {\n"
      ^ "  var t = document.querySelector('main table');\n"
      ^ "  if (!t) { return; }\n"
      ^ "  var heads = t.querySelectorAll('thead th');\n"
      ^ "  var body = t.querySelector('tbody');\n"
      ^ "  var state = {col: -1, dir: 1};\n"
      ^ "  for (var i = 0; i < heads.length; i++) {\n"
      ^ "    heads[i].className = 'sortable';\n"
      ^ "    (function (h, idx) {\n"
      ^ "      h.addEventListener('click', function () {\n"
      ^ "        state.dir = state.col === idx ? -state.dir : 1;\n"
      ^ "        state.col = idx;\n"
      ^ "        for (var k = 0; k < heads.length; k++) { heads[k].className = 'sortable'; }\n"
      ^ "        h.className = state.dir === 1 ? 'sortable sortasc' : 'sortable sortdesc';\n"
      ^ "        var rows = [].slice.call(body.querySelectorAll('tr'));\n"
      ^ "        rows.sort(function (a, b) {\n"
      ^ "          var x = a.children[idx].textContent.trim().toLowerCase();\n"
      ^ "          var y = b.children[idx].textContent.trim().toLowerCase();\n"
      ^ "          return x === y ? 0 : (x < y ? -state.dir : state.dir);\n"
      ^ "        });\n"
      ^ "        rows.forEach(function (r) { body.appendChild(r); });\n"
      ^ "      });\n"
      ^ "    }(heads[i], i));\n"
      ^ "  }\n"
      ^ "}());\n"

in [ ("themeInitJs", themeInitJs)
   , ("tableJs", tableJs)
   , ("sidebarJs", sidebarJs)
   , ("docJs", docJs)
   , ("commentsJs", commentsJs)
   , ("searchJs", searchJs)
   ]
end
