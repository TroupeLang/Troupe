{
  "test_name": "synvar-exchange",
  "timeout": 45,
  "coordination": "parallel",
  "network": {
    "relay_port": 5560,
    "use_relay": "relay-only"
  },
  "nodes": [
    {
      "id": "nodeb",
      "script": "nodeb.trp",
      "port": 6802,
      "expected_exit_code": 0
    },
    {
      "id": "nodea",
      "script": "nodea.trp",
      "port": 6803,
      "start_delay": 1,
      "expected_exit_code": 0
    }
  ],
  "trust": [
    {"from": "nodea", "to": "nodeb", "level": "bot"},
    {"from": "nodeb", "to": "nodea", "level": "bot"}
  ],
  "output": {
    "merge_strategy": "timestamp",
    "filter_patterns": ["uuid", "timestamp", "peer_id"]
  }
}
