(* Spawning processes, sending and receiving messages.

   New processes are created using the `spawn` function that takes as its
   argument a unit-argument function, and returns the process identifier
   of the new process. The expression `self ()` returns the identifier of
   the current process. Process communication happens via message
   passing: `send (p, v)` places the value `v` in the mailbox of process
   `p`, and `receive` takes a list of handlers of the form `hn pat => e`
   and selects the first message in the mailbox that matches one of the
   patterns. The server below answers requests until it receives the
   message "stop". *)
let fun server () =
      receive [ hn ("ping", from, n) =>
                  (send (from, ("pong", n * 2)); server ())
              , hn "stop" =>
                  printString "server stopping" ]
    val p = spawn server
    fun ask n = ( send (p, ("ping", self (), n))
                ; receive [ hn ("pong", m) => m ] )
in print (ask 1);
   print (ask 21);
   send (p, "stop")
end
