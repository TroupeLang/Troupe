(* Untyped lambda calculus, extended with if-then-else and integer
 * arithmetic, as syntactic-variant datatypes, plus a call-by-value
 * interpreter and a timing study against native Troupe recursion.
 *
 * Demonstrates:
 *   - an AST datatype (term) for the object language;
 *   - a mutually recursive value/env `and` group: value refers to env
 *     through the closure constructor CLO, and env refers to value through
 *     its cons constructor BIND, so the group is genuinely mutually
 *     recursive in both directions (the `and` well-formedness rule).  term is
 *     declared in an earlier group; env is a cons-list environment;
 *   - a constructor-pattern evaluator eval : env -> term -> value with an
 *     environment-lookup helper.  Application evaluates the function to a
 *     closure and evaluates the body in the captured environment extended
 *     with the (already evaluated) argument -- call-by-value;
 *   - the call-by-value Z combinator (the eta-expanded fixed-point
 *     combinator) built as an AST value, used to define a doubly recursive
 *     fib entirely inside the object language.
 *
 * The evaluator's environment argument is named rho, since env is a
 * datatype name and so is not available as an ordinary variable.
 *
 *   ./local.sh examples/variants/lambda-calculus.trp --localonly
 *
 * Output: a sanity check (interpreted fib 10 = 55), then an interpreted-fib
 * timing table that grows n until one computation exceeds 4000 ms, then a
 * native-fib comparison and the interpreted/native slowdown ratio at the
 * largest interpreted n.  Timings are wall-clock and vary between runs.
 *)

datatype term = VAR of string
              | LAM of string * term
              | APP of term * term
              | LIT of int
              | ADD of term * term
              | SUB of term * term
              | LEQ of term * term
              | IF  of term * term * term

datatype value = NUM of int | CLO of string * term * env
     and env   = EMPTY | BIND of string * value * env

let (* --- interpreter --------------------------------------------------- *)

    (* environment lookup (cons-list of name/value bindings) *)
    fun lookup EMPTY x               = ("unbound", x)
      | lookup (BIND (y, v, rest)) x = if x = y then v else lookup rest x

    (* project the integer out of a value *)
    fun numOf (NUM n) = n
      | numOf _       = 0

    (* call-by-value evaluator *)
    fun eval rho (VAR x)         = lookup rho x
      | eval rho (LIT n)         = NUM n
      | eval rho (LAM (x, body)) = CLO (x, body, rho)
      | eval rho (ADD (a, b))    = NUM (numOf (eval rho a) + numOf (eval rho b))
      | eval rho (SUB (a, b))    = NUM (numOf (eval rho a) - numOf (eval rho b))
      | eval rho (LEQ (a, b))    = if numOf (eval rho a) <= numOf (eval rho b)
                                   then NUM 1 else NUM 0
      | eval rho (IF (c, t, f))  = (case eval rho c of
                                      NUM 0 => eval rho f
                                    | _     => eval rho t)
      | eval rho (APP (f, a))    =
          (case eval rho f of
             CLO (x, body, cenv) => eval (BIND (x, eval rho a, cenv)) body
           | _                   => NUM 0)

    (* --- object-language fib via the Z combinator ---------------------- *)

    (* Z = \f.(\x. f (\v. x x v)) (\x. f (\v. x x v))  --- the call-by-value
       (eta-expanded) fixed-point combinator, built as a term. *)
    val zc =
        let val half = LAM ("x",
                         APP (VAR "f",
                              LAM ("v", APP (APP (VAR "x", VAR "x"), VAR "v"))))
        in LAM ("f", APP (half, half))
        end

    (* fibStep self n = if n <= 1 then n else self (n-1) + self (n-2) *)
    val fibStep =
        LAM ("self",
          LAM ("n",
            IF (LEQ (VAR "n", LIT 1),
                VAR "n",
                ADD (APP (VAR "self", SUB (VAR "n", LIT 1)),
                     APP (VAR "self", SUB (VAR "n", LIT 2))))))

    (* the recursive fib as a term, then a Troupe-level wrapper *)
    val fibTerm = APP (zc, fibStep)
    fun ifib n = numOf (eval EMPTY (APP (fibTerm, LIT n)))

    (* --- native Troupe fib (same doubly recursive shape) --------------- *)
    fun nfib n = if n <= 1 then n else nfib (n - 1) + nfib (n - 2)

    (* --- timing helpers ------------------------------------------------ *)
    fun timeMs f =
        let val start  = getTime ()
            val result = f ()
            val finish = getTime ()
        in (result, finish - start)
        end

    fun repeat 0 _ = ()
      | repeat k f = (f (); repeat (k - 1) f)

    (* native fib is far below timer resolution for a single call, so time a
       growing batch until it exceeds 200 ms and report ms per call. *)
    fun nativePerCallMs n =
        let fun go reps =
                let val (_, el) = timeMs (fn () => repeat reps (fn () => nfib n))
                in if el >= 200 then el / reps else go (reps * 4)
                end
        in go 1
        end

    (* Sweep interpreted fib upward, printing (n, ms), stopping once one call
       exceeds the budget.  Returns (largest n within budget, its ms). *)
    val budgetMs = 4000
    fun sweep n bestN bestMs =
        let val (r, ms) = timeMs (fn () => ifib n)
        in print ("  interpreted fib", n, "=", r, "in", ms, "ms")
         ; if ms > budgetMs then (bestN, bestMs)
           else sweep (n + 1) n ms
        end

in print ("sanity: interpreted fib 10 =", ifib 10)   (* 55 *)
 ; print "--- interpreted fib timing (stop once one call exceeds 4000 ms) ---"
 ; let val (bestN, bestMs) = sweep 15 0 0
       val nativeAtBest       = nativePerCallMs bestN
       val (bigResult, bigMs) = timeMs (fn () => nfib 35)
   in print ("largest interpreted n within 4 s:", bestN, "at", bestMs, "ms")
    ; print "--- native Troupe fib ---"
    ; print ("native fib", bestN, "= ", nfib bestN,
             " (", nativeAtBest, "ms per call, averaged over a batch)")
    ; print ("native fib 35 =", bigResult, "in", bigMs, "ms (single call)")
    ; print ("interpreted/native slowdown at n =", bestN, ":",
             bestMs / nativeAtBest)
   end
end
