(* runall — run the data-structure benchmark set from one place.
 *
 * Runs every benchmark in the published DataStructures module (or a subset
 * named on the command line) at its default sizes, one untimed warmup plus
 * three timed repetitions per size, prints the Bench measurement lines as
 * it goes, and writes three artifacts via SimpleFileIO:
 *
 *   datastructures-results.txt   the raw measurement rows
 *   datastructures-report.md     per-benchmark medians and per-unit costs
 *   datastructures-charts.svg    small-multiple scaling charts
 *
 * The descriptors are a program-relative module imported below (recompiled
 * with the whole import graph on every run). The report renderer is reused
 * from the Savina study (the row shape (name, size, ms, ok) is identical)
 * and is still a shared SimpleModule blob; publish it once:
 *
 *   make benchmark-modules       (publishes SavinaReport)
 *   ./local.sh examples/benchmarks/datastructures/runall.trp --io-root out
 *   ./local.sh examples/benchmarks/datastructures/runall.trp --io-root out -- map-insert set-iterate
 *
 * The whole suite runs in a single Troupe process; between benchmarks the
 * main mailbox is drained (a self-sent marker behind FIFO delivery bounds
 * the drain), so a benchmark that leaked a message cannot confuse the next
 * one — a nonzero drain count is reported.
 *)

import List
import String
import Bench
import "./DataStructures"
import "../../savina/SavinaReport"

datatype Atoms = FLUSHMARK

let val args = getCliArgs authority

    val selected =
        if List.length args = 0 then DataStructures.all
        else List.filter (fn d => List.length
                                    (List.filter (fn a => a = d.name) args) > 0)
                         DataStructures.all

    val unknown =
        List.filter (fn a => List.length
                               (List.filter (fn d => d.name = a) DataStructures.all) = 0)
                    args

    fun flushMailbox () =
        let val _ = send (self (), FLUSHMARK)
            fun drain n =
                receive [ hn FLUSHMARK => n
                        , hn _         => drain (n + 1) ]
        in drain 0 end

    fun runOne d =
        let val rows = Bench.collectRows authority d.name d.sizes 3 d.bench d.check
            val leaked = flushMailbox ()
            val _ = if leaked > 0
                    then print (d.name, "leaked messages into main mailbox:", leaked)
                    else ()
        in List.map (fn (n, _, ms, ok) => (d.name, n, ms, ok)) rows end

    fun runAll ([], acc)      = List.reverse acc
      | runAll (d :: ds, acc) =
          runAll (ds, List.append (List.reverse (runOne d)) acc)

    fun save (path, content) =
        case writeFile (authority, path, content) of
          {tag = "Ok", value = _}  => print ("wrote", path)
        | {tag = "Err", error = e} => print ("write error", path, e.reason)

in if List.length unknown > 0
   then print ("unknown benchmarks:", unknown)
   else
     let val rows = runAll (selected, [])
         val summaries = SavinaReport.summarize rows
         val _ = save ("datastructures-results.txt", SavinaReport.resultLines rows ^ "\n")
         val _ = save ("datastructures-report.md", SavinaReport.markdown ("Data structures", summaries) ^ "\n")
         val _ = save ("datastructures-charts.svg", SavinaReport.svg summaries)
         val failed = List.filter (fn (_, ok, _) => not ok) summaries
     in print (List.length summaries, "benchmarks run,",
               List.length failed, "with failures")
     end
end
