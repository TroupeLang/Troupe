import Outcome
import IfcUtil
import { writeFile } SimpleFileIO
(* Does a file write check the level of its content? *)
let val secret = "the floor" raisedTo `<dungeon;#root-integrity>`
    val r = writeFile (authority, "secret.txt", secret)
in printWithLabels r end

(* OBSERVED 2026-10-08 (dev at dc058177, ./local.sh, default flags)
 *
 * run with --io-root=/tmp/wprobe. The write succeeds and the file holds the dungeon-level string.
 *
 *   (OK ()@{#ROOT}%{#ROOT})@{#ROOT}%{#ROOT}
 *   $ cat /tmp/wprobe/secret.txt
 *   the floor
 *)
