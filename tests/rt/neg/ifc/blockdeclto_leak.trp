(* Leak through blockdeclto: the target level operand is chosen by branching
 * on a bob-labeled secret, so the choice of target is itself secret. The
 * monitor rejects it because the level operand's data label must flow to the
 * target; declassifying to an observable target would leak the choice.
 *)
let val botL   = `<#null-confidentiality; #root-integrity>`
    val aliceL = `<alice; #root-integrity>`
    val bobL   = `<bob; #root-integrity>`

    val secret = true raisedTo bobL

    val target = if secret then botL else aliceL
    val target = downgradeType (target, authority, botL)
    val _ = blockdown authority

    val x = 42 raisedTo aliceL
    val _ = x + 0

    val aliceAuth = attenuate (authority, aliceL)
    val _ = blockdeclto (aliceAuth, target)
in adv ()
end
