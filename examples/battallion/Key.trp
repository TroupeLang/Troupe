(* Key — the terminal keys battallion has, decoded by the Proscenium decoder.
 *
 * A program-relative module of examples/battallion. Pure: no process, no receive, no timer.
 *
 * The bytes are read by `../proscenium/Key`, imported qualified as `Events` — one decoder for
 * both programs. That decoder answers in *events*, a key with a modifier record, a mouse report
 * or a paste, over a wider key set than battallion has; this module is the adapter between the
 * two, and it keeps battallion's own `key` values, its export surface, and the reading of `ESC c`
 * the editor's modality depends on. A datatype value carries the hash of the module that declared
 * it, so the two key sets are different values and every one of them is mapped here by hand.
 *
 * INPUT CONTRACT (unchanged). The input is the payload of a `Tty.TTY_DATA` event, which the
 * runtime builds with `chunk.toString('latin1')` (`rt/src/ffi/node/tty.mts:153`): one code unit
 * per byte, in 0..255, independent of where chunk boundaries fall. So a "character" in this
 * module's input is a byte, and a multibyte UTF-8 character is several of them.
 *
 *   val (keys, rest) = Key.decode (carry ^ bytes)
 *
 * `decode` is greedy and left-to-right. A trailing run of bytes that could still grow into a
 * longer sequence — a lone ESC, an unfinished CSI or SS3, a truncated UTF-8 character — is not
 * decoded; it comes back as `rest`, and the caller prepends it to the next chunk. `flush` reads
 * such a remainder as final, for when the input closed or the caller's timer fired.
 *
 * THE LONE-ESC AMBIGUITY IS THE CALLER'S. A lone ESC is either the Esc key or the first byte of
 * an escape sequence, and only elapsed time separates the two. Neither module guesses: the ESC
 * comes back as a remainder and the caller decides with the timer idiom (`lib/timeout.trp`, whose
 * message arrives in the same `Tty.nextEventWith` receive as the terminal events). `flush` is
 * what the caller calls when the timer wins.
 *
 * `ESC c` IS ESC THEN c, AND THAT IS THIS MODULE'S DOING. The shared decoder reads `ESC c` for c
 * other than "[", "O" as c with `alt = true`, the Alt chord an application with Alt bindings
 * wants. Battalion has no Alt chords and does have vim modality: pressing Esc to leave insert
 * mode and immediately typing a command produces exactly these bytes, and they must not be
 * swallowed. So `expand` turns an event with `alt = true` back into `KEY_ESC` followed by the
 * key — two battallion keys out of one event — which is the reading this key set has always had.
 * The cost is on the other side of the same ambiguity: `CSI 1;3 A` is Alt-Up in a terminal that
 * sends modifier parameters, and it now reads as Esc then Up rather than as Up.
 *
 * MODIFIERS ARE DROPPED. The shared decoder decodes the CSI modifier parameters — `CSI 1;5 A` is
 * Ctrl-Up, `CSI 1;2 F` Shift-End — and battallion has no modified motions, so a modified key is
 * the key. `shift` is read in one place only: `CSI Z` is the terminal's spelling of Shift-Tab,
 * which the shared decoder reads as Tab with shift and which battallion does not have, so it does
 * not become a Tab that would insert one.
 *
 * WHAT BATTALLION DOES NOT HAVE BECOMES KEY_UNKNOWN, NAMED. The shared decoder decodes function
 * keys, Insert, Shift-Tab, SGR mouse reports and bracketed pastes; battallion's key set has none
 * of them, and every one of them was KEY_UNKNOWN here before. Each becomes KEY_UNKNOWN carrying a
 * short name — "f5", "insert", "shift-tab", "mouse", "paste" — rather than being dropped, because
 * an unknown key is not nothing to this editor: it clears a transient status message, spends a
 * pending prefix, and dismisses the help page (`VimMotions.onKey`), and a key that disappeared
 * would do none of that. The payload of such a key is a name and not the bytes that produced it,
 * which is the one place KEY_UNKNOWN's payload is not raw input.
 *
 * SINGLE-BYTE DECISIONS, all the shared decoder's and all unchanged: 0x0a (LF) is Enter alongside
 * 0x0d (CR), because the same subscription delivers bytes from a pipe, where lines end in LF
 * (`lib/Tty.trp:70-71`); 0x08 (BS) is Backspace alongside 0x7f (DEL), because `infocmp
 * xterm-256color` reports `kbs=^H` while xterm's own backarrow default is DEL; 0x09 is Tab. None
 * of the four is reported as the control chord that shares its byte. 0x00 and 0x1c..0x1f are
 * KEY_UNKNOWN, CTRL-@ and CTRL-\ ] ^ _ carrying no letter and KEY_CTRL holding one.
 *
 * SEQUENCES. Both cursor-key encodings are decoded, the normal CSI form and the SS3 form a
 * terminal sends in application cursor mode (`smkx`); `infocmp -1 xterm-256color` on this machine
 * reports the SS3 spellings `kcuu1=\EOA`, `khome=\EOH`, `kend=\EOF`, and the CSI-only
 * `kdch1=\E[3~`, `kpp=\E[5~`, `knp=\E[6~`.
 *
 *   ESC [ A B C D    up, down, right, left        ESC O A B C D   the same, application mode
 *   ESC [ H F        home, end                    ESC O H F       the same
 *   ESC [ 1~ 7~      home                         ESC [ 4~ 8~     end
 *   ESC [ 5~ 6~      page up, page down           ESC [ 3~        delete
 *
 * A final byte and a "~" parameter the shared decoder names nothing for is KEY_UNKNOWN with the
 * whole sequence as its payload. A byte that is neither parameter, intermediate nor final ends a
 * CSI sequence: the bytes up to it become KEY_UNKNOWN and it is decoded on its own, so an aborted
 * sequence never eats the key that follows it.
 *
 * UTF-8. A lead byte and its continuations assemble into one KEY_PRINT holding the decoded code
 * point as a string; `String.strCode` is `String.fromCodePoint`, so a code point beyond the basic
 * plane arrives as its surrogate pair and the string is then two code units long
 * (`rt/src/builtins/string.mts:37-46`). A sequence that is invalid where it starts yields
 * KEY_UNKNOWN of the lead byte alone and decoding resumes at the next byte, so a bad byte costs
 * one key and never a lost resynchronisation.
 *
 * FLUSH READS THE REMAINDER BY BATTALLION'S RULES, not by the shared decoder's, which is why
 * `flush` here is `decode` plus `finalKeys` rather than a call to `Events.flush`: a remainder of
 * exactly ESC is the Esc key, ESC ESC is two of them, and anything else — an unfinished CSI or
 * SS3, a truncated UTF-8 character, a paste whose end marker never came — becomes one KEY_UNKNOWN
 * holding its raw bytes rather than a guess at what it was going to be. ESC ESC is a remainder
 * because the shared decoder holds a doubled ESC back to see whether a sequence follows it, and
 * the two Esc presses it stands for are what the editor must see.
 *
 * INVARIANTS.
 *
 *   1. Totality and progress. `decode` returns for every string, and each event it maps yields
 *      one key or two.
 *   2. The remainder is a suffix. `decode (s)` returns bytes that are a suffix of `s`, and it is
 *      only ever a run that a further byte could extend into a decodable sequence.
 *   3. Carrying is transparent. For every way of cutting a byte stream into chunks, feeding the
 *      chunks through `decode` with the remainder prepended to the next one yields the same keys
 *      in the same order as decoding the whole stream at once.
 *   4. `flush s` is `decode s` followed by the final reading of its remainder, so it agrees with
 *      `decode` on every key `decode` produced.
 *
 * The constructors of `key` are exported with the declaration whether or not this module lists
 * them, and matching on them is the interface. KEY_UNKNOWN is never empty.
 *
 * A misspelled nullary constructor in a pattern is a binder, not an error (`docs/VARIANTS.md`),
 * so a mistyped `KEY_PAGEUPP` branch silently matches every key. The names below are all the key
 * values there are. The `Events.` names below are qualified, so a mistyped one is a compile
 * error instead.
 *)

import List
import qualified "../proscenium/Key" as Events

datatype key = KEY_PRINT of string      (* one code point, as a string        *)
             | KEY_ENTER
             | KEY_TAB
             | KEY_BACKSPACE
             | KEY_DELETE
             | KEY_ESC
             | KEY_UP
             | KEY_DOWN
             | KEY_LEFT
             | KEY_RIGHT
             | KEY_HOME
             | KEY_END
             | KEY_PAGEUP
             | KEY_PAGEDOWN
             | KEY_CTRL of string       (* the chord's letter, lowercase      *)
             | KEY_UNKNOWN of string    (* the bytes that decoded to none, or
                                          the name of a key this set lacks   *)

let (* The two remainders `flush` reads as keys rather than as unknown bytes. *)
    val escString = "\x1b"
    val escEsc    = escString ^ escString

    (*--------------------------------  One key at a time  ------------------------------*)

    (** The battallion key a decoded key stands for. `shift` is read for one reading only: the
     *  shared decoder marks `CSI Z` as Tab with shift, and Shift-Tab is not a key here, so it
     *  must not arrive as the Tab that would insert one. *)
    fun keyOf (Events.KEY_PRINT c, _)    = KEY_PRINT c
      | keyOf (Events.KEY_ENTER, _)      = KEY_ENTER
      | keyOf (Events.KEY_TAB, shift)    = if shift then KEY_UNKNOWN "shift-tab" else KEY_TAB
      | keyOf (Events.KEY_BACKSPACE, _)  = KEY_BACKSPACE
      | keyOf (Events.KEY_DELETE, _)     = KEY_DELETE
      | keyOf (Events.KEY_INSERT, _)     = KEY_UNKNOWN "insert"
      | keyOf (Events.KEY_ESC, _)        = KEY_ESC
      | keyOf (Events.KEY_UP, _)         = KEY_UP
      | keyOf (Events.KEY_DOWN, _)       = KEY_DOWN
      | keyOf (Events.KEY_LEFT, _)       = KEY_LEFT
      | keyOf (Events.KEY_RIGHT, _)      = KEY_RIGHT
      | keyOf (Events.KEY_HOME, _)       = KEY_HOME
      | keyOf (Events.KEY_END, _)        = KEY_END
      | keyOf (Events.KEY_PAGEUP, _)     = KEY_PAGEUP
      | keyOf (Events.KEY_PAGEDOWN, _)   = KEY_PAGEDOWN
      | keyOf (Events.KEY_F n, _)        = KEY_UNKNOWN ("f" ^ toString n)
      | keyOf (Events.KEY_CTRL c, _)     = KEY_CTRL c
      | keyOf (Events.KEY_UNKNOWN b, _)  = KEY_UNKNOWN b

    (** One event, in front of the keys that follow it: an Alt-marked key is the Esc key and then
     *  the key itself, and a mouse report or a paste is one named unknown. *)
    fun push (Events.KEY (k, mods), acc) =
          let val k' = keyOf (k, mods.shift)
          in if mods.alt then KEY_ESC :: k' :: acc else k' :: acc
          end
      | push (Events.MOUSE _, acc) = KEY_UNKNOWN "mouse" :: acc
      | push (Events.PASTE _, acc) = KEY_UNKNOWN "paste" :: acc

    (** The keys a list of events stands for, in order. *)
    fun expand events = List.foldr push [] events

    (** The final reading of a remainder no further byte will extend. *)
    fun finalKeys rest =
             if rest = ""        then []
        else if rest = escString then [KEY_ESC]
        else if rest = escEsc    then [KEY_ESC, KEY_ESC]
        else [KEY_UNKNOWN rest]

    (*------------------------------------  Interface  ----------------------------------*)

    (** The keys `bytes` decodes to, and the trailing bytes that could still grow into a longer
     *  sequence. The caller prepends the remainder to the next chunk:
     *
     *    val (keys, carry') = Key.decode (carry ^ bytes)
     *)
    fun decode bytes =
        let val (events, rest) = Events.decode bytes
        in (expand events, rest)
        end

    (** The keys `bytes` decodes to when no further byte will arrive — the input closed, or the
     *  caller's timer fired on a pending remainder. A remainder of exactly ESC is the Esc key,
     *  ESC ESC is two of them, and any other remainder becomes one KEY_UNKNOWN holding its
     *  bytes. *)
    fun flush bytes =
        let val (keys, rest) = decode bytes
        in List.append keys (finalKeys rest)
        end

in [ ("decode", decode)
   , ("flush", flush)
   ]
end
