(* stdio model at the default ROOT channel level.

   A write must flow to the channel level, and flowing to ROOT requires root
   integrity, so alice-raised data is refused (see the negative test
   ifc-root-refuses-raised). Endorsing its integrity admits it; the blockdown
   lowers the blocking label, which the write's pc raise reads. *)
let val secret = 42 raisedTo `{alice}`
    val endorsed = endorse (secret, authority, `<alice;#root-integrity>`)
    val _ = blockdown authority
in print endorsed
end
