import Option

let (* -- List Access -- *)

    (** Returns the head of the list, i.e. `nth 0 l`. This results in a runtime error if the list is
        `null`. *)
    fun head x::_ = x

    (** Returns the tail of the list, i.e. the list without `head xs`. This results in a runtime
     *  error if the list is `null`. *)
    fun tail _::xs = xs

    (** Return the n-th element of the given list. The first element (head of the list) is at
        position 0. Raise Failure "nth" if the list is too short. *)
    fun nth x::_  0 = x
      | nth x::xs n = nth xs (n - 1)

    (* -- List Information -- *)

    (* TODO: isList out of the TCB *)

    (** Returns `true` if the given list is empty. *)
    fun null [] = true
      | null _  = false

    (** Returns `true` if an element satisfies the given predicate. Tail-recursive. *)
    fun exist f []    = false
      | exist f x::xs = if f x then true else exist f xs

    (** Returns `true` if an element satisfies the given predicate. Tail-recursive.
     *
     * Unlike `exist`, this runs `f` on elements even after having found a true candidate. This
     * raises the IFC level of the result to the same level regardless of the order of the elements
     * in `xs`.
     *)
    fun exist' f xs =
        let fun go acc []    = acc
              | go acc x::xs = go ((f x) orelse acc) xs
        in go false xs
        end

    (** Returns `true` if all elements satisfy the given predicate. Tail-recursive.  *)
    fun forall f xs = not (exist (fn x => not (f x)) xs)

    (** Returns `true` if all elements satisfy the given predicate. Tail-recursive.
     *
     * Unlike `forall`, this runs `f` on elements even after having found a violation. This raises
     * the IFC level of the result to the same level regardless of the order of the elements in
     * `xs`.
     *)
    fun forall' f xs = not (exist' (fn x => not (f x)) xs)

    (** Returns `true` if the element `x` exists in the list. *)
    fun elem x ys = exist (fn y => x = y) ys

    (** Returns the length of the given list. Tail-recursive. *)
    fun length xs =
        let fun go acc []    = acc
              | go acc x::xs = go (acc+1) xs
        in go 0 xs end

    (* -- List Manipulation -- *)

    (** List reversal. Tail-recursive. *)
    fun reverse ls =
        let fun rev [] a    = a
              | rev x::xs a = rev xs (x::a)
        in rev ls []
        end

    (** Catenate two lists. Not tail-recursive (length of the first argument). *)
    fun append []    ys = ys
      | append x::xs ys = x::(append xs ys)

    (* TODO: '@' operator? *)

    (** Catenate two lists, reversing the first. Tail-recursive. *)
    fun revAppend []    ys = ys
      | revAppend x::xs ys = revAppend xs (x::ys)

    (** Returns the sublist from `m` (inclusive) to `n` (exclusive). Not tail-recursive. *)
    fun sublist _ _ []    = []
      | sublist _ 0 _     = []
      | sublist 0 n x::xs = x::(sublist 0 (n - 1) xs)
      | sublist m n x::xs = sublist (m - 1) (n - 1) xs

    (** Catenate `ys` to `xs` at `index` (zero indexed). Not tail-recursive. *)
    fun appendAt xs ys index =
        let val xsFront = sublist 0 index xs
            val xsBack  = sublist index (length xs) xs
        in append xsFront (append ys xsBack)
        end

    (** Catenate all lists in `xss`, in order. Not tail-recursive. *)
    fun concat []      = []
      | concat xs::xss = append xs (concat xss)

    (* -- List Iterators -- *)

    (** Applies function `f` to a list with the results returned by `f`. Not tail-recursive. *)
    fun map f []    = []
      | map f x::xs = (f x)::(map f xs)

    (** Same as `List.map` but `f` is applied to the index of the element as first argument
        (counting from 0), and the element itself as second argument. Not tail-recursive. *)
    fun mapi f list =
        let fun mapi_aux j []    = []
              | mapi_aux j x::xs = (f (j,x)) :: (mapi_aux (j+1) xs)
        in mapi_aux 0 list
        end

    (* TODO: revMap *)

    (** Left-fold of `f` with start `y` over a list. *)
    fun foldl f y []    = y
      | foldl f y x::xs = foldl f (f (x,y)) xs

    (** Left-fold of `f` on a non-empty list using the head as the initial value. *)
    fun foldl1 f x::xs = foldl f x xs

    (** Right-fold of `f` with start `y` over a list. Tail-recursive (folds left
        over the reversed list). *)
    fun foldr f y xs = foldl f y (reverse xs)

    (** Returns the sublist of elements that satisfy `f`. Not tail-recursive. *)
    fun filter f []    = []
      | filter f x::xs = let val xs' = filter f xs in if f x then x::xs' else xs' end

    (** Returns `Option.some x` for the first element that satisfies `f`;
        otherwise `Option.none`. Tail-recursive. *)
    fun find f []    = Option.none
      | find f x::xs = if f x then Option.some x else find f xs

    (** Map `f` over the list, keeping the values of the `Option.some` results
        and dropping the `Option.none` ones. Not tail-recursive. *)
    fun mapPartial f []    = []
      | mapPartial f x::xs = case f x of
                               {tag = "Some", value = v} => v :: mapPartial f xs
                             | _                         => mapPartial f xs

    (** Same as `List.filter` but `f` is applied to the index of the element as first argument
        (counting from 0), and the element itself as second argument. Not tail-recursive. *)
    fun filteri f l = let fun go i []    = []
                            | go i x::xs = let val xs' = go (i+1) xs
                                           in if f (i,x) then x::xs' else xs' end
                      in go 0 l end

    (** Split the list `ls` into two reversed sublists depending on whether each respective element
        satisfies the predicate `f`. Tail-recursive. *)
    fun revPartition f ls =
        let fun partition_aux  (a,b) [] = (a, b)
              | partition_aux  (a,b) (x::xs) =
                if f x
                then partition_aux (x::a, b) xs
                else partition_aux (a, x::b) xs
        in partition_aux ([],[]) ls
        end

    (** Split the list `ls` into two sublists depending on whether each respective element satisfies
        the predicate `f`. Tail-recursive. *)
    fun partition f ls =
        let val (a,b) = revPartition f ls
        in (reverse a, reverse b)
        end

    (* -- List Generation -- *)

    (** Returns the list of elements `[0, .., n-1]`. Tail-recursive. *)
    (* TODO: Generalise to generate based on a function and a seed? *)
    fun range 0 = []
      | range n = let fun rng 0 acc = 0::acc
                       |  rng k acc = rng (k-1) (k::acc)
                  in rng (n-1) []
                  end

    (** Returns `[f 0, f 1, ..., f (n-1)]`. Not tail-recursive (uses `map`). *)
    fun tabulate n f = map f (range n)

    (* -- Sorting -- *)

    (** Returns the largest value in the given (non-empty) list according to the given less-than
     *  predicate. *)
    fun max cmp xs = foldl1 (fn (x, currMax) => if cmp currMax x then x else currMax) xs

    (** Returns the smallest value in the given (non-empty) list according to the given less-than
     *  predicate. *)
    fun min cmp xs =
        let fun cmp' x y = cmp y x
        in max cmp' xs end

    (** Returns a list with the same elements as in `l` but sorted based on the less-than predicate,
     *  `cmp` of type `'a -> 'a -> bool`. *)
    fun sort cmp xs =
        let (* List `xs` split into a list of non-empty sorted lists. *)
            fun split []         acc = acc
              | split (x::[])    acc = [x]::acc
              | split (x::y::xs) acc = let val acc' = (if cmp x y then [x,y] else [y,x])::acc
                                       in split xs acc' end

            (* Merge two sorted lists with `cmp`.
             *
             * TODO: Can this be done tail-recursively and also without `reverse`/`revAppend`?
             *)
            fun merge2 xs ys =
                let fun merge2_inner [] [] acc = reverse acc
                      | merge2_inner xs [] acc = reverse (revAppend xs acc)
                      | merge2_inner [] ys acc = reverse (revAppend ys acc)
                      | merge2_inner xs ys acc =
                        let val x = head xs
                            val y = head ys
                        in if cmp x y
                           then (* x <  y *)
                               merge2_inner (tail xs) (ys) (x::acc)
                           else (* y <= x *)
                               merge2_inner (xs) (tail ys) (y::acc)
                        end
                in merge2_inner xs ys []
                end

            (* Merge three sorted lists with `cmp`. TODO: Implement separately? *)
            fun merge3 xs ys zs = merge2 xs (merge2 ys zs)

            (* Merge all pairs of lists; if the list is of an odd length, then the last three lists
             * are merged together. This makes the list of even length with lists of (almost) the
             * same length.
             *)
            fun mergePairs []            acc = acc
              | mergePairs [xs,ys,zs]    acc = (merge3 xs ys zs)::acc
              | mergePairs (xs::ys::xss) acc = mergePairs xss ((merge2 xs ys)::acc)

            (* Repeatedly call `mergePairs` until it is a list of length 0 or 1. *)
            fun sort_inner []   = []
              | sort_inner [xs] = xs
              | sort_inner xss  = sort_inner (mergePairs xss [])

        in sort_inner (split xs [])
        end

in [ ("head", head)
   , ("tail", tail)
   , ("nth", nth)
   , ("null", null)
   , ("exist", exist)
   , ("exist'", exist')
   , ("forall", forall)
   , ("forall'", forall')
   , ("elem", elem)
   , ("length", length)
   , ("reverse", reverse)
   , ("append", append)
   , ("revAppend", revAppend)
   , ("appendAt", appendAt)
   , ("sublist", sublist)
   , ("map", map)
   , ("mapi", mapi)
   , ("foldl", foldl)
   , ("foldl1", foldl1)
   , ("filter", filter)
   , ("filteri", filteri)
   , ("partition", partition)
   , ("revPartition", revPartition)
   , ("range", range)
   , ("max", max)
   , ("min", min)
   , ("sort", sort)
   , ("foldr", foldr)
   , ("concat", concat)
   , ("find", find)
   , ("mapPartial", mapPartial)
   , ("tabulate", tabulate)
   ]
end
