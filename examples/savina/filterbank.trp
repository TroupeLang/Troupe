(* Savina benchmark: Filter Bank (parallelism group).
 *
 * The main process broadcasts a stream of n samples to 4 branch actors;
 * each branch runs an FIR filter (8 branch-specific coefficients) over a
 * sliding window and emits a filtered value every 4th sample once its
 * window is full; a combiner actor accumulates everything and reports the
 * total. Measures broadcast fan-out with per-branch stream processing and
 * fan-in.
 *
 * Verification recomputes the same filter bank sequentially on the same
 * (deterministic) input and compares totals.
 *
 *   ./local.sh examples/savina/filterbank.trp               # default sizes
 *   ./local.sh examples/savina/filterbank.trp -- 2000 8000  # explicit sizes
 *
 * Result: pipeline total; ok iff it is within 1e-3 of the sequential
 * reference.
 *)

import List
import ListPair
import Bench

datatype Atoms = SAMPLE | FLUSH | OUT | BRANCHDONE | RESULT

let val numBranches = 4
    val firLen = 8
    val decimation = 4

    fun coeffs b = List.map (fn j => (b + 1) / (j + 2)) (List.range firLen)

    fun takeUpTo (0, _)       = []
      | takeUpTo (_, [])      = []
      | takeUpTo (k, x :: xs) = x :: takeUpTo (k - 1, xs)

    fun dot (cs, window) =
        List.foldl (fn ((c, w), acc) => acc + c * w) 0.0 (ListPair.zip cs window)

    (* One filter step: returns (window', count', emitted value or []).
     * Shared by the branch actor and the sequential reference. *)
    fun step (cs, x, window, count) =
        let val w2 = takeUpTo (firLen, x :: window)
            val c2 = count + 1
        in if c2 >= firLen andalso c2 mod decimation = 0
           then (w2, c2, [dot (cs, w2)])
           else (w2, c2, [])
        end

    fun branch (b, comb) =
        let val cs = coeffs b
            fun loop (window, count) =
                receive
                  [ hn (SAMPLE, x) =>
                      let val (w2, c2, out) = step (cs, x, window, count)
                          val _ = List.map (fn y => send (comb, (OUT, y))) out
                      in loop (w2, c2) end
                  , hn FLUSH => send (comb, BRANCHDONE) ]
        in loop ([], 0) end

    fun combiner main =
        let fun loop (total, done) =
                if done = numBranches then send (main, (RESULT, total))
                else receive [ hn (OUT, y)     => loop (total + y, done)
                             , hn BRANCHDONE  => loop (total, done + 1) ]
        in loop (0.0, 0) end

    fun sampleAt i = (i mod 97) / 7.0

    fun reference n =
        let fun refBranch b =
                let val cs = coeffs b
                    fun go (i, window, count, acc) =
                        if i = n then acc
                        else let val (w2, c2, out) = step (cs, sampleAt i, window, count)
                             in go (i + 1, w2, c2,
                                    case out of [] => acc | y :: _ => acc + y)
                             end
                in go (0, [], 0, 0.0) end
        in List.foldl (fn (b, acc) => acc + refBranch b) 0.0
                      (List.range numBranches)
        end

    fun bench n =
        let val main = self ()
            val comb = spawn (fn () => combiner main)
            val branches = List.map (fn b => spawn (fn () => branch (b, comb)))
                                    (List.range numBranches)
            fun stream i =
                if i = n then List.map (fn p => send (p, FLUSH)) branches
                else (List.map (fn p => send (p, (SAMPLE, sampleAt i))) branches;
                      stream (i + 1))
            val _ = stream 0
        in receive [ hn (RESULT, total) => total ]
        end

    fun abs x = if x < 0.0 then 0.0 - x else x

    val sizes = Bench.sizesFromArgs (getCliArgs authority) [2000, 8000, 20000]
in Bench.run authority "filterbank" sizes 3 bench
     (fn n => fn total => abs (total - reference n) < 0.001)
end
