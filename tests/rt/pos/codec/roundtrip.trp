import Unit
import String
import List

(* gzip/gunzip and base64Encode/base64Decode: the primitives a Troupe program needs in order to
   read and write the serialized IR blob that carries mobile code.

   The intermediate values are byte strings -- every character a code unit in 0..255 -- because
   Troupe has no byte arrays. `gzip` produces one and `base64Encode` consumes one. *)

let val nul   = "\x00"
    val esc   = "\x1b"
    val snow  = "\xe2\x98\x83"                (* three characters, not one *)
    val emoji = String.strCode 128512         (* astral: a surrogate pair in UTF-16 *)

    fun double (s, 0) = s
      | double (s, n) = double (s ^ s, n - 1)

    val big = double ("the quick brown fox. ", 16)   (* about 1.4 MB *)

    val corpus = [ "", "a", "hello, world", nul, nul ^ esc ^ nul, snow, emoji
                 , "mixed " ^ nul ^ " text " ^ emoji ^ " end", big ]

    fun gzipRoundTrips s = gunzip (gzip s) = s
    fun b64RoundTrips  s = base64Decode (base64Encode s) = s

    (* Every character of a byte string is a code unit at most 255. *)
    fun isBytes s =
        let fun go i = if i >= String.size s then true
                       else if String.subCode (s, i) > 255 then false
                       else go (i + 1)
        in go 0
        end

    val tests = Unit.group "codec" [
            Unit.group "gzip" [
                Unit.it "every corpus member survives a round trip"
                        (Unit.isTrue (List.forall gzipRoundTrips corpus))
              , Unit.it "no corpus member fails"
                        (Unit.isEq [] (List.filter (fn s => gzipRoundTrips s = false) corpus))
              , Unit.it "the compressed form is a byte string"
                        (Unit.isTrue (List.forall (fn s => isBytes (gzip s)) corpus))
              , Unit.it "a run compresses to a fraction of its length"
                        (Unit.isTrue (String.size (gzip (double ("a", 20))) < 5000))
              , Unit.it "compression is deterministic within one host"
                        (Unit.isEq (gzip "hello, world") (gzip "hello, world"))
            ],
            Unit.group "base64" [
                Unit.it "every corpus member's compressed form survives a round trip"
                        (Unit.isTrue (List.forall (fn s => b64RoundTrips (gzip s)) corpus))
              , Unit.it "a known vector"
                        (Unit.isEq "aGVsbG8=" (base64Encode "hello"))
              , Unit.it "the empty string"
                        (Unit.isEq "" (base64Encode ""))
              , Unit.it "decoding ignores line breaks"
                        (Unit.isEq "hello" (base64Decode ("aGVs\x0abG8=" )))
            ],
            (* The blob framing itself lives in Troupe code, not in the builtins: an identifier,
             * a version byte, and a gzip stream, all base64 (see compiler/src/IRBlob.hs). *)
            Unit.group "blob framing" [
                let val doc    = "(troupe-ir-sexp 2 (fun \x22f\x22))"
                    val blob   = base64Encode ("TRPI" ^ String.strCode 2 ^ gzip doc)
                    val raw    = base64Decode blob
                in Unit.group "assembled and taken apart in Troupe" [
                       Unit.it "the identifier survives"
                               (Unit.isEq "TRPI" (String.substring (raw, 0, 4)))
                     , Unit.it "the version byte survives"
                               (Unit.isEq 2 (String.subCode (raw, 4)))
                     , Unit.it "the document survives"
                               (Unit.isEq doc
                                          (gunzip (String.substring (raw, 5, String.size raw))))
                   ]
                end
            ],
            (* All four are pure functions of their argument: the result carries the argument's
             * label, neither raised nor lowered. Unit.isEq compares levels as well as values. *)
            Unit.group "information flow" [
                let val secret = "hello, world" raisedTo `{alice}`
                in Unit.group "a labeled argument labels the result" [
                       Unit.it "gzip"
                               (Unit.isEq (levelOf secret) (levelOf (gzip secret)))
                     , Unit.it "base64Encode"
                               (Unit.isEq (levelOf secret) (levelOf (base64Encode (gzip secret))))
                     , Unit.it "the whole round trip returns the value with its label"
                               (Unit.isEq secret (gunzip (base64Decode
                                                          (base64Encode (gzip secret)))))
                   ]
                end
              , Unit.it "a public argument stays public"
                        (Unit.isEq (levelOf "x") (levelOf (gzip "x")))
            ]
        ]
in Unit.run authority tests
end
