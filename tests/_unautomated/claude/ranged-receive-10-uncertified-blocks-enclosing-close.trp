(* Ranged-receive v2 witness 10: an uncertified region blocks every enclosing close.

   Uniform LIFO discipline: an uncertified (ok = false) enable pushes an ordinary region
   that never closes, exactly like the legacy raise/lower behaviour where an un-lowerable
   raise blocks every enclosing lower. Certified region A (root authority, ceiling alice)
   is open when an uncertified enable U (null-confidentiality authority, ceiling bob)
   pushes on top of it: the active ceiling widens to Delta = alice join bob and capU becomes the
   chain head. A consume with l2 = bob passes the selection premise through the widened Delta, its result
   tainted with both terms. Then `disableRangedReceive capA` is REFUSED as ill-scoped —
   capA is no longer the chain head; U sits above it and U can never close, so A's
   capability is permanently un-fireable (the accepted side effect of uniform LIFO).

   Expected verdict: okA = true; okU = false; v1 tainted <alice&bob;#root-integrity>;
   then REFUSE at disable capA — "Ill-scoped enable/disable of ranged receive".
*)

let val me = self ()
    val _ = send (me, 1)
    val (okA, capA) = enableRangedReceive (`<;#root-integrity>`, `<alice;#root-integrity>`, authority)
    val _ = printWithLabels okA
    val nullConfAuth = attenuate (authority, `<;#root-integrity>`)
    val (okU, capU) = enableRangedReceive (`<;#root-integrity>`, `<bob;#root-integrity>`, nullConfAuth)
    val _ = printWithLabels okU
    (* the selection premise passes through the widened Delta = alice join bob *)
    val v1 = consume (0, `<;#root-integrity>`, `<bob;#root-integrity>`)
    val _ = printWithLabels v1
    (* capA is not the chain head: U sits above it and never closes *)
    val _ = disableRangedReceive capA
in ()
end

(* Actual (./local.sh): okA = true@{}%{}; okU = false@{}%{};
   v1 = (1-payload)@<alice&bob;#root-integrity>%<alice&bob;#root-integrity>;
   then thread error "Ill-scoped enable/disable of ranged receive: expected cap <U's uid>,
   provided cap <A's uid>". Matches expected — the uncertified region blocks the enclosing close. *)
