import Outcome

(** SimpleFileIO - file access reported as an Outcome rather than a tagged record.
 *
 *  The runtime builtins return `{tag = "Ok", value}` / `{tag = "Err", error = {reason, path}}`.
 *  This wrapper converts that at the boundary, so no library-source hash has to be embedded in
 *  the runtime to build a datatype value there.
 *
 *  Import it selectively to shadow the builtins, leaving call sites unchanged:
 *
 *    import { readFile, writeFile } SimpleFileIO
 *
 *    case readFile (authority, path) of OK src => ...
 *                                     | ERR e  => report (e.reason, e.path)
 *
 *  Every operation takes ROOT `authority` and resolves its path inside the `--io-root` subtree.
 *
 *  **Text or bytes.** `readFile`, `writeFile` and `appendFile` are UTF-8. `readFile` refuses a
 *  file that is not valid UTF-8 with `ERR {reason = "file is not valid UTF-8", path}` rather
 *  than substituting U+FFFD for the bytes it cannot decode: the substitution is invisible in
 *  the string, and writing that string back replaces the original bytes on disk.
 *
 *  `readFileBytes` and `writeFileBytes` read and write the bytes themselves, carried as a
 *  string with one code unit per byte -- the byte-string convention of `BytesAndZips` and of
 *  the terminal reader in `Tty`. Use them for a file whose contents are not text, or whose
 *  encoding the program decides for itself; use the text operations otherwise, since a byte
 *  string is not what `String` operations, comparisons or output expect for non-ASCII text.
 *  Passing `writeFileBytes` a string with a code unit above 255 is a defect in the calling
 *  program and fails as a thread error.
 *
 *  There is no `appendFileBytes`; appending is UTF-8 only.
 *)

let (* The builtins, captured before the definitions below shadow their names. *)
    val rawReadFile   = readFile
    val rawWriteFile  = writeFile
    val rawReadFileBytes  = readFileBytes
    val rawWriteFileBytes = writeFileBytes
    val rawAppendFile = appendFile
    val rawFileExists = fileExists
    val rawReadDir    = readDir
    val rawMakeDir    = makeDir
    val rawFileStat   = fileStat
    val rawRemoveFile = removeFile

    fun toOutcome {tag = "Ok",  value = v} = OK v
      | toOutcome {tag = "Err", error = e} = ERR e

    (** Contents of `path` decoded as UTF-8; `ERR {reason, path}` if it cannot be read, and
     *  `ERR {reason = "file is not valid UTF-8", path}` if its bytes are not UTF-8. *)
    fun readFile (auth, path) = toOutcome (rawReadFile (auth, path))

    (** Write `contents` to `path` as UTF-8; `ERR {reason, path}` if it cannot be written. *)
    fun writeFile (auth, path, contents) = toOutcome (rawWriteFile (auth, path, contents))

    (** Bytes of `path` as a string of one code unit per byte; `ERR {reason, path}` if it cannot
     *  be read. Nothing is decoded, so every file reads. *)
    fun readFileBytes (auth, path) = toOutcome (rawReadFileBytes (auth, path))

    (** Write the byte string `contents` to `path`, one byte per code unit. Fails as a thread
     *  error if a code unit is above 255. *)
    fun writeFileBytes (auth, path, contents) = toOutcome (rawWriteFileBytes (auth, path, contents))

    (** Append `contents` to `path`, creating it if absent. *)
    fun appendFile (auth, path, contents) = toOutcome (rawAppendFile (auth, path, contents))

    (** `OK true` / `OK false`; never `ERR`. A path outside the sandbox does not exist. *)
    fun fileExists (auth, path) = toOutcome (rawFileExists (auth, path))

    (** Entries of the directory `path` as a list of `{name, kind}`, where `kind` is one of
     *  "file", "dir" or "other". Entry order is unspecified; sort if it matters. *)
    fun readDir (auth, path) = toOutcome (rawReadDir (auth, path))

    (** Create `path` and any missing parents. Succeeds if it already exists. *)
    fun makeDir (auth, path) = toOutcome (rawMakeDir (auth, path))

    (** `{kind, size, mtime}` for `path`; `mtime` is in milliseconds since the epoch. A symlink
     *  reports `kind = "other"` rather than the kind of its target.
     *
     *  There is deliberately no creation time: a file written by a checkout is "created" then,
     *  so in a working tree the field cannot tell an added file from a restored one. *)
    fun fileStat (auth, path) = toOutcome (rawFileStat (auth, path))

    (** Delete the file `path`; `ERR` on a missing path or a directory. *)
    fun removeFile (auth, path) = toOutcome (rawRemoveFile (auth, path))

in [ ("readFile", readFile)
   , ("writeFile", writeFile)
   , ("readFileBytes", readFileBytes)
   , ("writeFileBytes", writeFileBytes)
   , ("appendFile", appendFile)
   , ("fileExists", fileExists)
   , ("readDir", readDir)
   , ("makeDir", makeDir)
   , ("fileStat", fileStat)
   , ("removeFile", removeFile)
   ]
end
