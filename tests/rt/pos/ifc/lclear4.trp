(* positive test; nested regions, closed innermost-first *)
let val (_, c1) = enableRangedReceive (`<;#root-integrity>`, `<alice;#root-integrity>`, attenuate (authority, `<alice;#root-integrity>`))
    val (_, c2) = enableRangedReceive (`<;#root-integrity>`, `<bob;#root-integrity>`, attenuate (authority, `<bob;#root-integrity>`))
    val _ = disableRangedReceive c2
    val _ = disableRangedReceive c1
in ()
end
