(* Test edge cases for bit operations *)
let val _ = printL ("Testing edge cases...")

    (* Test with negative numbers *)
    val _ = printL ("Negative numbers:")
    val _ = printL ("-1 andb 255 =", (-1) andb 255)
    val _ = printL ("-1 orb 0 =", (-1) orb 0)
    val _ = printL ("-1 xorb -1 =", (-1) xorb (-1))

    (* Test with 32-bit boundaries *)
    val _ = printL ("32-bit boundaries:")
    val _ = printL ("2147483647 << 1 =", 2147483647 << 1)
    val _ = printL ("-2147483648 >> 1 =", (-2147483648) >> 1)
    val _ = printL ("-1 ~>> 1 =", (-1) ~>> 1)
    
    (* Test with zeros *)
    val _ = printL ("Operations with zero:")
    val _ = printL ("0 andb 0 =", 0 andb 0)
    val _ = printL ("0 orb 0 =", 0 orb 0)
    val _ = printL ("0 xorb 0 =", 0 xorb 0)
    val _ = printL ("0 << 10 =", 0 << 10)
    val _ = printL ("0 >> 10 =", 0 >> 10)
    
    (* Test shift amounts *)
    val _ = printL ("Large shift amounts:")
    val _ = printL ("1 << 31 =", 1 << 31)
    val _ = printL ("1 << 32 =", 1 << 32)
    val _ = printL ("-2147483648 >> 31 =", (-2147483648) >> 31)
    val _ = printL ("-2147483648 ~>> 31 =", (-2147483648) ~>> 31)
    
in printL "Edge case tests completed!"
end