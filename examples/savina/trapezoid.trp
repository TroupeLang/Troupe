(* Savina benchmark: Trapezoidal Approximation (parallelism group).
 *
 * A master partitions the numeric integration of f over [0,1] into n
 * trapezoids (the size parameter) split across 8 workers; workers compute
 * partial sums and the master reduces them. Measures work distribution and
 * per-actor compute throughput.
 *
 * The Savina original integrates (1/(1+x)) * sqrt(1+e^(sqrt(2x))) * sin(x^3-1);
 * Troupe's math built-ins are limited to sqrt/floor/random, so this port
 * integrates f(x) = 4/(1+x^2), whose exact value over [0,1] is pi — making
 * the result self-checkable.
 *
 *   ./local.sh examples/savina/trapezoid.trp                  # default sizes
 *   ./local.sh examples/savina/trapezoid.trp -- 50000 200000  # explicit sizes
 *
 * Result: the integral estimate; ok iff it is within 1e-6 of pi.
 *)

import List
import Bench
import Savina

let val d = Savina.trapezoid
    val sizes = Bench.sizesFromArgs (getCliArgs authority) d.sizes
in Bench.run authority d.name sizes 3 d.bench d.check
end
