(* A secret stays a secret in another process.

   The main process sends alice's secret to a worker process, which tries
   to print it. The check refuses the worker's print and ends that
   process, and only that process: the main process, which asked to be
   told with `monitorlocal`, receives a ("DONE", ...) message carrying the
   failure and carries on. *)
let val secret = 42 raisedTo `{alice}`
    fun worker () =
      receive [ hn x => print x ]
    val p = spawn worker
    val _ = monitorlocal p
in send (p, secret);
   receive [ hn ("DONE", _, _, (1, why)) =>
               printString "the worker ended with an error; main continues" ];
   printString "done"
end
