(* Blob-consuming twin of runall.trp for the SimpleModule performance
 * parity experiment: identical behavior, but the benchmark descriptors
 * are restored from the published module blob instead of imported.
 * Writes its artifacts with a b- prefix so the two runs can be
 * compared side by side.
 *
 *   ./local.sh examples/savina/Savina.mod.trp        # publish first
 *   ./local.sh examples/savina/runallb.trp --io-root out -- pingpong sieve
 *)

import List
import String
import Bench
import SimpleModule
import SavinaReport

datatype Atoms = FLUSHMARK

let val args = getCliArgs authority
    val savina = SimpleModule.load "Savina"

    val selected =
        if List.length args = 0 then savina.all
        else List.filter (fn d => List.length
                                    (List.filter (fn a => a = d.name) args) > 0)
                         savina.all

    fun flushMailbox () =
        let val _ = send (self (), FLUSHMARK)
            fun drain n =
                receive [ hn FLUSHMARK => n
                        , hn _         => drain (n + 1) ]
        in drain 0 end

    fun runOne d =
        let val rows = Bench.collectRows authority d.name d.sizes 3 d.bench d.check
            val _ = flushMailbox ()
        in List.map (fn (n, _, ms, ok) => (d.name, n, ms, ok)) rows end

    fun runAll ([], acc)      = List.reverse acc
      | runAll (d :: ds, acc) =
          runAll (ds, List.append (List.reverse (runOne d)) acc)

    fun save (path, content) =
        case writeFile (authority, path, content) of
          {tag = "Ok", value = _}  => print ("wrote", path)
        | {tag = "Err", error = e} => print ("write error", path, e.reason)

    val rows = runAll (selected, [])
    val summaries = SavinaReport.summarize rows
    val _ = save ("b-savina-results.txt", SavinaReport.resultLines rows ^ "\n")
    val _ = save ("b-savina-report.md", SavinaReport.markdown summaries ^ "\n")
in print (List.length summaries, "benchmarks run from restored module")
end
