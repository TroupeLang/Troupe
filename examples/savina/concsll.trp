(* Savina benchmark: Concurrent Sorted Linked List (concurrency group).
 *
 * A server actor maintains a sorted list of distinct integers; 8 worker
 * actors each perform n operations against it — alternating inserts and
 * membership tests over a bounded value range — waiting for each reply.
 * The server counts successful (novel) inserts. Measures request/reply
 * contention on an ordered structure modeled as an actor.
 *
 *   ./local.sh examples/savina/concsll.trp                # default sizes
 *   ./local.sh examples/savina/concsll.trp -- 1000 4000   # explicit sizes
 *
 * Result: (snapshot is sorted, snapshot length, server insert count); ok
 * iff the final list is sorted ascending and its length equals the number
 * of successful inserts the server counted.
 *
 * Note: each operation walks the server's list (up to 500 elements), so
 * per-operation cost is dominated by that traversal; default sizes are
 * chosen accordingly.
 *)

import List
import Bench
import Savina

let val d = Savina.concsll
    val sizes = Bench.sizesFromArgs (getCliArgs authority) d.sizes
in Bench.run authority d.name sizes 3 d.bench d.check
end
