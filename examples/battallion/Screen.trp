(* Screen — the terminal escapes battallion writes, and the assembly of one frame.
 *
 * A program-relative module of examples/battallion. Pure: every function returns a string; no
 * descriptor, no process, no effect. Two consumers write those strings:
 *
 *   - the supervisor writes the terminal-*mode* escapes (`enterAlt`, `leaveAlt`, `showCursor`),
 *     because entering and leaving the alternate screen is terminal setup and teardown, which the
 *     supervisor owns;
 *   - the renderer writes `frame`, the whole visible screen, on every redraw.
 *
 * ESCAPES. `\x1b[?1049h` / `\x1b[?1049l` are the xterm private mode that switches to the
 * alternate screen buffer and back, so the shell's scrollback is untouched by the session.
 * `\x1b[?25l` / `\x1b[?25h` hide and show the cursor. `\x1b[H` homes the cursor, `\x1b[2K` erases
 * the whole line the cursor is on, and `\x1b[<row>;<col>H` positions the cursor, rows and
 * columns counting from one.
 *
 * THE CURSOR IS HIDDEN FOR THE LENGTH OF ONE FRAME, not for the length of the session. A frame
 * rewrites every row from the top, so a cursor left shown would be dragged across the screen row
 * by row as the rows are written; a frame therefore begins with `\x1b[?25l` and ends, after the
 * cursor has been put where it belongs, with `\x1b[?25h`. Between frames — which is where an
 * editor spends nearly all of its time — the cursor is on the screen and is whatever cursor the
 * user's terminal draws by default. Nothing here selects a shape: `CursorStyle.trp` is the seam
 * that would, and it is inert (its header says why).
 *
 * WHY `\x1b[2K` PER LINE AND NOT `\x1b[2J`. Erasing each line as it is rewritten means the
 * screen is never blank between the clear and the draw, which a clear-then-draw frame shows as
 * a flicker on a slow connection.
 *
 * WHY THE ERASE COMES BEFORE THE TEXT AND COVERS THE WHOLE LINE. A tab in the text moves the
 * terminal's cursor to the next tab stop without erasing the cells it passes over. Writing the
 * text first and erasing to end of line afterwards therefore leaves the previous frame's
 * characters standing in every cell a tab jumped across — stale text that survives every
 * subsequent redraw (found by the simulated-session harness on a tab-indented file). Erasing
 * the whole line first means a tab jumps over cells that are already blank.
 *
 * LINE ENDINGS ARE CRLF, written out rather than left to the driver. Whether a lone LF returns
 * the cursor to column one depends on the terminal's output post-processing, which raw mode may
 * or may not leave on — this runtime's raw mode does, measured as CR CR LF arriving on the wire
 * for each row of a frame — so a frame that relied on it would be correct on one terminal and a
 * staircase on the next.
 *
 * TRUNCATION IS BY CODE UNIT. A line is cut to the terminal's width with `String.substring`,
 * which counts UTF-16 code units, so a character outside the basic plane counts as two and a
 * line of wide (double-width) characters overflows the width it was cut to. The mvp viewer does
 * not measure display width; this is the same simplification `lib/Rope.trp` documents for its
 * offsets.
 *
 * THE LAST CELL IS NOT WRITTEN. A frame ends its last line without a newline, and truncation
 * leaves the bottom-right cell alone, because writing the last cell of the last row scrolls the
 * alternate screen by one line on most terminals.
 *)

import String

let val esc = "\x1b"

    (*------------------------------  Terminal mode  ------------------------------*)

    (** Switch to the alternate screen buffer. *)
    val enterAlt = esc ^ "[?1049h"

    (** Switch back to the normal screen buffer. *)
    val leaveAlt = esc ^ "[?1049l"

    val hideCursor = esc ^ "[?25l"
    val showCursor = esc ^ "[?25h"

    (*---------------------------------  Frames  ----------------------------------*)

    (** Move the cursor to `(row, col)`, both counting from zero here and emitted counting from
     *  one, which is what the terminal expects. *)
    fun cursorTo (row, col) =
        esc ^ "[" ^ toString (row + 1) ^ ";" ^ toString (col + 1) ^ "H"

    (** `line` cut to `width` code units. *)
    fun truncate (line, width) =
        if String.size line <= width then line else String.substring (line, 0, width)

    (** The whole visible screen: the cursor hidden, `lines` laid out from the top, each line
     *  erased whole before its text is written, the cursor left at `(curRow, curCol)`, `tail`
     *  written after it, and the cursor shown again.
     *
     *  `lines` is expected to hold exactly `rows` entries; a shorter list draws fewer rows and
     *  leaves the rest of the screen as it was, which is what a caller wants when the buffer has
     *  fewer lines than the terminal has rows only if it padded the list itself. `Editor.frameOf`
     *  pads.
     *
     *  `tail` is escapes that belong to the frame but not to any row — the cursor's appearance,
     *  which CursorStyle.trp is the seam for and which is empty as the editor stands. It goes
     *  after the cursor has been positioned, so that a frame's rows are exactly the text between
     *  the home and the position escapes, and before the show, so that whatever it selects is in
     *  force by the time the cursor is on the screen. *)
    fun frame (lines, width, curRow, curCol, tail) =
        let fun go ([], acc)      = acc
              | go ([l], acc)     = acc ^ esc ^ "[2K" ^ truncate (l, width)
              | go (l :: ls, acc) = go (ls, acc ^ esc ^ "[2K" ^ truncate (l, width) ^ "\r\n")
        in hideCursor ^ go (lines, esc ^ "[H") ^ cursorTo (curRow, curCol) ^ tail ^ showCursor
        end

in [ ("enterAlt", enterAlt)
   , ("leaveAlt", leaveAlt)
   , ("hideCursor", hideCursor)
   , ("showCursor", showCursor)
   , ("cursorTo", cursorTo)
   , ("truncate", truncate)
   , ("frame", frame)
   ]
end
