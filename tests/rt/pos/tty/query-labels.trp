(* The labels on the query results at the default channel level.

   ttyIsTTY and ttySize are observations drawn through the channel, so their
   results carry the channel level. ttyLevel is a configuration query, so its
   result stays at the caller's pc. *)
let val a = authority
    val i = stdin
    val o = stdout
    val _ = print (levelOf (ttyIsTTY i))
    val _ = print (levelOf (ttySize o))
    val _ = print (levelOf (ttyLevel i))
in ()
end
