(* Covered-read blocking quarantine, the consume variant: an in-region consume's firing
   decision reads the fold registers — the covered occurrence and the admission draw on
   the Δ-covered sub-stream, the floor check reads Φ under Φlab — so the folds
   quarantine the consume's blocking channel: bl ⊔= ... ⊔ Δ ⊔ Δlab ⊔ Φlab, on top of
   the operand terms.

   Here a region [public, alice] is open (Δ = alice), and a public point consume at the
   floor fires; all its operands are public, so the alice that lands in bl comes from
   the region fold Δ alone.

   Expected: debugpc after the enable shows bl = {} (public operands); debugpc after
   the consume shows bl = <alice;#root-integrity> — the fold term arrived in bl. *)

let val me = self ()
    val _ = send (me, 42)
    val (ok, cap) = enableRangedReceive (`<;#root-integrity>`, `<alice;#root-integrity>`, authority)
    val _ = debugpc ()
    val v = consume (0, `<;#root-integrity>`, `<;#root-integrity>`)
    val _ = debugpc ()
    val _ = printWithLabels v
    val _ = disableRangedReceive cap
in ()
end

(* Actual (./local.sh): BL:{} after the enable (public operands); BL:<alice;#root-integrity>
   after the consume — the region fold Δ arrived in bl; the removed message prints
   confined at the standing taint (@<alice;#root-integrity>); the disable succeeds.
   Matches expected. *)
