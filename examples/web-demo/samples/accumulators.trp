(* Accumulators, mutual recursion, and timing.

   `fib` written as `fib (n-1) + fib (n-2)` does exponential work; the
   same function with two accumulators is one pass, and a call in tail
   position costs no stack. `getTime ()` is the clock in milliseconds,
   so the program times both versions on the same input. `fun ... and`
   defines functions that call each other. *)
let fun fibSlow n = if n < 2 then n else fibSlow (n - 1) + fibSlow (n - 2)
    fun fibFast n =
      let fun go (i, a, b) = if i = 0 then a else go (i - 1, b, a + b)
      in go (n, 0, 1)
      end
    fun even n = if n = 0 then true else odd (n - 1)
    and odd n = if n = 0 then false else even (n - 1)
    fun timed name f x =
      let val t0 = getTime ()
          val r = f x
          val t1 = getTime ()
      in printString (name ^ " " ^ toString x ^ " = " ^ toString r
                      ^ "  (" ^ toString (t1 - t0) ^ " ms)")
      end
in timed "fibSlow" fibSlow 25;
   timed "fibFast" fibFast 25;
   timed "fibFast" fibFast 80;         (* too slow the other way *)
   print (even 10000, odd 10000)
end
