(* Key — decoding terminal input bytes into key values.
 *
 * A program-relative module of examples/battallion. Pure: no process, no receive, no timer.
 *
 * INPUT CONTRACT. The input is the payload of a `Tty.TTY_DATA` event, which the runtime builds
 * with `chunk.toString('latin1')` (`rt/src/ffi/node/tty.mts:153`): one code unit per byte, in
 * 0..255, independent of where chunk boundaries fall. So a "character" in this module's input is
 * a byte, and a multibyte UTF-8 character is several of them. A code unit above 255 cannot come
 * from that source; should one arrive, it is passed through as a printable key.
 *
 *   val (keys, rest) = Key.decode (carry ^ bytes)
 *
 * `decode` is greedy and left-to-right. A trailing run of bytes that could still grow into a
 * longer sequence — a lone ESC, an unfinished CSI or SS3, a truncated UTF-8 character — is not
 * decoded; it comes back as `rest`, and the caller prepends it to the next chunk. `flush` reads
 * such a remainder as final, for when the input closed or the caller's timer fired.
 *
 * THE LONE-ESC AMBIGUITY IS THE CALLER'S. A lone ESC is either the Esc key or the first byte of
 * an escape sequence, and only elapsed time separates the two. This module never guesses: it
 * returns the ESC as a remainder and lets the caller decide with the timer idiom
 * (`lib/timeout.trp`, whose message arrives in the same `Tty.nextEventWith` receive as the
 * terminal events). `flush` is what the caller calls when the timer wins.
 *
 * DECISIONS. The mvp key set (arrows, Home, End, PageUp, PageDown, Enter, Esc, Backspace, Tab,
 * Delete, control chords, printables) leaves several bytes to interpretation. Each choice below
 * is deliberate; a key named by the set wins over the control chord that shares its byte.
 *
 *   0x0a (LF)  Enter, alongside 0x0d (CR). A terminal in raw mode sends CR, but the same
 *              subscription delivers bytes from a pipe, where lines end in LF
 *              (`lib/Tty.trp:70-71`: "A terminal is not required"). Both readings of a line end
 *              reach the same key; CTRL-J is not produced.
 *   0x08 (BS)  Backspace, alongside 0x7f (DEL). `infocmp xterm-256color` on this machine reports
 *              `kbs=^H`, while xterm's own backarrow default is DEL; accepting both means the
 *              key works under either configuration. CTRL-H is not produced.
 *   0x09       Tab; CTRL-I is not produced. 0x0d: Enter; CTRL-M is not produced.
 *   0x00       KEY_UNKNOWN. CTRL-@ / CTRL-Space carries no letter, and KEY_CTRL holds a letter.
 *   0x1c-0x1f  KEY_UNKNOWN, for the same reason (CTRL-\ ] ^ _).
 *   ESC c      For c other than "[" and "O": KEY_ESC, then c is decoded on its own. This is the
 *              byte pattern of an Alt chord, which the mvp set does not have, and reading it as
 *              Esc-then-key is what keeps the caller's timer idiom coherent: pressing Esc to
 *              leave insert mode and immediately typing a command produces exactly these bytes,
 *              and they must not be swallowed. A later Alt-aware caller would have to reinstate
 *              the timer distinction here rather than in the decoder.
 *   CSI params A parameter run (0x30-0x3f) and an intermediate run (0x20-0x2f) are accepted
 *              before the final byte and, apart from the numeric parameter of a "~" sequence,
 *              discarded: the modified forms `CSI 1;5 A` (ctrl-Up) and `CSI 1;2 F` (shift-End,
 *              `kEND` in the same terminfo entry) decode to the unmodified key. The mvp set has
 *              no modified motions.
 *   Aborted    A byte that is neither parameter, intermediate nor final ends a CSI sequence: the
 *              bytes up to it become KEY_UNKNOWN and it is decoded on its own, so an aborted
 *              sequence never eats the key that follows it.
 *   flush      A remainder of exactly ESC becomes KEY_ESC. Any other remainder — unfinished CSI
 *              or SS3, truncated UTF-8 — can no longer complete, so it becomes one KEY_UNKNOWN
 *              holding its raw bytes rather than a guess at what it was going to be.
 *   KEY_UNKNOWN carries the raw bytes it stands for, exactly as they arrived, so a caller can
 *              log or re-examine them. It is never empty.
 *
 * SEQUENCES RECOGNISED. Both cursor-key encodings are decoded, the normal CSI form and the SS3
 * form a terminal sends in application cursor mode (`smkx`); `infocmp -1 xterm-256color` on this
 * machine reports the SS3 spellings `kcuu1=\EOA`, `khome=\EOH`, `kend=\EOF`, and the CSI-only
 * `kdch1=\E[3~`, `kpp=\E[5~`, `knp=\E[6~`.
 *
 *   ESC [ A B C D    up, down, right, left        ESC O A B C D   the same, application mode
 *   ESC [ H F        home, end                    ESC O H F       the same
 *   ESC [ 1~ 7~      home                         ESC [ 4~ 8~     end
 *   ESC [ 5~ 6~      page up, page down           ESC [ 3~        delete
 *
 * Every other final byte, and every other "~" parameter, is KEY_UNKNOWN with the whole sequence
 * as its payload — function keys and mouse reports included.
 *
 * UTF-8. A lead byte and its continuations assemble into one KEY_PRINT holding the decoded code
 * point as a string; `String.strCode` is `String.fromCodePoint`, so a code point beyond the basic
 * plane arrives as its surrogate pair and the string is then two code units long
 * (`rt/src/builtins/string.mts:37-46`). A sequence that is invalid where it starts — a stray
 * continuation byte, an overlong or out-of-range lead, a lead whose continuation is not one —
 * yields KEY_UNKNOWN of the lead byte alone and decoding resumes at the next byte, so a bad byte
 * costs one key and never a lost resynchronisation. Lead bytes are admitted only in the ranges
 * that cannot encode an overlong form, a surrogate, or a code point above U+10FFFF, which is why
 * `String.strCode` is never called outside its accepted range.
 *
 * INVARIANTS.
 *
 *   1. Totality and progress. `decode` returns for every string. Each step either produces one
 *      key and advances the position by at least one byte, or stops; no step advances by zero.
 *   2. The remainder is a suffix. `decode (s)` returns bytes that are a suffix of `s`, and it is
 *      only ever a run that a further byte could extend into a decodable sequence.
 *   3. Carrying is transparent. For every way of cutting a byte stream into chunks, feeding the
 *      chunks through `decode` with the remainder prepended to the next one yields the same keys
 *      in the same order as decoding the whole stream at once.
 *   4. `flush s` is `decode s` followed by the final reading of its remainder, so it agrees with
 *      `decode` on every key `decode` produced.
 *
 * The constructors of `key` are exported with the declaration whether or not this module lists
 * them, and matching on them is the interface. `KEY_UNKNOWN`'s payload is raw input, not a
 * stable name for anything.
 *
 * A misspelled nullary constructor in a pattern is a binder, not an error (`docs/VARIANTS.md`),
 * so a mistyped `KEY_PAGEUPP` branch silently matches every key. The names below are all the key
 * values there are.
 *)

import String
import List
import Option

datatype key = KEY_PRINT of string      (* one code point, as a string        *)
             | KEY_ENTER
             | KEY_TAB
             | KEY_BACKSPACE
             | KEY_DELETE
             | KEY_ESC
             | KEY_UP
             | KEY_DOWN
             | KEY_LEFT
             | KEY_RIGHT
             | KEY_HOME
             | KEY_END
             | KEY_PAGEUP
             | KEY_PAGEDOWN
             | KEY_CTRL of string       (* the chord's letter, lowercase      *)
             | KEY_UNKNOWN of string    (* the raw bytes that decoded to none *)

let (*--------------------------  The bytes this module names  --------------------------*)

    (* Single bytes that are keys. Each is excluded from the control-chord range below. *)
    val byteBS  = 0x08      (* backspace, terminfo kbs                                  *)
    val byteTAB = 0x09
    val byteLF  = 0x0a
    val byteCR  = 0x0d
    val byteESC = 0x1b
    val byteDEL = 0x7f

    (* The control chords: 0x01..0x1a are CTRL-a..CTRL-z, so a chord's letter is its byte plus
     * this offset. The four bytes above that fall inside the range are named keys instead. *)
    val ctrlLow    = 0x01
    val ctrlHigh   = 0x1a
    val ctrlLetter = 0x60

    (* Escape-sequence introducers: ESC "[" opens a CSI sequence, ESC "O" an SS3 one. *)
    val byteLBRACKET = 0x5b
    val byteOH       = 0x4f

    (* ECMA-48 5.4: a control sequence is a run of parameter bytes, then a run of intermediate
     * bytes, then one final byte. *)
    val paramLow  = 0x30    val paramHigh  = 0x3f
    val interLow  = 0x20    val interHigh  = 0x2f
    val finalLow  = 0x40    val finalHigh  = 0x7e

    (* Final bytes of the sequences that name keys. *)
    val finalA = 0x41   val finalB = 0x42   val finalC = 0x43   val finalD = 0x44
    val finalF = 0x46   val finalH = 0x48   val finalTILDE = 0x7e

    (* Printable ASCII, as a half-open range. *)
    val printLow  = 0x20
    val printHigh = 0x7f

    (* UTF-8. A continuation byte is 0x80..0xbf and contributes six bits. A lead byte's range
     * fixes the length; 0xc0 and 0xc1 would only ever encode an overlong two-byte form and
     * 0xf5..0xff a code point above U+10FFFF, so neither is a lead. *)
    val contLow   = 0x80
    val contHigh  = 0xbf
    val contScale = 0x40
    val lead2Low  = 0xc2
    val lead3Low  = 0xe0
    val lead4Low  = 0xf0
    val lead4High = 0xf4

    (* What a lead byte contributes: its value less the base of its length class. The two-byte
     * base is 0xc0 although 0xc0 is not an admitted lead; the other two bases are the floors
     * above. *)
    val lead2Base = 0xc0

    (* The continuation ranges that rule out the encodings UTF-8 forbids: an overlong three-byte
     * form after 0xe0, a surrogate after 0xed, an overlong four-byte form after 0xf0, and a code
     * point above U+10FFFF after 0xf4. *)
    val leadE0 = 0xe0   val leadE0Low  = 0xa0
    val leadED = 0xed   val leadEDHigh = 0x9f
    val leadF0 = 0xf0   val leadF0Low  = 0x90
    val leadF4 = 0xf4   val leadF4High = 0x8f

    (* Above this a code unit cannot have come from a latin1-decoded byte. *)
    val byteHigh = 0xff

    (* Decimal digits, for the numeric parameter of a "~" sequence. *)
    val digitLow  = 0x30
    val digitHigh = 0x39

    (* The one remainder `flush` reads as a key rather than as unknown bytes. *)
    val escString = "\x1b"

    (*-------------------------------  Reading the input  -------------------------------*)

    (** The code unit at `i`, or 0 past the end. *)
    fun byteAt (s, i) = String.subCode (s, i)

    (** The one-code-unit string at `i`. *)
    fun byte1 (s, i) = String.substring (s, i, i + 1)

    (** The end of the run of bytes in `lo..hi` starting at `j`, bounded by `n`. *)
    fun runEnd (s, n, j, lo, hi) =
        if j < n andalso byteAt (s, j) >= lo andalso byteAt (s, j) <= hi
        then runEnd (s, n, j + 1, lo, hi)
        else j

    (** The leading decimal number of `p`, or 0 when `p` does not start with a digit. No
     *  sequence this module names carries the parameter 0, so 0 stands for "none". *)
    fun leadingNumber p =
        let val n = String.size p
            fun go (j, acc) =
                if j >= n then acc
                else let val d = String.subCode (p, j)
                     in if d >= digitLow andalso d <= digitHigh
                        then go (j + 1, acc * 10 + (d - digitLow))
                        else acc
                     end
        in go (0, 0)
        end

    (*----------------------------  Escape-sequence readings  ---------------------------*)

    (** The key a "~" sequence with parameter string `p` names; `raw` is the whole sequence, for
     *  the readings that name nothing. *)
    fun tildeKey (p, raw) =
        let val m = leadingNumber p
        in      if m = 1 orelse m = 7 then KEY_HOME
           else if m = 4 orelse m = 8 then KEY_END
           else if m = 5              then KEY_PAGEUP
           else if m = 6              then KEY_PAGEDOWN
           else if m = 3              then KEY_DELETE
           else KEY_UNKNOWN raw
        end

    (** The key a sequence with final byte `f` and parameter string `p` names. Shared by CSI and
     *  SS3: SS3 carries no parameters and has no "~" final, so it reaches only the first six. *)
    fun finalKey (f, p, raw) =
             if f = finalA     then KEY_UP
        else if f = finalB     then KEY_DOWN
        else if f = finalC     then KEY_RIGHT
        else if f = finalD     then KEY_LEFT
        else if f = finalH     then KEY_HOME
        else if f = finalF     then KEY_END
        else if f = finalTILDE then tildeKey (p, raw)
        else KEY_UNKNOWN raw

    (** One CSI sequence starting at `i`, where `s` holds ESC "[" at `i`. `NONE` when the
     *  sequence has not finished arriving. *)
    fun stepCsi (s, n, i) =
        let val pEnd = runEnd (s, n, i + 2, paramLow, paramHigh)
            val k    = runEnd (s, n, pEnd,  interLow, interHigh)
        in if k >= n then NONE
           else let val f = byteAt (s, k)
                in if f < finalLow orelse f > finalHigh
                   then SOME (KEY_UNKNOWN (String.substring (s, i, k)), k)
                   else SOME ( finalKey ( f
                                        , String.substring (s, i + 2, pEnd)
                                        , String.substring (s, i, k + 1) )
                             , k + 1 )
                end
        end

    (** One SS3 sequence starting at `i`, where `s` holds ESC "O" at `i`. One final byte, no
     *  parameters. *)
    fun stepSs3 (s, n, i) =
        if i + 2 >= n then NONE
        else SOME ( finalKey (byteAt (s, i + 2), "", String.substring (s, i, i + 3))
                  , i + 3 )

    (** Whatever the ESC at `i` begins. *)
    fun stepEsc (s, n, i) =
        if i + 1 >= n then NONE
        else let val c = byteAt (s, i + 1)
             in      if c = byteLBRACKET then stepCsi (s, n, i)
                else if c = byteOH       then stepSs3 (s, n, i)
                else SOME (KEY_ESC, i + 1)
             end

    (*---------------------------------  UTF-8 characters  ------------------------------*)

    (** One UTF-8 character of `len` bytes starting at `i`, whose lead byte contributed `acc0`
     *  and whose first continuation byte must lie in `lo1..hi1`. `NONE` when the character has
     *  not finished arriving; KEY_UNKNOWN of the lead byte alone when a byte that did arrive is
     *  not the continuation it had to be. *)
    fun stepUtf8 (s, n, i, len, acc0, lo1, hi1) =
        let fun go (j, acc) =
                if j >= len then SOME (KEY_PRINT (String.strCode acc), i + len)
                else if i + j >= n then NONE
                else let val b  = byteAt (s, i + j)
                         val lo = if j = 1 then lo1 else contLow
                         val hi = if j = 1 then hi1 else contHigh
                     in if b < lo orelse b > hi
                        then SOME (KEY_UNKNOWN (byte1 (s, i)), i + 1)
                        else go (j + 1, acc * contScale + (b - contLow))
                     end
        in go (1, acc0)
        end

    (*--------------------------------------  The scan  ---------------------------------*)

    (** The key at `i` and the position after it, or `NONE` when the bytes from `i` on are an
     *  unfinished prefix. *)
    fun step (s, n, i) =
        let val c = byteAt (s, i)
        in      if c = byteESC                          then stepEsc (s, n, i)
           else if c = byteCR orelse c = byteLF         then SOME (KEY_ENTER, i + 1)
           else if c = byteTAB                          then SOME (KEY_TAB, i + 1)
           else if c = byteBS orelse c = byteDEL        then SOME (KEY_BACKSPACE, i + 1)
           else if c >= ctrlLow andalso c <= ctrlHigh
                then SOME (KEY_CTRL (String.strCode (c + ctrlLetter)), i + 1)
           else if c < printLow                         then SOME (KEY_UNKNOWN (byte1 (s, i)), i + 1)
           else if c < printHigh                        then SOME (KEY_PRINT (byte1 (s, i)), i + 1)
           else if c < lead2Low                         then SOME (KEY_UNKNOWN (byte1 (s, i)), i + 1)
           else if c < lead3Low
                then stepUtf8 (s, n, i, 2, c - lead2Base, contLow, contHigh)
           else if c < lead4Low
                then stepUtf8 ( s, n, i, 3, c - lead3Low
                              , if c = leadE0 then leadE0Low  else contLow
                              , if c = leadED then leadEDHigh else contHigh )
           else if c <= lead4High
                then stepUtf8 ( s, n, i, 4, c - lead4Low
                              , if c = leadF0 then leadF0Low  else contLow
                              , if c = leadF4 then leadF4High else contHigh )
           else if c > byteHigh                         then SOME (KEY_PRINT (byte1 (s, i)), i + 1)
           else SOME (KEY_UNKNOWN (byte1 (s, i)), i + 1)
        end

    fun scan (s, n, i, acc) =
        if i >= n then (List.reverse acc, "")
        else case step (s, n, i) of
                  SOME (k, next) => scan (s, n, next, k :: acc)
                | NONE           => (List.reverse acc, String.substring (s, i, n))

    (*------------------------------------  Interface  ----------------------------------*)

    (** The keys `bytes` decodes to, and the trailing bytes that could still grow into a longer
     *  sequence. The caller prepends the remainder to the next chunk:
     *
     *    val (keys, carry') = Key.decode (carry ^ bytes)
     *)
    fun decode bytes = scan (bytes, String.size bytes, 0, [])

    (** The keys `bytes` decodes to when no further byte will arrive — the input closed, or the
     *  caller's timer fired on a pending remainder. A remainder of exactly ESC is the Esc key;
     *  any other remainder becomes one KEY_UNKNOWN holding its bytes. *)
    fun flush bytes =
        let val (keys, rest) = decode bytes
        in      if rest = ""        then keys
           else if rest = escString then List.append keys [KEY_ESC]
           else List.append keys [KEY_UNKNOWN rest]
        end

in [ ("decode", decode)
   , ("flush", flush)
   ]
end
