(* Ranged-receive v2 witness 3: the ok = false confined path.

   The shown authority has no confidentiality power (attenuated to `<;#root-integrity>`),
   so it cannot certify restoring the mailbox view from `<alice;...>` down to public.
   The enable still SUCCEEDS: ok = false and the capability is invalid — the region is
   pushed like any other (uniform LIFO), it just never closes. The consume still
   passes (its selection premise draws on the widened Delta = alice) and its result is alice-tainted for as
   long as the region stays open, which is forever. The disable is REFUSED on the invalid
   capability (an uncertified region has no close).

   Expected verdict: ok = false; v tainted `<alice;#root-integrity>`; then REFUSE at the
   disable — "invalid capability ... has no close" (the capability IS the chain head here,
   so the refusal is attributed to validity, not scoping).
*)

let val me = self ()
    val _ = send (me, 42)
    val nullConfAuth = attenuate (authority, `<;#root-integrity>`)
    val (ok, cap) = enableRangedReceive (`<;#root-integrity>`, `<alice;#root-integrity>`, nullConfAuth)
    val _ = printWithLabels ok
    (* the selection premise draws on the widened Delta = alice; v is confined (the region never closes) *)
    val v = consume (0, `<;#root-integrity>`, `<alice;#root-integrity>`)
    val _ = printWithLabels v
    (* the capability is invalid: no close *)
    val _ = disableRangedReceive cap
in ()
end

(* Actual (./local.sh): ok = false@{}%{}; v = (42-payload)@<alice;#root-integrity>%<alice;#root-integrity>
   (confined); then thread error "disable on an invalid capability ... has no close".
   Matches expected. *)
