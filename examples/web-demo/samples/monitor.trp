(* Example: monitoring a process.

   The primitive `monitorlocal p` registers the current process to be
   notified of the termination of process `p`. The notification is a
   message `("DONE", ref, pid, reason)`, where `reason` is `0` for normal
   termination and `(1, text)` for a runtime error. The supervisor below
   starts a worker, sends it three jobs, and restarts the worker after
   the second job divides by zero. The runtime prints the error report
   of the worker between the lines of the supervisor. Note that a
   process blocked in `receive` keeps the node alive; the last worker is
   therefore told to stop. *)
let fun worker () =
      receive [ hn "stop" => ()
              , hn (from, a, b) => (send (from, a div b); worker ()) ]
    fun supervise p jobs =
      case jobs of
        [] => (send (p, "stop"); printString "no more jobs")
      | (a, b) :: rest =>
          ( send (p, (self (), a, b))
          ; receive [ hn ("DONE", _, _, (1, why)) =>
                        ( printString ("worker failed: " ^ why)
                        ; printString "restarting the worker"
                        ; supervise (start ()) rest )
                    , hn r => ( print r; supervise p rest ) ] )
    and start () =
      let val p = spawn worker
          val _ = monitorlocal p
      in p
      end
in supervise (start ()) [(100, 5), (1, 0), (81, 9)]
end
