(* A labeled value sent to another process.

   The main process sends alice's secret to a worker process, which
   attempts to print it. The output results in an information flow
   violation, which terminates the worker process only. The main process
   has registered with `monitorlocal` to be notified of the termination
   of the worker; it receives the message `("DONE", ...)` with the reason
   and continues. *)
let val secret = 42 raisedTo `{alice}`
    fun worker () =
      receive [ hn x => print x ]
    val p = spawn worker
    val _ = monitorlocal p
in send (p, secret);
   receive [ hn ("DONE", _, _, (1, why)) =>
               printString "the worker ended with an error; main continues" ];
   printString "done"
end
