(* negative test; ill-scoped enable/disable of ranged receives. Both regions are
   certified (root authority), so the refusal is attributed to the LIFO scoping and
   not to an invalid capability. *)
let val (_, c1) = enableRangedReceive (`{}`, `{alice}`, authority)
    val (_, c2) = enableRangedReceive (`{}`, `{bob}`, authority)
    val _ = disableRangedReceive c1
    val _ = disableRangedReceive c2
in ()
end
