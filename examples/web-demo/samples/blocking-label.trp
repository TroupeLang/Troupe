(* Termination and blocking flows.

   Each process has two runtime labels: the pc label, and the blocking
   label, which records the levels on which the progress of the process
   has depended. A branch on a secret can leak via termination, as one
   branch may block or fail, so the blocking label is raised to the label
   of the guard and remains raised after the conditional. After the
   conditional below, the pc label is lowered back to `{}`, but the
   blocking label remains `{alice}`, and every output is an information
   flow violation, including a public string and the declassified result
   of the branch, because performing the output reveals that the process
   got this far. The error report shows the effect level `{alice}` for a
   value whose own label is `{}`. The next sample declassifies the
   blocking label. *)
let val _ = setStdioLevel (authority, `{}`)
    val secret = 42 raisedTo `<alice;#root-integrity>`
    val _ = printString "before the branch"
    val bucket = if secret > 40 then "high" else "low"
    val released = declassify (bucket, authority, `{}`)
in printWithLabels released;
   printString "after the branch"
end
