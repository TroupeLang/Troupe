(* Declassification of the blocking level.

   Lowering the blocking label is a declassification and requires
   authority. The primitive `blockdeclto (authority, lev)` lowers the
   blocking label of the process to `lev`. The function `pdeclassify`
   from the library `IfcUtil` declassifies a value and the blocking label
   in one step; after it, the process can write to the standard output
   again. The primitive `_bl ()` returns the blocking label, and the
   program prints it once it is `{}`. Note that `declassify` on its own
   raises the blocking label as well, as a declassification may fail;
   this is why these samples use `pdeclassify`. *)
import IfcUtil
let val _ = setStdioLevel (authority, `{}`)
    val secret = 42 raisedTo `<alice;#root-integrity>`
    val bucket = if secret > 40 then "high" else "low"
    val released = pdeclassify (bucket, authority, `{}`)
in printWithLabels released;
   print (_bl ());
   printString "after the branch";
   (if secret mod 2 = 0 then () else ());    (* raises the blocking label to {alice} *)
   blockdeclto (authority, `{}`);            (* lowers it to {} *)
   printString "and again"
end
