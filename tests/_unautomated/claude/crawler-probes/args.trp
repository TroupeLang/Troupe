import IfcUtil
import List
let val _ = debugpc ()
    val raw = getCliArgs authority
    val _ = debugpc ()
    val args = IfcUtil.declassifyDeep (raw, authority, IfcUtil.bot)
    val _ = debugpc ()
    val _ = printWithLabels args
    val n = case args of a :: k :: _ => 2 | _ => 0
    val _ = debugpc ()
    val _ = printWithLabels n
in () end

