(* Example: sorting.

   The program implements insertion sort, which inserts each element into
   the sorted rest of the list, and quicksort, which partitions the list
   around a pivot using `List.partition`. Both take the ordering as a
   function argument, and so the same definitions sort in ascending or
   descending order, or by a component of each element. The library
   function `List.sort` is a merge sort with the same convention. *)
import List
let fun insert lt x [] = [x]
      | insert lt x (y :: ys) = if lt x y then x :: y :: ys
                                else y :: insert lt x ys
    fun isort lt [] = []
      | isort lt (x :: xs) = insert lt x (isort lt xs)
    fun qsort lt [] = []
      | qsort lt (p :: xs) =
        let val (small, large) = List.partition (fn x => lt x p) xs
        in List.append (qsort lt small) (p :: qsort lt large)
        end
    val xs = [38, 27, 43, 3, 9, 82, 10]
    val people = [("carol", 35), ("alice", 31), ("bob", 42)]
in print (isort (fn a => fn b => a < b) xs);
   print (qsort (fn a => fn b => a > b) xs);
   print (List.sort (fn a => fn b => a < b) xs);
   print (qsort (fn (_, a) => fn (_, b) => a < b) people);   (* by age *)
   print (qsort (fn (a, _) => fn (b, _) => a < b) people)    (* by name *)
end
