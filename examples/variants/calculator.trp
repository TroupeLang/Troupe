(* Calculator over an arithmetic-expression datatype.
 *
 * Demonstrates:
 *   - a nullary-constructor datatype (binop: add/sub/mul/divide) used as an
 *     enumeration of operators;
 *   - a recursive datatype (expr) whose constructors carry payloads: a
 *     numeric literal, a binary node holding an operator and two subtrees,
 *     and a unary negation;
 *   - a result datatype ('a result = ok of 'a | err of string) that reports
 *     division by zero instead of failing;
 *   - constructor patterns in case heads, and nested constructor patterns
 *     (bin (oper, l, r)) that destructure the operator and both subtrees;
 *   - a pretty-printer rendering an expr as an infix string.
 *
 * Sequential scoping: binop is declared before expr, which refers to it.
 *
 *   ./local.sh examples/variants/calculator.trp --localonly
 *
 * Expected: each expression is printed as its infix rendering followed by
 * its evaluated result (ok n), except the divide-by-zero case which yields
 * (err "division by zero").
 *)

datatype binop = add | sub | mul | divide

datatype expr = lit of int
              | bin of binop * expr * expr
              | neg of expr

datatype 'a result = ok of 'a | err of string

let (* Render a binary operator as its infix symbol. *)
    fun opSym add    = "+"
      | opSym sub    = "-"
      | opSym mul    = "*"
      | opSym divide = "/"

    (* Pretty-print an expression as a fully-parenthesised infix string. *)
    fun show (lit n)          = toString n
      | show (neg e)          = "-" ^ show e
      | show (bin (op, l, r)) = "(" ^ show l ^ " " ^ opSym op ^ " " ^ show r ^ ")"

    (* Apply an operator, guarding division by zero. *)
    fun apply divide _ 0 = err "division by zero"
      | apply add a b    = ok (a + b)
      | apply sub a b    = ok (a - b)
      | apply mul a b    = ok (a * b)
      | apply divide a b = ok (a / b)

    (* Evaluate an expression to a result, propagating the first error. *)
    fun eval (lit n) = ok n
      | eval (neg e) =
          (case eval e of
               ok v  => ok (0 - v)
             | err m => err m)
      | eval (bin (op, l, r)) =
          (case (eval l, eval r) of
               (ok a, ok b) => apply op a b
             | (err m, _)   => err m
             | (_, err m)   => err m)

    fun report e = print (show e ^ "  =>  " ^ toString (eval e))

    (* (8 + -4) * 5 *)
    val e1 = bin (mul, bin (add, lit 8, neg (lit 4)), lit 5)
    (* 100 / (2 - 2)  -- division by zero *)
    val e2 = bin (divide, lit 100, bin (sub, lit 2, lit 2))
    (* 3 * (4 + 5) *)
    val e3 = bin (mul, lit 3, bin (add, lit 4, lit 5))
in report e1
 ; report e2
 ; report e3
end
