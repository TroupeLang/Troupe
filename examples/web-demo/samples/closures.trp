(* Closures and partial application.

   A function value captures the variables that are in scope at the point
   of its creation. The function `adder` returns a function in which `n`
   remains bound, e.g., `add5` and `add10` are closures over different
   values of `n`. Curried function declarations and partial application
   are supported: `scale 3` is a function that expects the second
   argument, and `compose` builds a function out of two functions. *)
import List
let fun adder n = fn x => x + n
    val add5 = adder 5
    val add10 = adder 10
    fun scale k x = k * x
    fun compose f g = fn x => f (g x)
    val scaleThenAdd = compose add5 (scale 3)   (* x => 3 * x + 5 *)
    fun makeGreeter greeting = fn name => greeting ^ ", " ^ name ^ "!"
    val hello = makeGreeter "hello"
    val goodbye = makeGreeter "goodbye"
in print (add5 1);
   print (add10 1);
   print (List.map (scale 3) [1, 2, 3]);
   print (scaleThenAdd 10);
   printString (hello "alice");
   printString (goodbye "bob");
   print (List.map (fn f => f 100) [add5, add10, scale 2])
end
