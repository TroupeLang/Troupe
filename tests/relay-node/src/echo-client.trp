(* alice: after 3 s, finds bob's "echo" through the relay node and sends one request;
   exits 0 on the reply and 124 if none arrives within 30 s of the start. *)
let val _ = spawn (fn () => (sleep 30000; print "CLIENT: timeout"; exit (authority, 124)))
    val _ = sleep 3000
    val s = whereis ("@bob", "echo")
    val _ = print "CLIENT: found echo"
    val _ = send (s, ("ECHO", "hello", self ()))
    val r = receive [ hn ("REPLY", x) => x ]
    val _ = print ("CLIENT: reply " ^ r)
in exit (authority, 0)
end
