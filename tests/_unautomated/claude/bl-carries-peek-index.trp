(* Blocking-label quarantine, the peek variant: whether an i-th in-interval
   message exists is a firing decision that reads the operands and the sub-stream up
   to the active ceiling, so the peek builtin raises bl ⊔= ld(i) ⊔ ld(l1) ⊔ ld(l2) ⊔ Δ ⊔ Δlab
   (on top of the l2 ⊔ boost raise inside __mbox.peek).

   Here the index is a public 0 carried at a secret data label (raisedTo alice), with
   public bounds and no region — the alice that lands in bl is the index label alone.
   The result taint already carried lev(i); the quarantine puts it in bl too.

   Expected: first debugpc shows bl = {}; debugpc after the peek shows
   bl = <alice;#root-integrity>; the peeked value prints tainted with alice. *)

let val me = self ()
    val _ = send (me, 42)
    val i = 0 raisedTo `<alice;#root-integrity>`
    val _ = debugpc ()
    val v = peek (i, `<;#root-integrity>`, `<;#root-integrity>`)
    val _ = debugpc ()
    val _ = printWithLabels v
in ()
end

(* Actual (./local.sh): BL:{} before; BL:<alice;#root-integrity> after the peek — the
   index label arrived in bl; the peeked message prints tainted
   @<alice;#root-integrity>%<alice;#root-integrity>. Matches expected. *)
