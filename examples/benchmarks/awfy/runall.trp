(* runall — run the Are-We-Fast-Yet micro evaluation from one place.
 *
 * Runs every benchmark in the Awfy module (or a subset named on the
 * command line) at its default sizes, one untimed warmup plus three
 * timed repetitions per size, and prints the Bench measurement lines as
 * it goes. Structured after examples/savina/runall.trp; the AWFY micros
 * are sequential kernels, so there is no inter-benchmark mailbox to drain.
 *
 * The benchmark descriptors are a program-relative module imported below;
 * the compiler recompiles the whole import graph on every run, so there
 * is nothing to publish first:
 *
 *   ./local.sh examples/benchmarks/awfy/runall.trp
 *   ./local.sh examples/benchmarks/awfy/runall.trp -- sieve towers
 *)

import List
import Bench
import "./Awfy"

let val args = getCliArgs authority

    val selected =
        if List.length args = 0 then Awfy.all
        else List.filter (fn d => List.length
                                    (List.filter (fn a => a = d.name) args) > 0)
                         Awfy.all

    val unknown =
        List.filter (fn a => List.length
                               (List.filter (fn d => d.name = a) Awfy.all) = 0)
                    args

    fun runOne d =
        let val rows = Bench.collectRows d.name d.sizes 3 d.bench d.check
        in List.map (fn (n, _, ms, ok) => (d.name, n, ms, ok)) rows end

    fun runAll ([], acc)      = List.reverse acc
      | runAll (d :: ds, acc) =
          runAll (ds, List.append (List.reverse (runOne d)) acc)

in if List.length unknown > 0
   then print ("unknown benchmarks:", unknown)
   else
     let val rows   = runAll (selected, [])
         val failed = List.filter (fn (_, _, _, ok) => not ok) rows
     in print (List.length rows, "rows,", List.length failed, "with failures")
     end
end
