(* A password checker that releases one bit.

   A process holds alice's password and answers guesses. Comparing a
   guess with the password gives a boolean that is alice's, and the
   checker releases that boolean only, with an authority attenuated to
   alice; the password itself keeps its label and never leaves the
   process at a lower one. The release is `pdeclassify`, which also
   clears the checker's blocking label: a message sent by a process
   whose blocking label is alice's is invisible to the public `receive`
   in the main process. Two guesses are made, a wrong one and the right
   one, and the replies arrive public. *)
import IfcUtil
let val _ = setStdioLevel (authority, `{}`)
    val password = "correct horse battery staple" raisedTo `<alice;#root-integrity>`
    val aliceAuth = attenuate (authority, `<alice;#root-integrity>`)
    fun checker () =
      receive [ hn ("guess", g, from) =>
                  let val verdict = pdeclassify (g = password, aliceAuth, `{}`)
                  in send (from, verdict); checker ()
                  end
              , hn "stop" => () ]
    val c = spawn checker
    fun try g = (send (c, ("guess", g, self ())); receive [ hn v => v ])
in printWithLabels (try "hunter2");
   printWithLabels (try "correct horse battery staple");
   send (c, "stop")
end
