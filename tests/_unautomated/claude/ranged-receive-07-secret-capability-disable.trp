(* Ranged-receive v2 witness 7: the secret-capability disable negative.

   Two nested regions are opened with the SAME floor/ceiling, differing only in the
   authority shown at the enable (attenuated-alice vs root). Because the lo/hi are equal,
   the branch-balance discipline (which compares the clearance record) cannot distinguish
   the two. A secret then selects which capability to hand to the disable. The disable is
   refused by its occurrence premise pc ⊔ ld(cap) ⊑ pc_enable — ld(cap) now carries the
   secret, and pc_enable is public — BEFORE it can branch on the capability's validity or
   chain position. So the secret cannot leak through whether the close was well-scoped.

   Expected verdict: both enables ok = true; then REFUSE at the disable — the disable
   occurrence check reports a capability label of <secret;#root-integrity>.
*)

let val me = self ()
    val _ = send (me, 42)
    val authAlice = attenuate (authority, `<alice;#root-integrity>`)
    val (okA, capA) = enableRangedReceive (`<;#root-integrity>`, `<alice;#root-integrity>`, authAlice)
    val _ = printWithLabels okA
    val (okB, capB) = enableRangedReceive (`<;#root-integrity>`, `<alice;#root-integrity>`, authority)
    val _ = printWithLabels okB
    (* the secret selects the capability, tainting it to <secret;...> *)
    val c = if (true raisedTo `<secret;#root-integrity>`) then capA else capB
    (* refused by the disable's occurrence premise: ld(c) = secret ⋤ pc_enable = public *)
    val _ = disableRangedReceive c
in ()
end

(* Actual (./local.sh): okA = okB = true@{}%{}; then thread error
   "disable occurrence check failed ... capability label: <secret;#root-integrity>". Matches expected. *)
