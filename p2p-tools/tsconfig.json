{
    "compilerOptions": {
        "outDir": "./built",
        "allowJs": true,
        "moduleResolution": "node16",
        "module": "Node16",
        "target": "ES2022",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "incremental": true,
        "lib": ["ESNext"],
        "strict": false,
        "types": ["node"]
    },
    "include": [
        "./*.ts",
        "./*.mts"
    ]
}