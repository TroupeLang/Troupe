(* Savina sor: successive over-relaxation on a g*g grid; each cell is an actor
 * exchanging boundary values with its neighbors, checked against a sequential
 * reference. Exports `descriptor`. *)

import List
import Vector

datatype dir = Up | Down | Left | Right
datatype 'a msg = Wire of int * float * 'a list * 'a list * 'a list * 'a list
                | Val of dir * float | Final of int * float

let val iterations = 16
    fun initial (x, y) = ((x * 7 + y * 13) mod 100) / 10.0
    fun cell master =
        receive [ hn (Wire (myId, v0, ups, downs, lefts, rights)) =>
            let val deg = List.length ups + List.length downs
                          + List.length lefts + List.length rights
                fun sendAll v =
                    (List.map (fn p => send (p, Val (Down, v))) ups;
                     List.map (fn p => send (p, Val (Up, v))) downs;
                     List.map (fn p => send (p, Val (Right, v))) lefts;
                     List.map (fn p => send (p, Val (Left, v))) rights;
                     ())
                fun recvOr0 dir =
                    case dir of
                      [] => 0.0
                    | [Up]    => receive [ hn (Val (Up, x))    => x ]
                    | [Down]  => receive [ hn (Val (Down, x))  => x ]
                    | [Left]  => receive [ hn (Val (Left, x))  => x ]
                    | [Right] => receive [ hn (Val (Right, x)) => x ]
                fun iterate (t, v) =
                    if t = 0 then send (master, Final (myId, v))
                    else let val _ = sendAll v
                             val su = recvOr0 (case ups of [] => [] | _ => [Up])
                             val sd = recvOr0 (case downs of [] => [] | _ => [Down])
                             val sl = recvOr0 (case lefts of [] => [] | _ => [Left])
                             val sr = recvOr0 (case rights of [] => [] | _ => [Right])
                             val sum = (su + sd) + (sl + sr)
                         in iterate (t - 1, (v + sum) / (1.0 + deg)) end
            in iterate (iterations, v0) end ]
    fun reference g =
        let val grid0 = Vector.tabulate (g * g) (fn id =>
                            initial (id mod g, (id div g)))
            fun nb (grid, x, y) =
                if x < 0 orelse x >= g orelse y < 0 orelse y >= g then 0.0
                else Vector.sub (grid, y * g + x)
            fun deg (x, y) =
                (if y > 0 then 1 else 0) + (if y < g - 1 then 1 else 0)
                + (if x > 0 then 1 else 0) + (if x < g - 1 then 1 else 0)
            fun step grid =
                Vector.tabulate (g * g) (fn id =>
                    let val x = id mod g
                        val y = (id div g)
                        val sum = (nb (grid, x, y - 1) + nb (grid, x, y + 1))
                                  + (nb (grid, x - 1, y) + nb (grid, x + 1, y))
                    in (Vector.sub (grid, id) + sum) / (1.0 + deg (x, y)) end)
            fun go (t, grid) = if t = 0 then grid else go (t - 1, step grid)
        in go (iterations, grid0) end
    fun bench g =
        let val main = self ()
            val cells = List.map (fn _ => spawn (fn () => cell main))
                                 (List.range (g * g))
            fun pidAt (x, y) =
                if x < 0 orelse x >= g orelse y < 0 orelse y >= g then []
                else [List.nth cells (y * g + x)]
            val _ = List.mapi
                      (fn (id, p) =>
                         let val x = id mod g
                             val y = (id div g)
                         in send (p, Wire (id, initial (x, y),
                                      pidAt (x, y - 1), pidAt (x, y + 1),
                                      pidAt (x - 1, y), pidAt (x + 1, y)))
                         end)
                      cells
            fun collect (k, acc) =
                if k = 0 then acc
                else receive [ hn (Final (id, v)) => collect (k - 1, (id, v) :: acc) ]
            val finals = collect (g * g, [])
            val ref = reference g
            fun valueAt id =
                case List.filter (fn (j, _) => j = id) finals of
                  [(_, v)] => v
            fun allEqual id =
                id = g * g orelse
                (valueAt id = Vector.sub (ref, id) andalso allEqual (id + 1))
        in allEqual 0 end
    val descriptor =
        { name  = "sor"
        , bench = bench
        , check = fn g => fn same => same
        , sizes = [8, 12, 16] }
in [ ("descriptor", descriptor) ] end
