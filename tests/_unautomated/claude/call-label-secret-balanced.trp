(* Call-label channel positive: a BALANCED raise/lower pair inside a
   secret-labelled call.

   The call flags the frame (the function value's label {alice} raises the
   pc), but the callee restores the clearance before returning, so the
   balance check at the return passes.

   Expected verdict: ACCEPT — prints "done" (the pc raise is scoped to the
   call frame and restored at its return, so the print is back at low pc;
   nothing is refused). *)

let val f = (fn () =>
      let val c = raisembox (`{alice}`)
      in lowermbox (c, authority)
      end) raisedTo `{alice}`
    val _ = f ()
in printWithLabels "done"
end

(* Actual (./local.sh): "done"@{}%{}; main thread finished with
   ()@{alice}%{alice}. Matches expected (ACCEPT). *)
