(* The libraries `Map` and `Set`.

   Maps and sets are balanced search trees over keys of any type; the
   ordering on keys is passed as a function, here `<` on strings. The
   program counts the occurrences of each word in a text, prints the
   counts in key order, and uses a set to find the words of a second text
   that do not occur in the first one. *)
import Map
import Set
import String
import List
let val text = "the cat sat on the mat and the dog sat on the cat"
    val words = String.split " " text
    fun lt a b = a < b
    val counts = List.foldl (fn (w, m) => Map.insert m w (Map.findOrDefault m w 0 + 1))
                            (Map.empty lt) words
    val seen = Set.fromList lt words
    val other = Set.fromList lt (String.split " " "the dog ate the fish")
    val new = Set.filter (fn w => not (Set.mem seen w)) other
in print (Map.size counts);
   List.map (fn (w, n) => printString (String.padRight 5 " " w ^ toString n))
            (Map.toAscList counts);
   print (Map.findOpt counts "cat", Map.findOpt counts "fish");
   print (Set.toAscList seen);
   print (Set.toAscList new)
end
