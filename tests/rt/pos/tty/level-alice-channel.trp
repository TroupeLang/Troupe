(* With the channel level set by the operator, ttyLevel reports it, and an
   observation drawn through the channel carries it. The level ttyLevel returns
   is itself at the caller's pc: it discloses the run configuration, not
   anything observed through the channel. *)
let val a = authority
    val i = stdin
    val _ = print (ttyLevel i)
    val _ = print (levelOf (ttyLevel i))
    val _ = print (levelOf (ttyIsTTY i))
in ()
end
