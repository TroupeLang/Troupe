(* A constructor payload may be a record. The payload slot holds an ordinary
   record value, so a record pattern under the constructor pattern destructures
   it and the field types nest like any other payload type. The empty record is
   the degenerate case. *)

datatype shape = circle of {r : int}
               | rect   of {w : int, h : int}
               | empty  of {}

datatype 'a tagged = tag of {name : string, payload : 'a, kids : {n : int} list}

datatype nested = box of {inner : {deep : int}}

let fun area (circle {r = r})      = 3 * r * r
      | area (rect {w = w, h = h}) = w * h
      | area (empty {})            = 0

    fun depth (box {inner = {deep = d}}) = d

    val t = tag {name = "t", payload = [1, 2], kids = [{n = 7}]}

in print (area (circle {r = 2}));
   print (area (rect {w = 3, h = 4}));
   print (area (empty {}));
   print (depth (box {inner = {deep = 9}}));
   print t;
   print (case t of tag {name = n, payload = _, kids = _} => n)
end
