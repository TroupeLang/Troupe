(* Example: receive with a timeout.

   A `receive` statement waits until a message matches one of its
   handlers; it has no time limit of its own. The program implements a
   timeout as follows: a spawned process sleeps and then sends a unique
   string created by `mkuuid ()`, and the receive has a handler whose
   guard `when s = token` selects that string. The first server answers
   within 100 ms, and the answer arrives in time. The second server takes
   three seconds, and the timeout handler is selected first; its late
   answer stays in the mailbox. *)
let fun slowServer delay =
      receive [ hn ("ask", from) => (sleep delay; send (from, "answer")) ]
    fun askWithTimeout server ms =
      let val token = mkuuid ()
          val me = self ()
          val _ = spawn (fn () => (sleep ms; send (me, token)))
      in send (server, ("ask", me));
         receive [ hn "answer" => "got an answer"
                 , hn s when s = token => "timed out after " ^ toString ms ^ " ms" ]
      end
in printString (askWithTimeout (spawn (fn () => slowServer 100)) 1000);
   printString (askWithTimeout (spawn (fn () => slowServer 3000)) 500)
end
