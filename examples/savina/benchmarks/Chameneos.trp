(* Savina chameneos: 10 creatures meet at a mall, exchange colors n times, and
 * report their meeting counts; result is 2n. Exports `descriptor`. *)

import List

datatype 'a msg = Meet of int * 'a | Change of int | Exit | Done of int

let val numChameneos = 10
    fun complement (c1, c2) = if c1 = c2 then c1 else 3 - c1 - c2
    fun creature (mall, main, color, count) =
        (send (mall, Meet (color, self ()));
         receive [ hn (Change c) => creature (mall, main, c, count + 1)
                 , hn Exit        => send (main, Done count) ])
    fun mall meetings =
        let fun loop (waiting, m, exited) =
                if exited = numChameneos then ()
                else receive [ hn (Meet (c, p)) =>
                    if m = 0 then (send (p, Exit); loop (waiting, m, exited + 1))
                    else case waiting of
                           [] => loop ([(c, p)], m, exited)
                         | (c2, p2) :: _ =>
                             let val nc = complement (c, c2)
                                 val _ = send (p, Change nc)
                                 val _ = send (p2, Change nc)
                             in loop ([], m - 1, exited) end ]
        in loop ([], meetings, 0) end
    fun bench n =
        let val main = self ()
            val mallPid = spawn (fn () => mall n)
            val _ = List.map
                      (fn i => spawn (fn () =>
                          creature (mallPid, main, i mod 3, 0)))
                      (List.range numChameneos)
            fun collect (k, total) =
                if k = 0 then total
                else receive [ hn (Done c) => collect (k - 1, total + c) ]
        in collect (numChameneos, 0) end
    val descriptor =
        { name  = "chameneos"
        , bench = bench
        , check = fn n => fn t => t = 2 * n
        , sizes = [2000, 8000, 20000] }
in [ ("descriptor", descriptor) ] end
