(* Accumulators, mutual recursion, and timing.

   The function `fibSlow` makes two recursive calls per step and does an
   exponential amount of work. The function `fibFast` carries the two
   previous numbers as accumulators and makes one tail call per step.
   The primitive `getTime` returns the current time in milliseconds; the
   program uses it to time both versions. Mutually recursive functions
   are delimited using the `and` keyword. *)
let fun fibSlow n = if n < 2 then n else fibSlow (n - 1) + fibSlow (n - 2)
    fun fibFast n =
      let fun go (i, a, b) = if i = 0 then a else go (i - 1, b, a + b)
      in go (n, 0, 1)
      end
    fun even n = if n = 0 then true else odd (n - 1)
    and odd n = if n = 0 then false else even (n - 1)
    fun timed name f x =
      let val t0 = getTime ()
          val r = f x
          val t1 = getTime ()
      in printString (name ^ " " ^ toString x ^ " = " ^ toString r
                      ^ "  (" ^ toString (t1 - t0) ^ " ms)")
      end
in timed "fibSlow" fibSlow 25;
   timed "fibFast" fibFast 25;
   timed "fibFast" fibFast 80;         (* fibSlow 80 would not finish *)
   print (even 10000, odd 10000)
end
