(* Basic declassification.

   Declassifying information requires a capability known as the
   declassification authority. At the start of a program, the top-level
   authority is bound to variable `authority`. The function
   `pdeclassify (v, authority, lev)` from the library `IfcUtil` returns
   `v` relabeled at `lev`, here `{}`, and the result can be printed on
   the standard output. The last line prints `average` without
   declassification, which results in an information flow violation. A
   label has a confidentiality component and an integrity component,
   written `<confidentiality;integrity>`; the secret below is
   confidential to alice but computed by this program, so its integrity
   component is `#root-integrity`, and the declassification lowers only
   the confidentiality component. *)
import IfcUtil
let val secret = 42 raisedTo `<alice;#root-integrity>`
    val average = (secret + 58) div 2
    val published = pdeclassify (average, authority, `{}`)
in printWithLabels published;
   print published;
   printWithLabels average
end
