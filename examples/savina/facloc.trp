(* Savina benchmark: Online Facility Location (parallelism group).
 *
 * Random 2D points stream through a growing chain of facility actors.
 * Each facility accepts points within radius 100 of its center; a point
 * rejected by every facility becomes a new facility at the end of the
 * chain (like the sieve, with a geometric predicate). Measures streaming
 * through a dynamically growing pipeline with numeric work per stage.
 *
 * This port keeps the online-clustering core of the Savina benchmark and
 * drops its quadrant-tree partitioning; the chain is the degenerate
 * single-branch case.
 *
 *   ./local.sh examples/savina/facloc.trp                # default sizes
 *   ./local.sh examples/savina/facloc.trp -- 1000 4000   # explicit sizes
 *
 * Result: facility reports; ok iff accepted counts sum to n and every
 * input point lies within the radius of some facility center (rechecked
 * sequentially against the collected centers).
 *)

import List
import Bench

datatype Atoms = POINT | STOPCHAIN | FACREPORT | CHAINDONE

let val radius2 = 10000.0   (* radius 100, squared *)
    val range = 1000.0

    fun facility (cx, cy, main) =
        let fun loop (next, accepted) =
                receive
                  [ hn (POINT, x, y) =>
                      let val dx = x - cx
                          val dy = y - cy
                      in if dx * dx + dy * dy <= radius2
                         then loop (next, accepted + 1)
                         else case next of
                                [] => loop ([spawn (fn () => facility (x, y, main))],
                                            accepted)
                              | nf :: _ => (send (nf, (POINT, x, y));
                                            loop (next, accepted))
                      end
                  , hn STOPCHAIN =>
                      (send (main, (FACREPORT, cx, cy, accepted));
                       case next of
                         []      => send (main, CHAINDONE)
                       | nf :: _ => send (nf, STOPCHAIN)) ]
        in loop ([], 1) end   (* the founding point counts as accepted *)

    fun bench n =
        let val main = self ()
            val points = List.map (fn _ => (random () * range, random () * range))
                                  (List.range n)
            val (x0, y0) = List.head points
            val root = spawn (fn () => facility (x0, y0, main))
            val _ = List.map (fn (x, y) => send (root, (POINT, x, y)))
                             (List.tail points)
            val _ = send (root, STOPCHAIN)
            fun collect (centers, total) =
                receive
                  [ hn (FACREPORT, cx, cy, c) =>
                      collect ((cx, cy) :: centers, total + c)
                  , hn CHAINDONE => (centers, total) ]
            val (centers, total) = collect ([], 0)
            fun covered (x, y) =
                let fun go [] = false
                      | go ((cx, cy) :: cs) =
                          let val dx = x - cx
                              val dy = y - cy
                          in dx * dx + dy * dy <= radius2 orelse go cs end
                in go centers end
            fun allCovered [] = true
              | allCovered ((x, y) :: ps) = covered (x, y) andalso allCovered ps
        in (total, allCovered points)
        end

    val sizes = Bench.sizesFromArgs (getCliArgs authority) [1000, 4000, 10000]
in Bench.run authority "facloc" sizes 3 bench
     (fn n => fn (total, cov) => total = n andalso cov)
end
