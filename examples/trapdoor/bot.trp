(* bot — a player written against the public side only: it reads the same model the screen is
 * drawn from and presses the same keys.
 *
 *   ./local.sh examples/trapdoor/bot.trp -- SEED [TURNS]
 *
 * It plays one game from SEED for at most TURNS key presses (default 4000), prints the final
 * screen, and ends with one line: the seed, the outcome (won, dead, stuck or unfinished), and
 * the floor and turn reached. The exit code is 0 when the game ran to an outcome without a
 * runtime error, whatever the outcome.
 *
 * POLICY, first rule that applies: drink a potion when below half health; read any scroll;
 * put on better gear; attack an adjacent monster; pick up what lies underfoot; walk towards
 * the nearest item, else the nearest corridor or doorway cell not yet stood on, else the
 * trapdoor, and go down it. Rooms need no walking over: entering one shows all of it.
 *
 * The bot knows the floor only through `known`, the model's record of what the views have
 * shown, so a game it wins is a game won on declassified information alone.
 *)

import List
import Option
import String
import IfcUtil
import "../proscenium/Key"
import "./Rng"
import "./Lore"
import "./Dungeon"
import "./World"
import "./Ui"

let val lev  = `<dungeon;#root-integrity>`
    val dm   = attenuate (authority, lev)
    val weak = attenuate (authority, IfcUtil.null)

    val args = IfcUtil.declassifyDeep (getCliArgs authority, authority, IfcUtil.bot)
    val _ = blockdeclto (authority, IfcUtil.bot)
    val (given, limit) =
            case args of
                 a :: b :: _ => (Rng.seedOfString a, Option.getOrElse (Rng.seedOfString b) 4000)
               | a :: _      => (Rng.seedOfString a, 4000)
               | _           => (NONE, 0)
    val usage = case given of SOME _ => false | NONE => true
    val shownSeed = case given of SOME n => n | NONE => 0
    val seed = shownSeed raisedTo lev

    val _ = setStdioLevel (authority, IfcUtil.bot)

    val world = spawn (fn () => World.run (dm, weak, lev, seed))

    (*---------------------------------  Reading the model  ---------------------------------*)

    val dirs = [ (0 - 1, 0, "h"), (1, 0, "l"), (0, 0 - 1, "k"), (0, 1, "j")
               , (0 - 1, 0 - 1, "y"), (1, 0 - 1, "u"), (0 - 1, 1, "b"), (1, 1, "n") ]

    fun cellAt (rows, x, y) =
        if x < 0 orelse x >= Lore.mapW orelse y < 0 orelse y >= Lore.mapH then " "
        else String.sub (List.nth rows y, x)

    fun mark (rows, x, y) =
        List.mapi (fn (i, row) => if i = y then Dungeon.setSpan (row, x, "x") else row) rows

    fun passable g = g <> " " andalso g <> "-" andalso g <> "|"

    fun isItem g = g = "!" orelse g = "?" orelse g = ")" orelse g = "[" orelse g = "$" orelse g = "*"

    fun isMonster g =
        let val c = String.subCode (g, 0)
        in (c >= 65 andalso c <= 90) orelse (c >= 97 andalso c <= 122)
        end

    fun unmarked () = List.map (fn _ => String.repeat Lore.mapW " ") (List.range Lore.mapH)

    (** The key of the first step on a shortest path from `(px, py)` to the nearest other
     *  known cell satisfying `wanted`, or NONE. *)
    fun towards (known, (px, py), wanted) =
        let fun expand (x, y, k0, seen, back) =
                List.foldl (fn ((dx, dy, k), (seen, back)) =>
                                let val nx = x + dx
                                    val ny = y + dy
                                in if passable (cellAt (known, nx, ny)) andalso cellAt (seen, nx, ny) = " "
                                   then (mark (seen, nx, ny), (nx, ny, if k0 = "" then k else k0) :: back)
                                   else (seen, back)
                                end)
                           (seen, back) dirs
            fun go ([], [], seen) = NONE
              | go ([], back, seen) = go (List.reverse back, [], seen)
              | go ((x, y, k0) :: front, back, seen) =
                    if k0 <> "" andalso wanted (x, y) then SOME k0
                    else let val (seen', back') = expand (x, y, k0, seen, back)
                         in go (front, back', seen')
                         end
        in go ([(px, py, "")], [], mark (unmarked (), px, py))
        end

    (*-----------------------------------  Choosing  -----------------------------------*)

    fun firstOf (inv, cls) =
        let fun go ([], _) = NONE
              | go ((c, _, _) :: rest, i) = if c = cls then SOME i else go (rest, i + 1)
        in go (inv, 0)
        end

    fun letter i = String.strCode (97 + i)

    (** The rank of a weapon or armour by its base kind, read off the item's name. *)
    fun rank (names, name) =
        let fun go ([], _) = 0 - 1
              | go (n :: rest, i) = if String.endsWith n name then i else go (rest, i + 1)
        in go (names, 0)
        end

    (** The pack position of an item of class `cls` better than the one in use, or NONE. *)
    fun upgrade (inv, cls, names) =
        let val inUse = List.foldl (fn ((c, name, note), best) =>
                                        if c = cls andalso note <> "" then rank (names, name) else best)
                                   (0 - 1) inv
            fun go ([], _) = NONE
              | go ((c, name, note) :: rest, i) =
                    if c = cls andalso note = "" andalso rank (names, name) > inUse then SOME i
                    else go (rest, i + 1)
        in go (inv, 0)
        end

    val weaponNames = List.map (fn w => w.name) Lore.weapons
    val armourNames = List.map (fn a => a.name) Lore.armours

    (** The keys to press next and the trail with this cell added; no keys means nothing is
     *  left to do. *)
    fun choose (m, trail0) =
        let val (px, py) = m.pos
            val trail = mark (trail0, px, py)
            val (depth, hp, maxhp, str, ac, gold, xp, lvl, turn) = m.stats
            val here = cellAt (m.known, px, py)
            val packFull = List.length m.inv >= 20
            val foe = List.find (fn (dx, dy, _) => isMonster (cellAt (m.lit, px + dx, py + dy))) dirs
            fun walk wanted = towards (m.known, (px, py), wanted)
            fun untrodden (x, y) =
                let val g = cellAt (m.known, x, y)
                in (g = "#" orelse g = "+") andalso cellAt (trail, x, y) = " "
                end
            val keys =
                case (if hp * 2 < maxhp then firstOf (m.inv, "!") else NONE) of
                     SOME i => ["q", letter i]
                   | NONE =>
                case firstOf (m.inv, "?") of
                     SOME i => ["r", letter i]
                   | NONE =>
                case upgrade (m.inv, ")", weaponNames) of
                     SOME i => ["w", letter i]
                   | NONE =>
                case upgrade (m.inv, "[", armourNames) of
                     SOME i => ["W", letter i]
                   | NONE =>
                case foe of
                     SOME (_, _, k) => [k]
                   | NONE =>
                if isItem here andalso not packFull then [","]
                else case (if packFull then NONE
                           else walk (fn (x, y) => isItem (cellAt (m.known, x, y)))) of
                          SOME k => [k]
                        | NONE =>
                     case walk untrodden of
                          SOME k => [k]
                        | NONE =>
                     if here = ">" then [">"]
                     else case walk (fn (x, y) => cellAt (m.known, x, y) = ">") of
                               SOME k => [k]
                             | NONE   => []
        in (keys, trail)
        end

    (*------------------------------------  Playing  ------------------------------------*)

    fun await m = receive [ hn ("APPMSG", msg) => Ui.arrived (m, msg) ]

    fun press (m, k) =
        let val (m1, _, commands) = Ui.key (m, KEY_PRINT k)
        in List.foldl (fn (cmd, m) => let val _ = send (world, ("CMD", cmd)) in await m end)
                      m1 commands
        end

    fun play (m, trail, serial, left) =
        if m.status <> "play" then (m, m.status)
        else if left <= 0 then (m, "unfinished")
        else let val trail1 = if m.serial = serial then trail else unmarked ()
                 val (keys, trail2) = choose (m, trail1)
             in case keys of
                     [] => (m, "stuck")
                   | _  => play (List.foldl (fn (k, m) => press (m, k)) m keys, trail2, m.serial,
                                 left - 1)
             end

    val code = if usage
               then let val _ = print "usage: bot.trp -- SEED [TURNS]"
                    in 2
                    end
               else let val _ = send (world, ("HELLO", self ()))
                        val m0 = await (Ui.init (80, 24, false))
                        val (m, outcome) = play (m0, unmarked (), m0.serial, limit)
                        val (depth, hp, maxhp, str, ac, gold, xp, lvl, turn) = m.stats
                        val _ = List.map (fn row => printString row) (Ui.text (m, 80, 24))
                        val _ = printString ("seed " ^ toString shownSeed ^ ": " ^ outcome
                                             ^ " on floor " ^ toString depth
                                             ^ " at turn " ^ toString turn)
                    in 0
                    end
in exit (authority, code)
end
