(* The library `Markdown`.

   The function `Markdown.toHtml` parses a Markdown document into blocks
   and renders them as HTML using the library `Html`, which escapes every
   text node; note that the `<script>` element in the source is rendered
   as text. The function `Markdown.headings` lists the headings of the
   document together with the anchors assigned by the renderer. *)
import Markdown
import String
import List
let val doc = String.unlines
      [ "# A small page"
      , ""
      , "Troupe is a language for *distributed* programs with"
      , "**information-flow control**. See `raisedTo`."
      , ""
      , "## Checklist"
      , ""
      , "- [x] parse"
      , "- [ ] render <script>alert(1)</script>"
      , ""
      , "| step | done |"
      , "|------|------|"
      , "| one  | yes  |"
      ]
in print (Markdown.headings doc);
   printString (Markdown.toHtml doc)
end
