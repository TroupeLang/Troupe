(* Ranged-receive v2 witness 12a: intermediate presence vs the ceiling-consume loop shape.

   Library-shape decision input, half 1 (half 2 is 12b; split because this half ends in a
   block). One message sits at presence `<alice;#root-integrity>` — strictly between the
   window bounds public and `<alice & bob;#root-integrity>` (placed the way the existing
   corpus places presences: a spawned sender whose send sits under a raisedTo branch, so
   the message's presence label is the sender's pc).

   The ceiling-consume shape (the current library loop pattern): under a region
   [public, alice&bob], peek over the full window SEES the message, but the peeked value
   is tainted at the ceiling (the peek taint joins the window top and the region fold
   Delta = alice&bob). Branching on it takes pc to the ceiling, after which the consume
   occurrence premise pc ⊑ l1 admits only l1 = ceiling — and the point interval
   [alice&bob, alice&bob] does not contain the message's presence alice, so the consume
   selects NOTHING and blocks. An intermediate-presence message is matchable but not
   removable by this shape.

   Expected verdict: ok = true; the peeked payload prints at
   `<alice&bob;#root-integrity>`; the consume finds no message in the point interval and
   BLOCKS — the run only ends via the runtime timeout (run with --timeout=3).
*)

let val main = self ()
    val _ = spawn (fn () => if (true raisedTo `<alice;#root-integrity>`) then send (main, 42) else ())
    val (ok, cap) = enableRangedReceive (`<;#root-integrity>`, `<alice & bob;#root-integrity>`, authority)
    val _ = printWithLabels ok
    val p = peek (0, `<;#root-integrity>`, `<alice & bob;#root-integrity>`)
    val (m, meta) = p
    val _ = printWithLabels m
in if m = 42
   then consume (0, `<alice & bob;#root-integrity>`, `<alice & bob;#root-integrity>`)
   else consume (0, `<alice & bob;#root-integrity>`, `<alice & bob;#root-integrity>`)
end

(* Actual (./local.sh ... --timeout=3): ok = true@{}%{};
   m = 42@<alice&bob;#root-integrity>%<alice&bob;#root-integrity> (ceiling taint);
   then no further output and "Execution timed out after 3 seconds" — the consume found
   nothing in the point interval [alice&bob, alice&bob] and blocked. Matches expected:
   matchable but not removable by the ceiling-consume shape. *)
