let val secret = 10 raisedTo `<secret;#root-integrity>`
    val pid = spawn (
                    fn () =>
                         let val _ = enableRangedReceive (`<;#root-integrity>`, `<secret;#root-integrity>`, attenuate (authority, `<#null-confidentiality;#null-integrity>`)) in 
                         rcv ( `{}`
                             , `<secret;#root-integrity>`
                             , [  hn 2 => adv 2
                                , hn 4 => print 4 ]
                         )
                         end 
                    )
    val _ = 
        let pini authority 
            val _ = if secret > 0 then send (pid, 1) else () 
        in () 
        end
    
    val _ = send(pid, 2)
    val _ = send(pid, secret)
    
    val _ = adv 10
in ()
end
