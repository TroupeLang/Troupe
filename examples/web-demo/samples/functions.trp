(* Functions and recursion.

   `fun` defines a function; there are no loops, so repetition is recursion.
   `print` shows any value, so numbers come out as numbers; `^` joins
   strings and `toString` turns a number into one. Functions are values:
   `twice` takes a function and applies it two times. *)
let fun square x = x * x
    fun sumTo n = if n <= 0 then 0 else n + sumTo (n - 1)
    fun fib n = if n < 2 then n else fib (n - 1) + fib (n - 2)
    fun twice f x = f (f x)
in print (square 12);
   print (sumTo 100);
   printString ("fib 20 = " ^ toString (fib 20));
   print (twice square 3)
end
