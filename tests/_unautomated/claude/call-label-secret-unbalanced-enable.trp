(* Call-label channel, ranged-receive pair: an unbalanced enableRangedReceive
   inside a SECRET-labelled call.

   Same shape as call-label-secret-unbalanced, spelled with the v2 clearance
   primitive: the callee opens a region (root-certified, so it could be
   closed) and never closes it. The flag mechanism is spelling-agnostic —
   enableRangedReceive shares the clearance record with the legacy raise — so
   the balance check at the secret call's return must refuse.

   Expected verdict: REFUSE — "Mailbox clearance label is not restorted after
   being raised in a branch" at the return of f. *)

let val f = (fn () =>
      let val (ok, cap) = enableRangedReceive (`{}`, `{alice}`, authority)
      in () end) raisedTo `{alice}`
    val _ = f ()
in printWithLabels "unreachable"
end

(* Actual (./local.sh): thread error
   "Mailbox clearance label is not restorted after being raised in a branch;
   stack depth = 13" at the enableRangedReceive position. Matches expected
   (REFUSE). *)
