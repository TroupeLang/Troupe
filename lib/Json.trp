import String
import List
import Result

(** Json - a JSON parser and printer (RFC 8259).
 *
 *  Data model (Model N: native Troupe values). JSON documents are represented directly as
 *  ordinary Troupe values, with no wrapper or tag field:
 *
 *    | JSON     | Troupe value                          |
 *    |----------|---------------------------------------|
 *    | null     | unit                                  |
 *    | bool     | bool                                  |
 *    | number   | number (a JS double)                  |
 *    | string   | string                                |
 *    | array    | list                                  |
 *    | object   | record (dynamic string keys)          |
 *
 *  A consumer discriminates a parsed value at runtime with `kindOf` (built on `getType`) and
 *  reaches into it with ordinary Troupe operations (`v.name`, list functions, arithmetic) or with
 *  the `field`/`index`/`as*` accessors below.
 *
 *  Known limitations of Model N:
 *
 *    - Object member order and duplicate keys are not preserved: a JSON object becomes a record,
 *      whose keys are unordered and unique (a repeated key keeps the last value). `parse` followed
 *      by `stringify` is therefore semantic, not byte-faithful, for objects.
 *    - JSON `null` and Troupe `unit` are the same value, so they cannot be told apart.
 *    - There is a single `number` type (a JS double). Integers beyond 2^53 lose precision and
 *      `1` versus `1.0` is not preserved through a round-trip (both print as `1`).
 *    - `\uXXXX` escapes are decoded for the whole Unicode range via `String.strCode`: a lone escape
 *      denotes its code point, and a high/low surrogate pair (`😀`) is combined into the
 *      supplementary code point it encodes. A malformed escape (bad hex, a lone or mismatched
 *      surrogate) yields `Err {reason, offset}`. Characters written literally as UTF-8 also pass
 *      through unchanged and round-trip faithfully.
 *
 *  Security / IFC: every leaf produced by `parse` carries the label of the input string, so the
 *  provenance of untrusted input survives parsing. `stringify`/`prettyPrint` output is labelled with
 *  the join of the visited node labels (automatic through `String.concat`). The library performs no
 *  `declassify` or `endorse`.
 *)

let (*--- Character helpers ---*)

    (* A double-quote character, built via an escape so no literal quote appears in source. *)
    val q  = "\x22"
    (* A single backslash character. *)
    val bs = "\x5c"

    (* Lower-case hex digits, indexed by nibble value. *)
    val hexDigits = "0123456789abcdef"

    (* Two-character lower-case hex rendering of a code in 0..255. *)
    fun hex2 c =
        let val hi = c div 16
            val lo = c mod 16
        in (String.substring (hexDigits, hi, hi+1)) ^ (String.substring (hexDigits, lo, lo+1))
        end

    (*--- String encoding (for stringify / prettyPrint) ---*)

    (* Render a Troupe string as a quoted, escaped JSON string. Only the mandatory characters are
     * escaped (quote, backslash, and control characters below U+0020); every other character,
     * including non-ASCII, is emitted literally as a substring of the input so its label is
     * preserved. *)
    fun encodeString str =
        let val m = String.size str
            fun needsEscape c = c = 34 orelse c = 92 orelse c < 32
            fun escapeFor c =
                if      c = 34 then bs ^ q
                else if c = 92 then bs ^ bs
                else if c = 8  then bs ^ "b"
                else if c = 12 then bs ^ "f"
                else if c = 10 then bs ^ "n"
                else if c = 13 then bs ^ "r"
                else if c = 9  then bs ^ "t"
                else bs ^ "u00" ^ (hex2 c)
            fun scan p runStart acc =
                if p >= m
                then String.concat (List.reverse ((String.substring (str, runStart, p)) :: acc))
                else let val c = String.subCode (str, p)
                     in if needsEscape c
                        then let val piece = String.substring (str, runStart, p)
                             in scan (p+1) (p+1) ((escapeFor c) :: piece :: acc)
                             end
                        else scan (p+1) runStart acc
                     end
        in q ^ (scan 0 0 []) ^ q
        end

    (*--- Inspection / access ---*)

    (** "null" | "bool" | "number" | "string" | "array" | "object" — the JSON-level kind of a value,
     *  computed from `getType`. A value that is not a JSON value falls through to its `getType`
     *  string. *)
    fun kindOf j = case getType j of "unit"    => "null"
                                   | "boolean" => "bool"
                                   | "number"  => "number"
                                   | "string"  => "string"
                                   | "list"    => "array"
                                   | "record"  => "object"
                                   | other     => other

    (** Look up a member of a JSON object by name. `Err` if `j` is not an object or has no such
     *  member. *)
    fun field name j =
        if getType j <> "record"
        then Result.err {reason = "not a JSON object"}
        else let fun look []            = Result.err {reason = "field not found: " ^ name}
                   | look ((k,v)::rest) = if k = name then Result.ok v else look rest
             in look (recordToList j)
             end

    (** Return the element at position `k` (counting from zero) of a JSON array. `Err` if `j` is not
     *  an array or `k` is out of range. *)
    fun index k j =
        if getType j <> "list"
        then Result.err {reason = "not a JSON array"}
        else if k < 0
        then Result.err {reason = "index out of range"}
        else let fun go idx (x::xs) = if idx = 0 then Result.ok x else go (idx-1) xs
                   | go _   []      = Result.err {reason = "index out of range"}
             in go k j
             end

    (** The underlying bool of a JSON bool; `Err` otherwise. *)
    fun asBool j =
        if getType j = "boolean" then Result.ok j else Result.err {reason = "not a JSON bool"}

    (** The underlying number of a JSON number; `Err` otherwise. *)
    fun asNumber j =
        if getType j = "number" then Result.ok j else Result.err {reason = "not a JSON number"}

    (** The underlying string of a JSON string; `Err` otherwise. *)
    fun asString j =
        if getType j = "string" then Result.ok j else Result.err {reason = "not a JSON string"}

    (** The elements of a JSON array as a `json list`; `Err` otherwise. *)
    fun asArray j =
        if getType j = "list" then Result.ok j else Result.err {reason = "not a JSON array"}

    (** The members of a JSON object as a list of `(key, value)` pairs (via `recordToList`; order is
     *  unspecified under Model N); `Err` otherwise. *)
    fun asObject j =
        if getType j = "record"
        then Result.ok (recordToList j)
        else Result.err {reason = "not a JSON object"}

    (*--- Parsing ---*)

    (* The greatest nesting depth `parse` accepts; deeper input yields an `Err` rather than
     * exhausting the stack. *)
    val maxDepth = 200

    (** Parse a full JSON document into a Troupe value. On success returns `Ok value`; on malformed
     *  input returns `Err {reason, offset}`, where `offset` is the character index of the offending
     *  character. Never crashes on malformed input. *)
    fun parse input =
        let val s = input
            val n = String.size s
            fun code i = String.subCode (s, i)
            fun isWs c = c = 32 orelse c = 9 orelse c = 10 orelse c = 13
            fun isDigit c = c >= 48 andalso c <= 57
            fun skipWs i = if i >= n then i else if isWs (code i) then skipWs (i+1) else i

            (* Value of a hex digit code, or -1 if not a hex digit. *)
            fun hexVal c =
                if      c >= 48 andalso c <= 57  then c - 48
                else if c >= 97 andalso c <= 102 then c - 87
                else if c >= 65 andalso c <= 70  then c - 55
                else 0 - 1

            (* Read four hex digits starting at p; the combined value, or -1 on any non-hex digit. *)
            fun hex4 p =
                let val a = hexVal (code p)
                    val b = hexVal (code (p+1))
                    val c = hexVal (code (p+2))
                    val d = hexVal (code (p+3))
                in if a < 0 orelse b < 0 orelse c < 0 orelse d < 0
                   then 0 - 1
                   else (a * 4096) + (b * 256) + (c * 16) + d
                end

            (* Handle a high surrogate `hi` decoded at `uPos` (the 'u'); `p` is where the low
             * surrogate escape must begin. A valid pair is combined into its supplementary code
             * point and built with `String.strCode`. *)
            fun handleSurrogate hi uPos p =
                if p + 6 > n
                then ("err", "incomplete surrogate pair", uPos - 1)
                else if code p = 92 andalso code (p+1) = 117
                then let val lo = hex4 (p+2)
                     in if lo >= 56320 andalso lo <= 57343
                        then let val cp = 65536 + ((hi - 55296) * 1024) + (lo - 56320)
                             in ("ok", String.strCode cp, p+6)
                             end
                        else ("err", "invalid low surrogate in \x5cu escape", uPos - 1)
                     end
                else ("err", "expected low surrogate after high surrogate", uPos - 1)

            (* Decode a `\uXXXX` escape whose 'u' is at `uPos`. *)
            fun decodeUnicode uPos =
                let val hs = uPos + 1
                in if hs + 4 > n
                   then ("err", "incomplete \x5cu escape", uPos - 1)
                   else let val cp = hex4 hs
                        in if cp < 0
                           then ("err", "invalid \x5cu escape", uPos - 1)
                           else if cp >= 55296 andalso cp <= 56319
                           then handleSurrogate cp uPos (hs+4)
                           else if cp >= 56320 andalso cp <= 57343
                           then ("err", "unexpected low surrogate in \x5cu escape", uPos - 1)
                           else ("ok", String.strCode cp, hs+4)
                        end
                end

            (* Decode an escape sequence; `k` is the character just after the backslash. *)
            fun decodeEscape k =
                if k >= n
                then ("err", "incomplete escape sequence", k - 1)
                else let val c = code k
                     in if      c = 34  then ("ok", q,      k+1)
                        else if c = 92  then ("ok", bs,     k+1)
                        else if c = 47  then ("ok", "/",    k+1)
                        else if c = 98  then ("ok", "\x08", k+1)
                        else if c = 102 then ("ok", "\x0c", k+1)
                        else if c = 110 then ("ok", "\x0a", k+1)
                        else if c = 114 then ("ok", "\x0d", k+1)
                        else if c = 116 then ("ok", "\x09", k+1)
                        else if c = 117 then decodeUnicode k
                        else ("err", "invalid escape character", k)
                     end

            (* Parse a string literal; `i` is at the opening quote. *)
            fun pString i =
                let fun goStr j runStart acc =
                        if j >= n
                        then ("err", "unterminated string", i)
                        else let val c = code j
                             in if c = 34
                                then let val piece = String.substring (s, runStart, j)
                                         val full  = String.concat (List.reverse (piece :: acc))
                                     in ("ok", full, j+1)
                                     end
                                else if c = 92
                                then let val piece = String.substring (s, runStart, j)
                                     in case decodeEscape (j+1) of
                                            ("ok", str, j2) => goStr j2 j2 (str :: piece :: acc)
                                          | e => e
                                     end
                                else if c < 32
                                then ("err", "unescaped control character in string", j)
                                else goStr (j+1) runStart acc
                             end
                in goStr (i+1) (i+1) []
                end

            (* Scan consecutive digits from j, returning the first non-digit index. *)
            fun digits j = if j < n andalso isDigit (code j) then digits (j+1) else j

            (* Scan an optional exponent starting at j. *)
            fun numExp j =
                if j < n andalso (code j = 101 orelse code j = 69)
                then let val j1 = j + 1
                         val j2 = if j1 < n andalso (code j1 = 43 orelse code j1 = 45) then j1+1 else j1
                         val d  = digits j2
                     in if d = j2 then ("err", "expected digit in exponent", j) else ("ok", d)
                     end
                else ("ok", j)

            (* Scan an optional fraction (then exponent) starting at j. *)
            fun numFrac j =
                if j < n andalso code j = 46
                then let val d = digits (j+1)
                     in if d = j+1 then ("err", "expected digit after decimal point", j) else numExp d
                     end
                else numExp j

            (* Parse a number; `i` is at the sign or first digit. *)
            fun pNumber i =
                let val jm = if i < n andalso code i = 45 then i+1 else i
                in if jm >= n
                   then ("err", "expected digit in number", i)
                   else let val c0 = code jm
                            fun finish r = case r of ("ok", e) => ("ok", stringToInt (String.substring (s, i, e)), e)
                                                   | other     => other
                        in if      c0 = 48       then finish (numFrac (jm+1))
                           else if isDigit c0    then finish (numFrac (digits (jm+1)))
                           else ("err", "invalid number", i)
                        end
                end

            (* Match a literal keyword `word` at `i`, yielding value `v`. *)
            fun pLit i word v =
                let val len = String.size word
                in if String.substring (s, i, i+len) = word
                   then ("ok", v, i+len)
                   else ("err", "invalid token", i)
                end

            fun pValue depth i =
                if depth > maxDepth
                then ("err", "maximum nesting depth exceeded", i)
                else let val i1 = skipWs i
                     in if i1 >= n
                        then ("err", "unexpected end of input", i1)
                        else let val c = code i1
                             in if      c = 123 then pObject depth i1
                                else if c = 91  then pArray depth i1
                                else if c = 34  then pString i1
                                else if c = 116 then pLit i1 "true" true
                                else if c = 102 then pLit i1 "false" false
                                else if c = 110 then pLit i1 "null" ()
                                else if c = 45 orelse isDigit c then pNumber i1
                                else ("err", "unexpected character", i1)
                             end
                     end

            and pArray depth i =
                let val i1 = skipWs (i+1)
                in if i1 < n andalso code i1 = 93
                   then ("ok", [], i1+1)
                   else pArrayElems depth i1 []
                end

            and pArrayElems depth i acc =
                case pValue (depth+1) i of
                    ("ok", v, j) =>
                        let val j1 = skipWs j
                        in if j1 >= n
                           then ("err", "expected ',' or ']' in array", j1)
                           else let val c = code j1
                                in if      c = 44 then pArrayElems depth (j1+1) (v::acc)
                                   else if c = 93 then ("ok", List.reverse (v::acc), j1+1)
                                   else ("err", "expected ',' or ']' in array", j1)
                                end
                        end
                  | e => e

            and pObject depth i =
                let val i1 = skipWs (i+1)
                in if i1 < n andalso code i1 = 125
                   then ("ok", {}, i1+1)
                   else pObjectMembers depth i1 {}
                end

            and pObjectMembers depth i rec =
                let val i1 = skipWs i
                in if i1 >= n orelse code i1 <> 34
                   then ("err", "expected string key in object", i1)
                   else case pString i1 of
                            ("ok", key, j) =>
                                let val j1 = skipWs j
                                in if j1 >= n orelse code j1 <> 58
                                   then ("err", "expected ':' in object", j1)
                                   else case pValue (depth+1) (j1+1) of
                                            ("ok", v, k) =>
                                                let val rec2 = recordExtend (rec, key, v)
                                                    val k1   = skipWs k
                                                in if k1 >= n
                                                   then ("err", "expected ',' or '}' in object", k1)
                                                   else let val c = code k1
                                                        in if      c = 44  then pObjectMembers depth (k1+1) rec2
                                                           else if c = 125 then ("ok", rec2, k1+1)
                                                           else ("err", "expected ',' or '}' in object", k1)
                                                        end
                                                end
                                          | e => e
                                end
                          | e => e
                end

        in case pValue 0 (skipWs 0) of
               ("ok", v, i) => let val i2 = skipWs i
                               in if i2 >= n
                                  then Result.ok v
                                  else Result.err {reason = "trailing characters after value", offset = i2}
                               end
             | ("err", msg, off) => Result.err {reason = msg, offset = off}
        end

    (*--- Printing ---*)

    (** Render a JSON value as compact JSON text (no insignificant whitespace). Numbers print through
     *  the Troupe number formatter, so an integral value prints without a decimal point (`1`, not
     *  `1.0`). *)
    fun stringify j =
        let fun go v = case getType v of
                           "unit"    => "null"
                         | "boolean" => if v then "true" else "false"
                         | "number"  => toString v
                         | "string"  => encodeString v
                         | "list"    => "[" ^ (String.concatWith "," (List.map go v)) ^ "]"
                         | "record"  => "{" ^ (String.concatWith ","
                                                   (List.map (fn (k,vv) => (encodeString k) ^ ":" ^ (go vv))
                                                             (recordToList v))) ^ "}"
                         | _         => "null"
        in go j
        end

    (** Render a JSON value as indented JSON text, `num` spaces per nesting level, one array element
     *  or object member per line. A negative `num` is treated as zero. Numbers follow the same rule
     *  as `stringify`. *)
    fun prettyPrint num j =
        let val nn = if num < 0 then 0 else num
            fun spaces 0 = ""
              | spaces k = " " ^ (spaces (k-1))
            fun indent level = spaces (level * nn)
            fun go level v =
                case getType v of
                    "unit"    => "null"
                  | "boolean" => if v then "true" else "false"
                  | "number"  => toString v
                  | "string"  => encodeString v
                  | "list"    => (case v of
                                      [] => "[]"
                                    | _  => "[\n"
                                            ^ (String.concatWith ",\n"
                                                   (List.map (fn e => (indent (level+1)) ^ (go (level+1) e)) v))
                                            ^ "\n" ^ (indent level) ^ "]")
                  | "record"  => (case recordToList v of
                                      [] => "{}"
                                    | pairs => "{\n"
                                               ^ (String.concatWith ",\n"
                                                      (List.map (fn (k,vv) => (indent (level+1))
                                                                              ^ (encodeString k) ^ ": "
                                                                              ^ (go (level+1) vv))
                                                                pairs))
                                               ^ "\n" ^ (indent level) ^ "}")
                  | _         => "null"
        in go 0 j
        end

in [ ("kindOf", kindOf)
   , ("field", field)
   , ("index", index)
   , ("asBool", asBool)
   , ("asNumber", asNumber)
   , ("asString", asString)
   , ("asArray", asArray)
   , ("asObject", asObject)
   , ("parse", parse)
   , ("stringify", stringify)
   , ("prettyPrint", prettyPrint)
   ]
end
