(* Label propagation.

   The program first sets the level of the standard output to `{}` using
   `setStdioLevel`. An operation on labeled values produces a result
   labeled with the join of the labels of its operands, e.g., the sum of
   alice's number and bob's number is labeled `alice&bob`. The primitive
   `levelOf x` returns the label of `x`; note that the label is itself
   labeled at the level of `x`, as it carries information about `x`, and
   the program declassifies it with the top-level authority before
   printing. The primitive `flowsTo (l1, l2)` tests whether l1 ⊑ l2. The
   last line indexes a public list with a secret index: the list is
   public, but the selected element reveals the index, so the result is
   labeled `{alice}` and the output is an information flow violation. *)
import List
import IfcUtil
let val _ = setStdioLevel (authority, `{}`)
    val secret = 3 raisedTo `<alice;#root-integrity>`
    val bobs = 10 raisedTo `<bob;#root-integrity>`
    val both = secret + bobs
    val public = [100, 200, 300, 400, 500]
    fun release x = pdeclassify (x, authority, `{}`)
    fun showLabel name x =
      printString (name ^ " is labelled " ^ toString (release (levelOf x)))
    fun showFlow (x, y) = release (flowsTo (levelOf x, levelOf y))
in showLabel "public" public;
   showLabel "secret * 2" (secret * 2);
   showLabel "a string built from secret" ("the answer is " ^ toString secret);
   showLabel "secret + bobs" both;
   showLabel "a tuple holding secret" (secret > 2, [secret, 1]);  (* the tuple itself *)
   print (showFlow (secret, both));              (* {alice} flows to alice&bob *)
   print (showFlow (both, secret));           (* alice&bob does not flow to {alice} *)
   print (List.nth public 2);
   print (List.nth public secret)
end
