(* Prints the label of each peer id and decides on it directly: the id arrives labelled at
   the pc of the connectionGater call, whatever the peer's trust level, so no endorse is
   needed. The questions are named "deny...", after libp2p's hooks, so `reply true` denies
   and `reply false` admits. *)
import List
import Outcome
import P2PRelayControl
let val listed = ["@@ALICE@@", "@@BOB@@", "@@CAROL@@"]
    val _ = case P2PRelayControl.connectionGater (authority, self ()) of
                 OK _ => print "RELAY: connectionGater OK"
               | ERR NOT_RELAY => print "RELAY: connectionGater ERR NOT_RELAY"
    fun loop () =
      receive [ hn ("denyInboundRelayReservation", peer, reply) =>
                  (printWithLabels ("RELAY: reservation question", peer);
                   reply (not (List.elem peer listed));
                   printWithLabels ("RELAY: reply returned for", peer);
                   loop ())
              , hn ("denyOutboundRelayedConnection", _, reply) => (reply false; loop ()) ]
in loop ()
end
