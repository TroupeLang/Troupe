(* Example: updateable service.

   Functions are values, and can be sent in messages. The loop of the
   service is a function; on a message `("UPDATE", f)` it calls the new
   function `f` with its current state. The second version handles one
   more request, `("COMPUTE", from, f, x)`, which applies a function sent
   by the client. Observe that the counter is preserved across the
   update. The service prints its last line from its own process, which
   may run after the main thread has finished. *)
let fun v1 n =
      receive [ hn ("REQUEST", from) => (send (from, n); v1 (n + 1))
              , hn ("UPDATE", newVersion) => newVersion n
              , hn "STOP" => printString "server stopped" ]
    fun v2 n =
      receive [ hn ("REQUEST", from) => (send (from, n); v2 (n + 1))
              , hn ("COMPUTE", from, f, x) => (send (from, f x); v2 (n + 1))
              , hn ("UPDATE", newVersion) => newVersion n
              , hn "STOP" => printString "server stopped" ]
    val server = spawn (fn () => v1 0)
    fun ask msg = (send (server, msg); receive [ hn x => x ])
in print (ask ("REQUEST", self ()));
   print (ask ("REQUEST", self ()));
   send (server, ("UPDATE", v2));
   print (ask ("COMPUTE", self (), fn x => x * x, 42));
   print (ask ("REQUEST", self ()));
   send (server, "STOP")
end
