(* Savina benchmark: Counting Actor (microbenchmark group).
 *
 * The main process sends n INC messages to a counting actor, then asks for
 * the total. Measures one-way send throughput and mailbox pressure: all n
 * messages queue up ahead of the final GET.
 *
 *   ./local.sh examples/savina/counting.trp                 # default sizes
 *   ./local.sh examples/savina/counting.trp -- 10000 50000  # explicit sizes
 *
 * Result: the count reported by the actor; ok iff it equals n.
 *)

import List
import Bench

datatype Atoms = INC | GET | RESULT

let fun counter c =
        receive [ hn INC      => counter (c + 1)
                , hn (GET, p) => send (p, (RESULT, c)) ]

    fun bench n =
        let val cnt = spawn (fn () => counter 0)
            fun produce k =
                if k = 0 then () else (send (cnt, INC); produce (k - 1))
            val _ = produce n
            val _ = send (cnt, (GET, self ()))
        in receive [ hn (RESULT, c) => c ]
        end

    val sizes = Bench.sizesFromArgs (getCliArgs authority) [10000, 50000, 100000]
in Bench.run authority "counting" sizes 3 bench (fn n => fn r => r = n)
end
