(* Example: a pool of worker processes.

   The main process spawns three workers, sends each job to the next
   worker in turn, and collects the results. Each result carries the
   identifier of the worker that produced it. Observe that the results
   arrive in the order in which the workers finish, and the `sleep` in
   each worker makes that order depend on the job. The function
   `collect` receives the results one at a time. *)
import List
let fun worker id =
      receive [ hn ("job", n, from) =>
                  ( sleep (n * 7)          (* the work takes time proportional to n *)
                  ; send (from, ("result", id, n, n * n))
                  ; worker id )
              , hn "stop" => () ]
    val workers = List.map (fn id => (id, spawn (fn () => worker id))) [1, 2, 3]
    val jobs = [9, 2, 7, 4, 5, 1]
    fun dispatch [] _ = ()
      | dispatch (j :: js) k =
          let val (_, p) = List.nth workers (k mod 3)
          in send (p, ("job", j, self ())); dispatch js (k + 1)
          end
    fun collect 0 acc = acc
      | collect n acc =
          receive [ hn ("result", id, j, r) =>
                      ( printString ("worker " ^ toString id ^ ": " ^ toString j
                                     ^ "^2 = " ^ toString r)
                      ; collect (n - 1) (r + acc) ) ]
in dispatch jobs 0;
   print (collect (List.length jobs) 0);
   List.map (fn (_, p) => send (p, "stop")) workers;
   printString "all workers stopped"
end
