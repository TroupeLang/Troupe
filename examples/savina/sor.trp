(* Savina benchmark: Successive Over-Relaxation (parallelism group).
 *
 * An actor per grid cell relaxes a g-by-g grid for 16 Jacobi iterations:
 * each iteration a cell sends its value to its neighbors (tagged with the
 * sender's direction relative to the receiver), collects one value per
 * existing neighbor by direction-selective receive, and averages. The
 * per-iteration synchronization of the original is carried by the
 * message pattern itself: per-sender FIFO delivery keeps rounds aligned
 * without iteration tags, because a neighbor can run at most one round
 * ahead and its values are consumed oldest-first per direction.
 *
 * Values are summed in a fixed direction order, so verification against
 * a sequential Jacobi sweep of the same grid is exact float equality.
 *
 *   ./local.sh examples/savina/sor.trp             # default sizes
 *   ./local.sh examples/savina/sor.trp -- 8 12     # explicit sizes
 *
 * Result: true iff every cell's final value equals the reference.
 *)

import List
import Vector
import Number
import Bench

datatype Atoms = WIRE | VAL | UP | DOWN | LEFT | RIGHT | FINAL

let val iterations = 16

    fun initial (x, y) = ((x * 7 + y * 13) mod 100) / 10.0

    fun cell master =
        receive [ hn (WIRE, myId, v0, ups, downs, lefts, rights) =>
            let val deg = List.length ups + List.length downs
                          + List.length lefts + List.length rights
                fun sendAll v =
                    (List.map (fn p => send (p, (VAL, DOWN, v))) ups;
                     List.map (fn p => send (p, (VAL, UP, v))) downs;
                     List.map (fn p => send (p, (VAL, RIGHT, v))) lefts;
                     List.map (fn p => send (p, (VAL, LEFT, v))) rights;
                     ())
                fun recvOr0 dir =
                    case dir of
                      [] => 0.0
                    | [UP]    => receive [ hn (VAL, UP, x)    => x ]
                    | [DOWN]  => receive [ hn (VAL, DOWN, x)  => x ]
                    | [LEFT]  => receive [ hn (VAL, LEFT, x)  => x ]
                    | [RIGHT] => receive [ hn (VAL, RIGHT, x) => x ]
                fun iterate (t, v) =
                    if t = 0 then send (master, (FINAL, myId, v))
                    else let val _ = sendAll v
                             val su = recvOr0 (case ups of [] => [] | _ => [UP])
                             val sd = recvOr0 (case downs of [] => [] | _ => [DOWN])
                             val sl = recvOr0 (case lefts of [] => [] | _ => [LEFT])
                             val sr = recvOr0 (case rights of [] => [] | _ => [RIGHT])
                             val sum = (su + sd) + (sl + sr)
                         in iterate (t - 1, (v + sum) / (1.0 + deg)) end
            in iterate (iterations, v0) end ]

    fun reference g =
        let val grid0 = Vector.tabulate (g * g) (fn id =>
                            initial (id mod g, Number.intDiv id g))
            fun nb (grid, x, y) =
                if x < 0 orelse x >= g orelse y < 0 orelse y >= g then 0.0
                else Vector.sub (grid, y * g + x)
            fun deg (x, y) =
                (if y > 0 then 1 else 0) + (if y < g - 1 then 1 else 0)
                + (if x > 0 then 1 else 0) + (if x < g - 1 then 1 else 0)
            fun step grid =
                Vector.tabulate (g * g) (fn id =>
                    let val x = id mod g
                        val y = Number.intDiv id g
                        val sum = (nb (grid, x, y - 1) + nb (grid, x, y + 1))
                                  + (nb (grid, x - 1, y) + nb (grid, x + 1, y))
                    in (Vector.sub (grid, id) + sum) / (1.0 + deg (x, y)) end)
            fun go (t, grid) = if t = 0 then grid else go (t - 1, step grid)
        in go (iterations, grid0) end

    fun bench g =
        let val main = self ()
            val cells = List.map (fn _ => spawn (fn () => cell main))
                                 (List.range (g * g))
            fun pidAt (x, y) =
                if x < 0 orelse x >= g orelse y < 0 orelse y >= g then []
                else [List.nth cells (y * g + x)]
            val _ = List.mapi
                      (fn (id, p) =>
                         let val x = id mod g
                             val y = Number.intDiv id g
                         in send (p, (WIRE, id, initial (x, y),
                                      pidAt (x, y - 1), pidAt (x, y + 1),
                                      pidAt (x - 1, y), pidAt (x + 1, y)))
                         end)
                      cells
            fun collect (k, acc) =
                if k = 0 then acc
                else receive [ hn (FINAL, id, v) => collect (k - 1, (id, v) :: acc) ]
            val finals = collect (g * g, [])
            val ref = reference g
            fun valueAt id =
                case List.filter (fn (j, _) => j = id) finals of
                  [(_, v)] => v
            fun allEqual id =
                id = g * g orelse
                (valueAt id = Vector.sub (ref, id) andalso allEqual (id + 1))
        in allEqual 0
        end

    val sizes = Bench.sizesFromArgs (getCliArgs authority) [8, 12, 16]
in Bench.run authority "sor" sizes 3 bench (fn g => fn same => same)
end
