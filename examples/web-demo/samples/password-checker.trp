(* Example: a password checker.

   A process holds alice's password and answers guesses. The comparison
   of a guess with the password yields a boolean labeled `{alice}`. The
   checker declassifies this boolean, and only it, using an authority
   attenuated to alice's level, so the password keeps its label. The
   declassification uses `pdeclassify`, which also lowers the blocking
   label of the checker: a message sent by a process whose blocking label
   is `{alice}` carries that level as its presence label, and is not
   selected by the `receive` in the main process. The program makes a
   wrong guess and the right one, and both replies arrive at level `{}`. *)
import IfcUtil
let val _ = setStdioLevel (authority, `{}`)
    val password = "correct horse battery staple" raisedTo `<alice;#root-integrity>`
    val aliceAuth = attenuate (authority, `<alice;#root-integrity>`)
    fun checker () =
      receive [ hn ("guess", g, from) =>
                  let val verdict = pdeclassify (g = password, aliceAuth, `{}`)
                  in send (from, verdict); checker ()
                  end
              , hn "stop" => () ]
    val c = spawn checker
    fun try g = (send (c, ("guess", g, self ())); receive [ hn v => v ])
in printWithLabels (try "hunter2");
   printWithLabels (try "correct horse battery staple");
   send (c, "stop")
end
