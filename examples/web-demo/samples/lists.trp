(* Lists and the library `List`.

   To use a library, one needs to import it with an `import` statement at
   the top of the program; the library is loaded the first time the
   program uses it. List cons operation is `::`, and `[3, 1, 4]` is a
   list of three elements. Functions over lists are typically defined by
   pattern matching on the two forms of a list, `[]` and `x :: rest`.
   The expression `fn x => 2 * x` is an anonymous function. *)
import List
let val xs = [3, 1, 4, 1, 5, 9, 2, 6]
    fun sum [] = 0
      | sum (x :: rest) = x + sum rest
in print (List.length xs);
   print (List.reverse xs);
   print (List.map (fn x => 2 * x) xs);
   print (List.filter (fn x => x > 3) xs);
   print (sum xs);
   print (List.foldl (fn (x, acc) => x + acc) 0 xs)
end
