(* Persistence.

   The primitive `save (authority, name, v)` serializes the value `v`
   under the given name, and `restore name` deserializes it. A function
   value is serialized as the intermediate representation produced by
   the compiler, and is compiled again on restore by the compiler of the
   node. Saving requires the top-level authority. In this demo, the saved
   values are kept in the storage of the browser, and the compiler of the
   node runs in the page. *)
let val k = 21
    fun f x = x * 2 + k
    val _ = save (authority, "demo", f)
    val g = restore ("demo")
in print (g 10)
end
